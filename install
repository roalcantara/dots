#!/usr/bin/env bash
set -eu

# USAGE
# ./install                                             -- install with default values
# ./install -u <username> -g <groupname> -t <timezone>  -- install with custom values

# GLOBAL variables
REPO_URL="https://github.com/roalcantara/dots"
TIMEZONE=${TZ:-'America/Sao_Paulo'}
LOCALGROUP=$(id -gn 2>/dev/null)
LOCALUSER=$(id -un 2>/dev/null)
USR_LOCAL_BIN=${USR_LOCAL_BIN:-/usr/local/bin}
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}
XDG_CACHE_HOME=${XDG_CACHE_HOME:-~/.cache}
XDG_LOCAL_DIR=${XDG_LOCAL_DIR:-~/.local}
XDG_DATA_HOME=${XDG_DATA_HOME:-$XDG_LOCAL_DIR/share}
XDG_STATE_HOME=${XDG_STATE_HOME:-$XDG_LOCAL_DIR/state}
XDG_COMMON_DIRS=${XDG_COMMON_DIRS:-".config .cache .local .local/share .local/state .local/bin"}
ZDOTDIR=${ZDOTDIR:-$XDG_CONFIG_HOME/zsh}
ZSH_CACHE_DIR=${ZSH_CACHE_DIR:-$XDG_CACHE_HOME/zsh}
ZSH_COMPCACHE=${ZSH_COMPCACHE:-$ZSH_CACHE_DIR/compcache}
ZSH_COMPDUMP=${ZSH_COMPDUMP:-$ZSH_COMPCACHE/.zcompdump}
MISE_DATA_HOME=${MISE_DATA_HOME:-$XDG_DATA_HOME/mise}
BACKUP_DIR_ROOT=${BACKUP_DIR_ROOT:-$XDG_DATA_HOME/backup}
DOTS_DIR=${DOTS_DIR:-$XDG_DATA_HOME/dots}
XDG_ZSH_SETUP_SCRIPT=${XDG_ZSH_SETUP_SCRIPT:-$ZDOTDIR/etc/functions/zsetup}
BACKUP_RESOURCES=${BACKUP_RESOURCES:-".bashrc .bash_logout .bash_profile .profile .zshrc .zprofile .gitconfig .config"}
MISE_PACKAGES=${MISE_PACKAGES:-"ripgrep bat delta eza fd fzf gh neovim starship usage watchexec zoxide gum node python go"}
NPM_CONFIG_PREFIX=${NPM_CONFIG_PREFIX:-$XDG_DATA_HOME/npm}
NPM_CONFIG_CACHE=${NPM_CONFIG_CACHE:-$XDG_CACHE_HOME/npm}
USERNAME='roalcantara'
GROUPNAME=''
CONTEXT=''
HOME=''
ARCH=''
ENV=''
OS=''

# COLORS
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly PURPLE='\033[0;35m'
readonly NC='\033[0m'

puts() {
  if [ -n "$CONTEXT" ]; then
    echo -e "$1 [$(date '+%Y-%m-%d %H:%M:%S')] ($CONTEXT) $2"
  else
    echo -e "$1 [$(date '+%Y-%m-%d %H:%M:%S')] $2"
  fi
}
i() { puts "${BLUE}[INFO!]${NC}" "$*"; }
e() { puts "${RED}[ERROR]${NC}" "$*" >&2; }
w() { puts "${YELLOW}[WARN!]${NC}" "$*"; }
d() { puts "${PURPLE}[DEBUG]${NC}" "$*"; }
s() { puts "${GREEN}[DONE!]${NC}" "$*"; }

# Print a section header
# Usage: section <title>
section() {
  echo "===================================================="
  echo "$1"
  echo "===================================================="
}
# Check if the script is running in a container
# Usage: is_container
is_container() {
  # Check environment variables, container-specific files, and cgroups
  if [ -n "${DOCKER_CONTAINER:-}" ] || [ -n "${container:-}" ] ||
    [ -f "/.dockerenv" ] || [ -f "/var/run/docker.sock" ] || [ -f "/run/.containerenv" ] ||
    ([ -f "/proc/1/cgroup" ] && (grep -q "docker" "/proc/1/cgroup" || grep -q '^0::/$' /proc/1/cgroup)); then
    i "Running in container environment"
    return 0
  else
    i "Not running in container environment"
    return 1
  fi
}
# Remove the GitHub token from the environment
# Usage: cleanup_github_token <section_name>
cleanup_github_token() {
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    exec_cmd unset GITHUB_TOKEN
    w "[$1] GitHub token removed from environment"
  fi
}
# Execute a command and return the exit status
# Usage: exec_cmd <command>
exec_cmd() {
  w "Executing: $*"
  "$@"
  return $?
}
# Check if a command is available
# Usage: has_command <command>
has_command() {
  command -v "$1" >/dev/null 2>&1
}
# Setup directory with proper ownership (without environment variable) as sudo
# Usage: setup_dir <path> <section_name>
setup_dir() {
  local path="$1"
  local section_name="$2"

  # Create directory if it doesn't exist
  if [ ! -d "$path" ]; then
    exec_cmd sudo mkdir -p "$path"
    i "[$section_name] '$path' created ✔︎"
  fi

  # Set ownership if not already correct
  if [ "$(stat -c '%U:%G' "$path" 2>/dev/null)" != "$USERNAME:$GROUPNAME" ]; then
    exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$path"
    i "[$section_name] '$path' owned by '$USERNAME' ✔︎"
  fi
}
# Setup environment variable and directory with proper ownership
# Usage: setup_env_and_dir <env_var_name> <default_path> <section_name>
setup_env_and_dir() {
  local env_var_name="$1"
  local default_path="$2"
  local section_name="$3"

  # Create directory if it doesn't exist
  setup_dir "${!env_var_name}" "$section_name/$env_var_name"

  # Set environment variable if not already set
  if [ -z "${!env_var_name:-}" ]; then
    eval "export $env_var_name=\"$default_path\""
    i "[$section_name] $env_var_name set to '${!env_var_name}' ✔︎"
  fi
}
step_extract_arguments() {
  section "[ARGS] Extracting arguments..."
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -r | --repo_url)
      REPO_URL="$2"
      d "[ARGS] REPO_URL = '$REPO_URL' ✔︎"
      shift 2
      ;;
    -t | --timezone)
      TIMEZONE="$2"
      d "[ARGS] TIMEZONE = '$TIMEZONE' ✔︎"
      shift 2
      ;;
    -u | --username)
      USERNAME="$2"
      d "[ARGS] USERNAME = '$USERNAME' ✔︎"
      shift 2
      ;;
    -g | --groupname)
      GROUPNAME="$2"
      d "[ARGS] GROUPNAME = '$GROUPNAME' ✔︎"
      shift 2
      ;;
    --usr_local_bin)
      USR_LOCAL_BIN="$2"
      shift 2
      ;;
    --xdg_config_home)
      XDG_CONFIG_HOME="$2"
      shift 2
      ;;
    --xdg_cache_home)
      XDG_CACHE_HOME="$2"
      shift 2
      ;;
    --xdg_local_dir)
      XDG_LOCAL_DIR="$2"
      shift 2
      ;;
    --xdg_data_home)
      XDG_DATA_HOME="$2"
      shift 2
      ;;
    --xdg_state_home)
      XDG_STATE_HOME="$2"
      shift 2
      ;;
    --zsh_cache_dir)
      ZSH_CACHE_DIR="$2"
      shift 2
      ;;
    --zsh_compcache)
      ZSH_COMPCACHE="$2"
      shift 2
      ;;
    --zsh_compdump)
      ZSH_COMPDUMP="$2"
      shift 2
      ;;
    --mise_data_home)
      MISE_DATA_HOME="$2"
      shift 2
      ;;
    --backup_dir_root)
      BACKUP_DIR_ROOT="$2"
      shift 2
      ;;
    --dots_dir)
      DOTS_DIR="$2"
      shift 2
      ;;
    --xdg_zsh_setup_script)
      XDG_ZSH_SETUP_SCRIPT="$2"
      shift 2
      ;;
    --backup_resources)
      BACKUP_RESOURCES="$2"
      shift 2
      ;;
    *)
      w "Unknown argument: $1"
      exit 1
      ;;
    esac
  done
}
step_detect_platform() {
  section "[DETECT] Detecting platform..."

  OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
  ARCH="$(uname -m)"

  # Translate architecture names
  if [ "$ARCH" = "x86_64" ]; then
    ARCH="amd64"
  elif [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
    ARCH="arm64"
  fi

  # Set HOME directory
  if [ "$OS" = "linux" ]; then
    [ -z "$HOME" ] && HOME="/home/$USERNAME"
    [ -z "$GROUPNAME" ] && GROUPNAME="wheel"
  elif [ "$OS" = "darwin" ]; then
    [ -z "$HOME" ] && HOME="/Users/$USERNAME"
    [ -z "$GROUPNAME" ] && GROUPNAME="staff"
  fi

  # Set environment type based on container detection
  if is_container; then
    ENV="container"
  else
    ENV="host"
  fi

  CONTEXT="$OS/$ARCH/$ENV"
  s "Detected platform: '$CONTEXT' ✔︎"
}
step_set_and_show_environment_variables() {
  section "Environment Variables"
  i "OS = \"$OS\""
  i "ARCH = \"$ARCH\""
  i "ENV = \"$ENV\""
  i "HOME = \"$HOME\""
  i "CONTEXT = \"$CONTEXT\""
  i "REPO_URL = \"$REPO_URL\""
  i "TIMEZONE = \"$TIMEZONE\""
  i "LOCALGROUP = \"$LOCALGROUP\""
  i "LOCALUSER = \"$LOCALUSER\""
  i "USERNAME = \"$USERNAME\""
  i "GROUPNAME = \"$GROUPNAME\""
  i "USR_LOCAL_BIN = \"$USR_LOCAL_BIN\""
  i "XDG_CONFIG_HOME = \"$XDG_CONFIG_HOME\""
  i "XDG_CACHE_HOME = \"$XDG_CACHE_HOME\""
  i "XDG_LOCAL_DIR = \"$XDG_LOCAL_DIR\""
  i "XDG_DATA_HOME = \"$XDG_DATA_HOME\""
  i "XDG_STATE_HOME = \"$XDG_STATE_HOME\""
  i "ZDOTDIR = \"$ZDOTDIR\""
  i "ZSH_CACHE_DIR = \"$ZSH_CACHE_DIR\""
  i "ZSH_COMPCACHE = \"$ZSH_COMPCACHE\""
  i "ZSH_COMPDUMP = \"$ZSH_COMPDUMP\""
  i "MISE_DATA_HOME = \"$MISE_DATA_HOME\""
  i "BACKUP_DIR_ROOT = \"$BACKUP_DIR_ROOT\""
  i "DOTS_DIR = \"$DOTS_DIR\""
  i "XDG_ZSH_SETUP_SCRIPT = \"$XDG_ZSH_SETUP_SCRIPT\""
  i "BACKUP_RESOURCES = \"$BACKUP_RESOURCES\""
}
step_prepare() {
  section "[PREP] Setting up essential dependencies..."

  # Detect platform and setup accordingly
  if has_command apt; then
    # https://guides.rubyonrails.org/development_dependencies_install.html#ubuntu
    exec_cmd apt-get update &&
      apt-get install -y --no-install-recommends sudo build-essential libssl-dev libffi-dev libyaml-dev libxml2-dev xclip xsel &&
      sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/*

    if [ -n "$TIMEZONE" ]; then
      ln -snf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime && echo "$TIMEZONE" >/etc/timezone
      i "[PREP] Timezone '$TIMEZONE' symlinked to /etc/localtime and added to /etc/timezone ✔︎"
    fi
    w "[PREP] (UBUNTU/DEBIAN) Using apt ✔︎"
  else
    e "Unsupported platform!"
    return 1
  fi

  s "[PREP] Completed ✔︎"
}
step_cleanup() {
  section "[CLEAN] Initializing..."

  for e in "$HOME" /root; do
    for f in "$e/.bashrc" "$e/.bash_logout" "$e/.oh-my-zsh" "$e/.profile"; do
      if [ -e "$f" ]; then
        exec_cmd sudo rm -rf "$f"
        w "[CLEAN] '$f' removed ✔︎"
      fi
    done
  done
  s "[CLEAN] Completed (oh-my-zsh removed) ✔︎"
}
step_backup() {
  section "[BAK] Initializing.."

  # Create backup directory with current timestamp
  BACKUP_DIR="$BACKUP_DIR_ROOT/$(date +%Y-%m-%d_%H-%M-%S)"
  exec_cmd sudo mkdir -p "$BACKUP_DIR"
  exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$BACKUP_DIR_ROOT"
  i "[BAK] Backup folder created at '$BACKUP_DIR' ("$USERNAME:$GROUPNAME") ✔"

  # Backup existing files
  for resource in $BACKUP_RESOURCES; do
    resource_path="$HOME/$resource"
    if [ -e "$resource_path" ]; then
      if [ -L "$resource_path" ]; then
        d "Backing up symlink: $resource_path"
      elif [ -d "$resource_path" ]; then
        d "Backing up directory: $resource_path"
      else
        d "Backing up file: $resource_path"
      fi

      exec_cmd sudo mv "$resource_path" "$BACKUP_DIR/"
      i "Backed up: $resource_path ✔"

      # If it was an XDG directory, recreate it with proper ownership
      if [[ "$XDG_COMMON_DIRS" == *"$resource"* ]]; then
        exec_cmd sudo install -d -o "$USERNAME" -g "$USERNAME" "$resource_path"
        i "Recreated directory: $resource_path owned by $USERNAME:$USERNAME ✔"
      fi
    else
      d "Resource does not exist, skipping: $resource_path"
    fi
  done

  s "[BAK] Completed @ '$BACKUP_DIR@$USERNAME:$GROUPNAME' ✔"
}
step_dotfiles() {
  section "[DOTS] Setup started.."

  # Ensure parent directory exists
  dots_parent_dir="$(dirname "$DOTS_DIR")"
  if [ ! -d "$dots_parent_dir" ]; then
    exec_cmd sudo mkdir -p "$dots_parent_dir"
    d "[DOTS] Created Dotfiles parent directory: '$dots_parent_dir'"
  fi
  exec_cmd sudo chown "$USERNAME:$GROUPNAME" "$dots_parent_dir"
  d "[DOTS] Dotfiles parent directory '$dots_parent_dir' is owned by '$USERNAME:$GROUPNAME' ✔"

  # Clone or update repository
  if [ -d "$DOTS_DIR/.git" ]; then
    i "[DOTS] Git repository already exists at '$DOTS_DIR'. Pulling latest changes..."
    if ! exec_cmd git -C "$DOTS_DIR" pull origin main; then
      e "[DOTS] Failed to update repository"
    fi
  elif [ -d "$DOTS_DIR" ]; then
    i "[DOTS] Dots directory exists at '$DOTS_DIR' but is not a git repository. Skipping clone/update."
    i "[DOTS] Assuming dots are already installed or will be handled separately."
  else
    i "[DOTS] Cloning from $REPO_URL into '$DOTS_DIR'..."
    if ! exec_cmd sudo git clone --depth 1 "$REPO_URL" "$DOTS_DIR"; then
      e "[DOTS] Failed to clone repository"
    fi
    i "[DOTS] Dotfiles downloaded to '$DOTS_DIR' ✔"
  fi

  # Handle .config symlink
  config_symlink="$HOME/.config"
  if [ -e "$config_symlink" ]; then
    if [ -L "$config_symlink" ]; then
      current_target="$(readlink "$config_symlink")"
      if [ "$current_target" != "$DOTS_DIR/config" ]; then
        d "[DOTS] Backing up existing .config symlink to '$BACKUP_DIR'.."
        exec_cmd mv "$config_symlink" "$BACKUP_DIR/"
      fi
    else
      d "[DOTS] Backing up existing .config directory to '$BACKUP_DIR'.."
      exec_cmd mv "$config_symlink" "$BACKUP_DIR/"
    fi
  fi

  if [ ! -L "$config_symlink" ] && [ -d "$DOTS_DIR/config" ]; then
    i "[DOTS] Symlinking '$DOTS_DIR/config' to '$config_symlink'.."
    exec_cmd sudo ln -sf "$DOTS_DIR/config" "$config_symlink"
    d "[DOTS] Symlink created: '$config_symlink' -> '$DOTS_DIR/config' ✔"
  fi

  i "[DOTS] Ensuring correct permissions for '$config_symlink' symlink.."
  exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$config_symlink"
  i "[DOTS] '$config_symlink' is owned by '$USERNAME:$GROUPNAME' ✔"

  for dir in "$config_symlink"/*; do
    exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$dir"
    d "[DOTS] '$dir' is owned by '$USERNAME:$GROUPNAME' ✔"
  done

  s "[DOTS] Setup completed ✔"
}
step_xdg() {
  if [ -x "$XDG_ZSH_SETUP_SCRIPT" ]; then
    section "[XDG] Setting up XDG/ZSH environment via '$XDG_ZSH_SETUP_SCRIPT'..."
    . "$XDG_ZSH_SETUP_SCRIPT" "$USERNAME" "$GROUPNAME"
    s "[XDG] Setting up XDG/ZSH environment for '$USERNAME:$GROUPNAME' via '$XDG_ZSH_SETUP_SCRIPT' ✔"
  fi
}
step_mise() {
  section "[MISE] Setup started..."

  if [ -z "${GITHUB_TOKEN:-}" ]; then
    w "[MISE] GITHUB_TOKEN not set, looking up for token..."

    GITHUB_TOKEN=""
    for location in /tmp/github_token /run/secrets/github_token $HOME/.github_token $HOME/.secrets/github_token; do
      if [ -f "$location" ]; then
        export GITHUB_TOKEN="$(cat "$location")"
        w "[MISE] GITHUB_TOKEN loaded from '$location' ✔︎"
        break
      fi
    done
  fi

  if [ -z "${GITHUB_TOKEN:-}" ]; then
    w "[MISE] No GitHub token found - API rate limits may apply"
  fi

  # Check if mise is installed
  if ! has_command "mise"; then
    w "[MISE] mise is not found! Installing..."
    MISE_INSTALL_PATH="$USR_LOCAL_BIN/mise"
    if has_command "curl"; then
      curl https://mise.run | sudo MISE_INSTALL_PATH=$MISE_INSTALL_PATH sh
    elif has_command "wget"; then
      wget -qO- https://mise.run | sudo MISE_INSTALL_PATH=$MISE_INSTALL_PATH sh
    else
      e "[MISE] Neither curl nor wget is installed. Please install one of them to proceed."
      return 1
    fi
    i "[MISE] mise installed successfully system-wide at '$MISE_INSTALL_PATH' ✔︎"

    # Make sure it's executable
    sudo chmod +x $MISE_INSTALL_PATH
    w "[MISE] Now '$MISE_INSTALL_PATH' is executable! ✔︎"
  fi

  i "[MISE] Setting up global configuration..."
  MISE_STATE_HOME="$XDG_STATE_HOME/mise"
  MISE_GLOBAL_CONFIG_DIR="$MISE_DATA_HOME"
  MISE_GLOBAL_CONFIG_FILE="$MISE_GLOBAL_CONFIG_DIR/config.toml"

  # Set global paths and variables
  setup_dir "$MISE_STATE_HOME" "MISE"
  setup_env_and_dir "MISE_GLOBAL_CONFIG_DIR" "$MISE_GLOBAL_CONFIG_DIR" "MISE"
  exec_cmd export MISE_GLOBAL_CONFIG_FILE="$MISE_GLOBAL_CONFIG_FILE"
  i "[MISE] MISE_GLOBAL_CONFIG_FILE set to $MISE_GLOBAL_CONFIG_FILE (owned by '$USERNAME') ✔︎"

  # Create mise config directory if it doesn't exist
  exec_cmd mise settings set global_config_file "$MISE_GLOBAL_CONFIG_FILE"
  exec_cmd mise settings add trusted_config_paths "$MISE_GLOBAL_CONFIG_DIR"
  exec_cmd mise settings add trusted_config_paths "$XDG_DATA_HOME/dots"
  exec_cmd mise settings set activate_aggressive true
  exec_cmd mise settings set auto_install true
  i "[MISE] mise global configuration set to '$MISE_GLOBAL_CONFIG_FILE' ✔︎"

  # Set mise to use global packages
  i "[MISE] Setting mise global packages: '$MISE_PACKAGES' ..."
  exec_cmd mise use --cd "$DOTS_DIR" --yes --global --pin $MISE_PACKAGES
  w "[MISE] Mise global packages: '$MISE_PACKAGES' ✔︎"

  # Cleanup GitHub token
  cleanup_github_token "MISE"

  # Activate mise for the current session
  exec_cmd eval "$(mise activate zsh --yes --quiet --shims)"

  s "[MISE] Setup completed ✔︎"
}
step_zsh() {
  section "[ZSH] Setup started..."

  # Determine the current shell for the user in a cross-platform way
  if command -v getent >/dev/null 2>&1; then
    CURRENT_SHELL=$(getent passwd "$USERNAME" | cut -d: -f7)
  else
    # macOS and some BSDs: use dscl or fallback to /etc/passwd
    if command -v dscl >/dev/null 2>&1; then
      CURRENT_SHELL=$(dscl . -read /Users/"$USERNAME" UserShell | awk '{print $2}')
    else
      CURRENT_SHELL=$(awk -F: -v user="$USERNAME" '$1 == user {print $7}' /etc/passwd)
    fi
  fi

  ZSH_PATH="$(command -v zsh)"

  if [ "$CURRENT_SHELL" != "$ZSH_PATH" ]; then
    if command -v chsh >/dev/null 2>&1; then
      exec_cmd chsh -s "$ZSH_PATH" "$USERNAME"
      i "[ZSH] '$USERNAME' shell set to '$ZSH_PATH' ✔︎"
    elif [ "$(uname)" = "Darwin" ] && command -v dscl >/dev/null 2>&1; then
      exec_cmd sudo dscl . -change /Users/"$USERNAME" UserShell "$CURRENT_SHELL" "$ZSH_PATH"
      i "[ZSH] '$USERNAME' shell set to '$ZSH_PATH' (via dscl) ✔︎"
    else
      w "[ZSH] Could not change shell automatically. Please set '$ZSH_PATH' as the shell for '$USERNAME' manually."
    fi
  else
    i "[ZSH] '$USERNAME' shell is already set to '$ZSH_PATH' ✔︎"
  fi

  # Create the ~/.cache/zsh/compcache directory if it doesn't exist
  setup_dir "$ZSH_COMPCACHE" "ZSH"

  # Create symlinks for the ZSH config files
  ZSH_CONFIG_FILES=".zshenv"
  for file in $ZSH_CONFIG_FILES; do
    if [ -f "$ZDOTDIR/$file" ] && [ ! -L "$HOME/$file" ]; then
      exec_cmd ln -sf "$ZDOTDIR/$file" "$HOME/$file"
      exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$HOME/$file"
      i "[ZSH] $ZDOTDIR/$file symlinked to $HOME/$file owned by '$USERNAME' ✔︎"
    fi
  done

  # Create ZIM's state directory if it doesn't exist
  setup_dir "$XDG_STATE_HOME/zim" "ZSH"

  s "[ZSH] Setup completed ✔︎"
}
step_go() {
  section "[GO] Setup started..."

  if ! command -v go >/dev/null 2>&1; then
    w "[GO] go is not installed! skipping..."
    return
  fi

  # Configure the Go environment variables
  # https://go.dev/doc/gopath_code
  setup_env_and_dir "GOPATH" "${GOPATH:-$XDG_DATA_HOME/go}" "GO"

  s "[GO] Setup completed ✔︎"
}
step_nvim_setup_provider_npm() {
  section "[NVIM/NPM] Setting up NPM provider..."
  # https://neovim.io/doc/user/provider.html#provider-nodejs

  if ! command -v npm >/dev/null 2>&1; then
    w "[NVIM/NPM] npm is not installed! skipping..."
    return
  fi

  # Configure the NPM environment variables
  # https://docs.npmjs.com/cli/v7/configuring-npm
  setup_dir "$NPM_CONFIG_PREFIX" "NVIM/NPM"
  setup_dir "$NPM_CONFIG_CACHE" "NVIM/NPM"
  exec_cmd export NPM_CONFIG_USERCONFIG="${NPM_CONFIG_USERCONFIG:-$XDG_CONFIG_HOME/npm/.npmrc}"
  i "[NVIM/NPM] NPM_CONFIG_USERCONFIG set to '$NPM_CONFIG_USERCONFIG' (owned by '$USERNAME') ✔︎"

  # Install neovim's required NPM packages
  exec_cmd npm -g --prefix="$NPM_CONFIG_PREFIX" install neovim @mermaid-js/mermaid-cli
  i "[NVIM/NPM] Required NPM packages installed at '$NPM_CONFIG_PREFIX/lib/node_modules' (owned by '$USERNAME') ✔︎"
}
step_nvim_setup_provider_python() {
  section "[NVIM/PYTHON] Setting up Python provider..."
  # https://neovim.io/doc/user/provider.html#provider-python

  if ! command -v python3 >/dev/null 2>&1; then
    w "[NVIM/PYTHON] python3 is not installed! skipping..."
    return
  fi

  if [ ! -d "$XDG_CONFIG_HOME/nvim/.venv" ]; then
    exec_cmd cd "$XDG_CONFIG_HOME/nvim" && python3 -m venv "$XDG_CONFIG_HOME/nvim/.venv"
  fi

  # Use uv to create a virtual environment
  exec_cmd cd "$XDG_CONFIG_HOME/nvim" && source "$XDG_CONFIG_HOME/nvim/.venv/bin/activate" && pip install greenlet pynvim neovim --force-reinstall
  i "[NVIM/PYTHON] Required Python packages installed at '$XDG_CONFIG_HOME/nvim/.venv' (owned by '$USERNAME') ✔︎"
}
step_nvim_setup_provider_ruby() {
  section "[NVIM/RUBY] Setting up Ruby provider..."
  # https://neovim.io/doc/user/provider.html#provider-ruby

  if ! command -v gem >/dev/null 2>&1; then
    w "[NVIM/RUBY] gem is not installed! skipping..."
    return
  fi

  # Configure the gem home directory
  # https://guides.rubygems.org/command-reference/#gem-environment
  setup_env_and_dir "GEM_HOME" "${GEM_HOME:-${HOMEBREW_OPT:-$XDG_DATA_HOME}/gems}" "NVIM/RUBY"

  # Update the RubyGems system
  exec_cmd gem update --system --no-document

  # Install neovim's required Ruby packages
  exec_cmd gem install neovim rubocop
  i "[NVIM/RUBY] Required GEM packages installed at '$GEM_HOME' (owned by '$USERNAME') ✔︎"
}
step_nvim() {
  section "[NVIM] Setup started..."

  # Check if nvim is installed
  if [ ! -x "$MISE_DATA_HOME/shims/nvim" ]; then
    w "[NVIM] nvim is not installed at '$MISE_DATA_HOME/shims/nvim'! skipping..."
    return
  fi

  if [ ! -d "$XDG_CONFIG_HOME/nvim" ]; then
    w "[NVIM] nvim is not installed at '$XDG_CONFIG_HOME/nvim'! skipping..."
    return
  fi

  # Create nvim's required directories
  setup_dir "$XDG_STATE_HOME/nvim" "NVIM"
  setup_dir "$XDG_DATA_HOME/nvim" "NVIM"

  # Setup nvim providers
  step_nvim_setup_provider_npm
  step_nvim_setup_provider_python
  step_nvim_setup_provider_ruby

  # Install nvim plugins
  exec_cmd cd "$XDG_CONFIG_HOME/nvim" &&
    exec_cmd "$MISE_DATA_HOME/shims/nvim" --headless +verbose \
      +'Lazy! sync' \
      +'Lazy! clean' \
      +'Lazy! clear' \
      +'TSUpdateSync' \
      -c 'lua require("lazy").load({plugins = {"mason-lspconfig.nvim"}})' \
      -c 'MasonInstall ast-grep bash-language-server css-lsp diagnostic-languageserver docker-compose-language-service dockerfile-language-server eslint-lsp html-lsp json-lsp lua-language-server marksman neocmakelsp prettier pyright ruby-lsp shfmt stylua taplo vim-language-server vtsls yaml-language-server' +qa

  s "[NVIM] Setup completed ✔︎"
}
step_chown() {
  section "[CHOWN] Ensuring ownership of essential directories started..."

  if [ -d "$XDG_LOCAL_DIR" ]; then
    exec_cmd sudo chown "$USERNAME:$GROUPNAME" "$XDG_LOCAL_DIR"
    i "[CHOWN] '$XDG_LOCAL_DIR' are owned by '$USERNAME:$GROUPNAME' ✔︎"
  else
    w "[CHOWN] '$XDG_LOCAL_DIR' does not exist. Skipping.. ✔︎"
  fi

  for dir in "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$XDG_DATA_HOME"; do
    if [ -d "$dir" ]; then
      exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$dir"
      i "[CHOWN] '$dir' are owned (recursively) by '$USERNAME:$GROUPNAME' ✔︎"
    else
      w "[CHOWN] '$dir' does not exist. Skipping.. ✔︎"
    fi
  done

  s "[CHOWN] Completed ✔︎"
}

main() {
  step_extract_arguments "$@"
  step_detect_platform
  w "[INSTALL] ($CONTEXT) Starting 🚀"
  step_set_and_show_environment_variables
  step_prepare
  step_cleanup
  step_backup
  step_dotfiles
  step_xdg
  step_mise
  step_zsh
  step_go
  step_nvim
  step_chown
  s "[INSTALL] ($CONTEXT) DONE ✅"
}

main "$@"
