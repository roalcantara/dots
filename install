#!/usr/bin/env bash
set -eu

# USAGE
# ./install                                             -- install with default values
# ./install -u <username> -g <groupname> -t <timezone>  -- install with custom values

# COLORS
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly PURPLE='\033[0;35m'
readonly NC='\033[0m'

# GLOBAL variables
declare -g OS="debian"
declare -g DISTRO="debian"
declare -g USERNAME="roalcantara"
declare -g GROUPNAME="wheel"
declare -g USERHOME="/home/$USERNAME"
declare -g TIMEZONE="America/Sao_Paulo"
declare -g REPO_URL="https://github.com/roalcantara/dots"
declare -g BRANCH="main"
declare -g LOCALGROUP=$(id -gn 2>/dev/null)
declare -g LOCALUSER=$(id -un 2>/dev/null)
declare -g USR_LOCAL_BIN="/usr/local/bin"
declare -g XDG_COMMON_DIRS=".config .cache .local .local/share .local/state .local/bin"
declare -g BACKUP_RESOURCES=".bashrc .bash_logout .bash_profile .profile .zshrc .zprofile .gitconfig .config"
declare -g CONTEXT
declare -g ARCH
declare -g ENV
declare -g -A PACKAGES=(
  # https://guides.rubyonrails.org/development_dependencies_install.html#ubuntu
  [debian]="sudo build-essential libssl-dev libffi-dev libyaml-dev libxml2-dev xclip xsel gitlint"
  [mise]="ripgrep bat delta eza fd fzf gh neovim starship usage watchexec zoxide gum node@22.17 python pre-commit"
)

puts() {
  if [ -n "$CONTEXT" ]; then
    echo -e "$1 [$(date '+%Y-%m-%d %H:%M:%S')] ($CONTEXT) $2"
  else
    echo -e "$1 [$(date '+%Y-%m-%d %H:%M:%S')] $2"
  fi
}
i() { puts "${BLUE}[INFO!]${NC}" "$*"; }
e() { puts "${RED}[ERROR]${NC}" "$*" >&2; }
w() { puts "${YELLOW}[WARN!]${NC}" "$*"; }
d() { puts "${PURPLE}[DEBUG]${NC}" "$*"; }
s() { puts "${GREEN}[DONE!]${NC}" "$*"; }

# Print a section header
# Usage: section <title>
section() {
  echo "===================================================="
  echo "$1"
  echo "===================================================="
}
# Check if the script is running in a container
# Usage: is_container
is_container() {
  # Check environment variables, container-specific files, and cgroups
  if [ -n "${DOCKER_CONTAINER:-}" ] || [ -n "${container:-}" ] ||
    [ -f "/.dockerenv" ] || [ -f "/var/run/docker.sock" ] || [ -f "/run/.containerenv" ] ||
    ([ -f "/proc/1/cgroup" ] && (grep -q "docker" "/proc/1/cgroup" || grep -q '^0::/$' /proc/1/cgroup)); then
    return 0
  fi
  return 1
}
# Remove the GitHub token from the environment
# Usage: cleanup_github_token <section_name>
cleanup_github_token() {
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    exec_cmd unset GITHUB_TOKEN
    w "[$1] GitHub token removed from environment"
  fi
}
# Execute a command and return the exit status
# Usage: exec_cmd <command>
exec_cmd() {
  w "Executing: $*"
  "$@"
  return $?
}
# Check if a command is available
# Usage: has_command <command>
has_command() {
  command -v "$1" >/dev/null 2>&1
}
export_env_var() {
  local env_var_name="$1"
  local value="$2"
  local section_name="$3"
  local force=("${@:4}")

  if [ "${force[*]}" == "--force" ] || [ -z "${!env_var_name:-}" ]; then
    exec_cmd eval "export $env_var_name=\"$value\""
  fi
}
# Ensure ownership of a path
# Usage: set_ownership <path> <section_name> (required_owner)
set_ownership() {
  local TARGET="$1"
  local LABEL="$2"
  local OWNER="${3:-$UID}"

  declare owner
  case "$(uname)" in
  Darwin)
    owner=$(stat -f "%u" "$TARGET" 2>/dev/null || echo "0")
    ;;
  Linux)
    owner=$(stat -c "%u" "$TARGET" 2>/dev/null || echo "0")
    ;;
  esac

  if [[ "$owner" != "$OWNER" ]]; then
    exec_cmd chown -R "$OWNER" "$TARGET" 2>/dev/null || sudo chown -R "$OWNER" "$TARGET" || {
      e "[$LABEL] ⚠ Failed to change ownership of $TARGET" >&2
      return 1
    }
  fi
}
# Ensure permission of a path
# Usage: set_permissions <path> <section_name> (required_permission)
set_permissions() {
  local TARGET="$1"
  local LABEL="$2"
  local PERM="${3:-700}"

  declare perms
  case "$(uname)" in
  Darwin)
    perms=$(stat -f "%Lp" "$TARGET" 2>/dev/null || echo "000")
    ;;
  Linux)
    perms=$(stat -c "%a" "$TARGET" 2>/dev/null || echo "000")
    ;;
  esac

  if [[ "$perms" != "$PERM" ]]; then
    exec_cmd chmod $PERM "$TARGET" 2>/dev/null || sudo chmod $PERM "$TARGET" || {
      e "[$LABEL] ⚠ Failed to set permissions on $TARGET" >&2
      return 1
    }
  fi
}
# Setup directory with proper ownership (without environment variable) as sudo
# Usage: setup_dir <path> <section_name>
setup_dir() {
  local TARGET="$1"
  local LABEL="$2"
  local OWNER="${3:-"$USERNAME:$GROUPNAME"}"

  # Create directory if it doesn't exist
  if [ ! -d "$TARGET" ]; then
    exec_cmd mkdir -p "$TARGET" 2>/dev/null || sudo mkdir -p "$TARGET" || {
      e "[$LABEL] ⚠ Failed to create directory $TARGET" >&2
      return 1
    }
  fi

  # Ensure ownership
  set_ownership "$TARGET" "$LABEL" "$OWNER"
}
# Setup environment variable and directory with proper ownership
# Usage: setup_env_and_dir <env_var_name> <default_path> <section_name>
setup_env_and_dir() {
  local env_var_name="$1"
  local default_path="$2"
  local section_name="$3"

  # Create directory if it doesn't exist
  setup_dir "${!env_var_name}" "$section_name/$env_var_name"

  # Set environment variable if not already set
  export_env_var "$env_var_name" "$default_path" "$section_name" "${@:4}"
}
# Setup environment variable and directory with proper ownership
# Usage: setup_env_and_dir <env_var_name> <default_path> <section_name>
export_env_and_make_dir() {
  local env_var_name="$1"
  local default_path="$2"
  local section_name="$3"

  # Create directory if it doesn't exist
  setup_dir "$default_path" "$section_name/$env_var_name"

  # Set environment variable if not already set
  export_env_var "$env_var_name" "$default_path" "$section_name" "${@:4}"
}
setup_platform() {
  section "[ENV/DETECT] Detecting platform and package managers..."

  OS="$(uname -s | tr '[:upper:]' '[:lower:]')"

  if [ -f "/etc/os-release" ]; then
    DISTRO=$(. /etc/os-release && echo "$ID" | head -1 | tr '[:upper:]' '[:lower:]')
  elif [ -f "/etc/arch-release" ]; then
    DISTRO="arch"
  elif [ "$(uname -s)" = "Darwin" ]; then
    DISTRO="darwin"
  else
    DISTRO="unknown"
  fi

  UNAMED_ARCH="$(uname -m)"
  if [ "$UNAMED_ARCH" = "aarch64" ] || [ "$UNAMED_ARCH" = "arm64" ]; then
    ARCH="arm64"
  else
    ARCH="amd64"
  fi

  if is_container; then
    ENV="container"
  else
    ENV="host"
  fi

  CONTEXT="$OS/$ARCH/$ENV"
  s "Detected platform: '$CONTEXT' ✔︎"
}
setup_arguments() {
  section "[ENV/ARGS] Extracting arguments..."
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -r | --repo | --repo_url)
      REPO_URL="$2"
      shift 2
      ;;
    -b | --branch)
      BRANCH="$2"
      shift 2
      ;;
    -t | --timezone)
      TIMEZONE="$2"
      shift 2
      ;;
    -u | --username)
      USERNAME="$2"
      shift 2
      ;;
    -g | --groupname)
      GROUPNAME="$2"
      shift 2
      ;;
    --usr_local_bin)
      USR_LOCAL_BIN="$2"
      shift 2
      ;;
    --xdg_config_home)
      XDG_CONFIG_HOME="$2"
      shift 2
      ;;
    --xdg_cache_home)
      XDG_CACHE_HOME="$2"
      shift 2
      ;;
    --xdg_local_dir)
      XDG_LOCAL_DIR="$2"
      shift 2
      ;;
    --xdg_data_home)
      XDG_DATA_HOME="$2"
      shift 2
      ;;
    --xdg_state_home)
      XDG_STATE_HOME="$2"
      shift 2
      ;;
    --zsh_cache_dir)
      ZSH_CACHE_DIR="$2"
      shift 2
      ;;
    --zsh_compcache)
      ZSH_COMPCACHE="$2"
      shift 2
      ;;
    --zsh_compdump)
      ZSH_COMPDUMP="$2"
      shift 2
      ;;
    --mise_data_home)
      MISE_DATA_HOME="$2"
      shift 2
      ;;
    --backup_dir_root)
      BACKUP_DIR_ROOT="$2"
      shift 2
      ;;
    --dots_dir)
      DOTS_DIR="$2"
      shift 2
      ;;
    --backup_resources)
      BACKUP_RESOURCES="$2"
      shift 2
      ;;
    *)
      w "Unknown argument: $1"
      exit 1
      ;;
    esac
  done
}
detect_user_by_distribution() {
  if [[ "$OS" =~ "darwin" || "$DISTRO" =~ "darwin" || "$DISTRO" =~ "macos" ]]; then
    USERHOME="/Users/$USERNAME"
    GROUPNAME=${GROUPNAME:-"staff"}
  elif [[ "$DISTRO" =~ "debian" || "$DISTRO" =~ "ubuntu" ]]; then
    # user detection
    if [ -n "${USER:-}" ] && [ "$USER" != "root" ]; then
      # Use the current USER environment variable if available and not root
      USERNAME="$USER"
    elif [ -d "/home" ]; then
      # Check for users in /home directory
      HOME_USERS=$(find /home -maxdepth 1 -type d 2>/dev/null | sed 's|.*/||' | tr '\n' ' ')
      if [ "$(echo "$HOME_USERS" | wc -w)" -eq 1 ]; then
        # If there's exactly one user directory in /home, use that
        USERNAME=$(echo "$HOME_USERS" | tr -d ' ')
      elif [ "$(echo "$HOME_USERS" | wc -w)" -gt 1 ]; then
        # If multiple users, prioritize common DevContainer users
        for preferred_user in "node" "vscode" "developer" "app"; do
          if echo "$HOME_USERS" | grep -qw "$preferred_user"; then
            USERNAME="$preferred_user"
            break
          fi
        done
        # If no preferred user found, use the first one
        if [ -z "$USERNAME" ]; then
          USERNAME=$(echo "$HOME_USERS" | awk '{print $1}')
        fi
      fi
    fi

    # If no user detected, try other methods
    if [ -z "$USERNAME" ]; then
      if command -v getent >/dev/null 2>&1; then
        # Look for users with UID >= 1000 (typical for regular users)
        # Prioritize common DevContainer users
        for preferred_user in "node" "vscode" "developer" "app"; do
          if getent passwd "$preferred_user" >/dev/null 2>&1; then
            USERNAME="$preferred_user"
            break
          fi
        done

        # If no preferred user found, get the first regular user
        if [ -z "$USERNAME" ]; then
          MIN_UID=1000  # 1000 is the minimum UID for a regular user
          MAX_UID=65534 # 65534 is the maximum UID for a regular user
          USERNAME=$(getent passwd | awk -F: -v min_uid="$MIN_UID" -v max_uid="$MAX_UID" '$3 >= min_uid && $3 < max_uid {print $1; exit}')
        fi
      fi

      # If still no user determined, create user and group 'vscode'
      if [ -z "$USERNAME" ]; then
        USERNAME="vscode"
        w "[ENV/SETUP] Could not determine username, defaulting to '$USERNAME'"

        # Create vscode group if they don't exist
        if ! getent group vscode >/dev/null 2>&1; then
          w "[ENV/SETUP] Creating group 'vscode'..."
          groupadd vscode
        fi

        # Create vscode user if they don't exist
        if ! getent passwd vscode >/dev/null 2>&1; then
          w "[ENV/SETUP] Creating user 'vscode'..."
          useradd -m -g vscode -s /bin/bash vscode
        fi
      fi
    fi

    USERHOME="/home/$USERNAME"
    if getent passwd "$USERNAME" >/dev/null 2>&1; then
      GROUPNAME=$(id -gn "$USERNAME")
    else
      GROUPNAME="vscode"
    fi
  fi

  w "[ENV/SETUP/USER:GROUP] USERNAME='$USERNAME' ($USER) GROUPNAME='$GROUPNAME' (${GROUP:-}) HOME='$USERHOME' ($HOME) ✔︎"
  if [ -z "$HOME" ] || [ "$HOME" != "$USERHOME" ]; then
    HOME="$USERHOME"
    w "[ENV/SETUP/USER:GROUP/HOME] HOME updated to '$HOME' ✔︎"
  fi
}
setup_environment_variables() {
  section "[ENV/SETUP] Setting up environment variables..."
  detect_user_by_distribution

  # Export XDG variables with fallbacks
  exec_cmd export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
  exec_cmd export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
  exec_cmd export XDG_LOCAL_DIR=${XDG_LOCAL_DIR:-$HOME/.local}
  exec_cmd export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
  exec_cmd export XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
  exec_cmd export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/runtime-${UID:-"${USERNAME:-$(id -un)}"}}

  # User directories
  exec_cmd export XDG_DESKTOP_DIR=${XDG_DESKTOP_DIR:-$HOME/Desktop}
  exec_cmd export XDG_DOWNLOAD_DIR=${XDG_DOWNLOAD_DIR:-$HOME/Downloads}
  exec_cmd export XDG_DOCUMENTS_DIR=${XDG_DOCUMENTS_DIR:-$HOME/Documents}
  exec_cmd export XDG_MUSIC_DIR=${XDG_MUSIC_DIR:-$HOME/Music}
  exec_cmd export XDG_PICTURES_DIR=${XDG_PICTURES_DIR:-$HOME/Pictures}
  exec_cmd export XDG_VIDEOS_DIR=${XDG_VIDEOS_DIR:-$HOME/Movies}
  exec_cmd export XDG_PROJECTS_DIR=${XDG_PROJECTS_DIR:-$HOME/Projects}
  exec_cmd export XDG_WORKSPACE_DIR=${XDG_WORKSPACE_DIR:-$HOME/Work}

  # ZSH
  exec_cmd export ZDOTDIR=${ZDOTDIR:-$HOME/.config/zsh}
  exec_cmd export ZSH_DATA_DIR=${ZSH_DATA_DIR:-$HOME/.local/share/zsh}
  exec_cmd export ZSH_CACHE_DIR=${ZSH_CACHE_DIR:-$HOME/.cache/zsh}
  exec_cmd export ZSH_COMPCACHE=${ZSH_COMPCACHE:-$HOME/.cache/zsh/compcache}
  exec_cmd export ZIM_HOME=${ZIM_HOME:-$HOME/.local/share/zim}
  exec_cmd export ZSH_COMPDUMP=${ZSH_COMPDUMP:-$HOME/.cache/zsh/compcache/.zcompdump}

  # MISE & MISC
  exec_cmd export MISE_DATA_HOME=${MISE_DATA_HOME:-$HOME/.local/share/mise}
  exec_cmd export DOTS_DIR=${DOTS_DIR:-$HOME/.local/share/dots}
  exec_cmd export BACKUP_DIR_ROOT=${BACKUP_DIR_ROOT:-$HOME/.local/share/backup}
  exec_cmd export NPM_CONFIG_PREFIX=${NPM_CONFIG_PREFIX:-$HOME/.local/share/npm}
  exec_cmd export NPM_CONFIG_CACHE=${NPM_CONFIG_CACHE:-$HOME/.cache/npm}
}
step_setup_environment() {
  setup_platform
  setup_arguments "$@"
  setup_environment_variables
  section "[ENV/SHOW] Showing environment variables..."
  i "OS = \"$OS\""
  i "ARCH = \"$ARCH\""
  i "ENV = \"$ENV\""
  i "HOME = \"$HOME\""
  i "CONTEXT = \"$CONTEXT\""
  i "REPO_URL = \"$REPO_URL\""
  i "BRANCH = \"$BRANCH\""
  i "TIMEZONE = \"$TIMEZONE\""
  i "LOCALGROUP = \"$LOCALGROUP\""
  i "LOCALUSER = \"$LOCALUSER\""
  i "USERNAME = \"$USERNAME\""
  i "GROUPNAME = \"$GROUPNAME\""
  i "USR_LOCAL_BIN = \"$USR_LOCAL_BIN\""
  i "XDG_CONFIG_HOME = \"$XDG_CONFIG_HOME\""
  i "XDG_CACHE_HOME = \"$XDG_CACHE_HOME\""
  i "XDG_LOCAL_DIR = \"$XDG_LOCAL_DIR\""
  i "XDG_DATA_HOME = \"$XDG_DATA_HOME\""
  i "XDG_STATE_HOME = \"$XDG_STATE_HOME\""
  i "ZDOTDIR = \"$ZDOTDIR\""
  i "ZSH_CACHE_DIR = \"$ZSH_CACHE_DIR\""
  i "ZSH_COMPCACHE = \"$ZSH_COMPCACHE\""
  i "ZSH_COMPDUMP = \"$ZSH_COMPDUMP\""
  i "MISE_DATA_HOME = \"$MISE_DATA_HOME\""
  i "BACKUP_DIR_ROOT = \"$BACKUP_DIR_ROOT\""
  i "BACKUP_RESOURCES = \"$BACKUP_RESOURCES\""
  i "DOTS_DIR = \"$DOTS_DIR\""
}
step_prepare() {
  section "[PREP/$DISTRO] Setting up essential dependencies"

  if has_command apt; then
    exec_cmd apt-get update && apt-get install -y --no-install-recommends ${PACKAGES[$DISTRO]} &&
      sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/*

    i "[PREP/$DISTRO] Essential packages installed: '${PACKAGES[$DISTRO]}' ✔︎"

    if [ -n "$TIMEZONE" ]; then
      exec_cmd ln -snf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime && exec_cmd echo "$TIMEZONE" >/etc/timezone
      i "[PREP/timezone] Timezone '$TIMEZONE' symlinked to /etc/localtime and added to /etc/timezone ✔︎"
    fi
  else
    e "Unsupported platform!"
    return 1
  fi

  s "[PREP] Completed ✔︎"
}
step_cleanup() {
  section "[CLEAN] Initializing..."
  for e in "$HOME" /root; do
    for f in "$e/.bashrc" "$e/.bash_logout" "$e/.oh-my-zsh" "$e/.profile"; do
      if [ -e "$f" ]; then
        exec_cmd sudo rm -rf "$f"
      fi
    done
  done
  s "[CLEAN] Completed (and oh-my-zsh removed)! ✔︎"
}
step_backup() {
  section "[BAK] Initializing.."

  if is_container; then
    w "[BAK] 🐳 Removing files instead of backing up ✔︎"
    for resource in $BACKUP_RESOURCES; do
      resource_path="$HOME/$resource"
      if [ -e "$resource_path" ]; then
        exec_cmd sudo rm -rf "$resource_path"
      fi
    done
    s "[BAK] Completed @ '$USERNAME:$GROUPNAME' ✔︎"
  else
    w "[BAK] Creating backup directory with current timestamp ✔︎"
    BACKUP_DIR="$BACKUP_DIR_ROOT/$(date +%Y-%m-%d_%H-%M-%S)"
    exec_cmd sudo mkdir -p "$BACKUP_DIR"
    exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$BACKUP_DIR_ROOT"
    i "[BAK] Backup folder created at '$BACKUP_DIR' ("$USERNAME:$GROUPNAME") ✔︎"

    for resource in $BACKUP_RESOURCES; do
      resource_path="$HOME/$resource"
      if [ -e "$resource_path" ]; then
        exec_cmd sudo mv "$resource_path" "$BACKUP_DIR/"
        if [[ "$XDG_COMMON_DIRS" == *"$resource"* ]]; then
          exec_cmd sudo install -d -o "$USERNAME" -g "$USERNAME" "$resource_path"
          i "Recreated directory: $resource_path owned by $USERNAME:$USERNAME ✔︎"
        fi
      else
        d "Resource does not exist, skipping: $resource_path"
      fi
    done
    s "[BAK] Completed @ '$BACKUP_DIR@$USERNAME:$GROUPNAME' ✔︎"
  fi
}
step_dotfiles() {
  section "[DOTS] Setup started.."

  # Ensure parent directory exists
  dots_parent_dir="$(dirname "$DOTS_DIR")"
  setup_dir "$dots_parent_dir" "DOTS/$dots_parent_dir"

  # Clone or update repository
  if [ -d "$DOTS_DIR/.git" ]; then
    i "[DOTS] Git repository already exists at '$DOTS_DIR'. Pulling latest changes from '$BRANCH'..."
    if ! exec_cmd git -C "$DOTS_DIR" pull origin "$BRANCH"; then
      e "[DOTS] Failed to update repository"
    fi
    i "[DOTS] '$REPO_URL' ($BRANCH) updated to '$DOTS_DIR' ✔︎"
  elif [ -d "$DOTS_DIR" ] && [ ! -d "$DOTS_DIR/config" ]; then
    i "[DOTS] '$DOTS_DIR/config' not found! Cloning from '$REPO_URL' ($BRANCH) into '$DOTS_DIR'..."
    if ! exec_cmd sudo git clone --branch "$BRANCH" --depth 1 "$REPO_URL" "$DOTS_DIR"; then
      e "[DOTS] Failed to clone repository"
    fi
    i "[DOTS] '$REPO_URL' ($BRANCH) cloned to '$DOTS_DIR' ✔︎"
  else
    w "[DOTS] '$DOTS_DIR/config' found! But not a git repository! Assuming to be already installed or will be handled separately.."
  fi

  if [ ! -d "$DOTS_DIR/config" ]; then
    e "[DOTS] '$DOTS_DIR/config' directory not found! Impossible to continue..."
    exec_cmd ls -la "$XDG_DATA_HOME"
    exec_cmd ls -la "$dots_parent_dir"
    exec_cmd ls -la "$DOTS_DIR"
    exec_cmd ls -la "$DOTS_DIR/config"
    return 1
  fi

  i "[DOTS] Handling existent '$HOME/.config' directory/symlink.."
  config_symlink="$HOME/.config"
  if [ -e "$config_symlink" ]; then
    i "[DOTS] '$config_symlink' exists! Checking if it is a symlink.."
    if [ -L "$config_symlink" ]; then
      i "[DOTS] '$config_symlink' is a symlink! Checking the current target of the symlink '$config_symlink'.."
      current_target="$(readlink "$config_symlink")"
      i "[DOTS] Handling existent '$config_symlink' targeting '$current_target'.."
      if [ "$current_target" != "$DOTS_DIR/config" ]; then
        if is_container; then
          exec_cmd sudo rm -rf "$config_symlink"
        else
          exec_cmd mv "$config_symlink" "$BACKUP_DIR/"
        fi
      fi
    else
      i "[DOTS] '$config_symlink' is not a symlink!"
      if is_container; then
        exec_cmd sudo rm -rf "$config_symlink"
        w "[DOTS] 🐳 Existent '$config_symlink' directory has been removed ✔︎"
      else
        exec_cmd mv "$config_symlink" "$BACKUP_DIR/"
        d "[DOTS] Existing '$config_symlink' directory backed up to '$BACKUP_DIR' ✔︎"
      fi
    fi
  else
    w "[DOTS] '$config_symlink' directory not found ✔︎"
  fi

  i "[DOTS] Ensuring correct symlink for '$config_symlink' to '$DOTS_DIR/config'.."
  if [ -e "$config_symlink" ] && [ -L "$config_symlink" ]; then
    current_target="$(readlink "$config_symlink")"
    i "[DOTS] Handling existent symlink '$config_symlink' targeting '$current_target'.."
    if [ "$current_target" != "$DOTS_DIR/config" ]; then
      if is_container; then
        exec_cmd sudo rm -rf "$config_symlink"
      else
        exec_cmd mv "$config_symlink" "$BACKUP_DIR/"
      fi
    fi
  else
    w "[DOTS] '$config_symlink' is not a symlink ✔︎"
  fi

  i "[DOTS] Symlinking '$DOTS_DIR/config' to '$config_symlink'.."
  if [ ! -L "$config_symlink" ]; then
    exec_cmd sudo ln -sf "$DOTS_DIR/config" "$config_symlink"
  else
    w "[DOTS] No existent '$config_symlink' symlink to '$DOTS_DIR/config' found ✔︎"
  fi

  # Ensure ownership of the symlink
  set_ownership "$config_symlink" "DOTS"

  # Ensure ownership of all files and directories in the symlink
  for dir in "$config_symlink"/*; do
    set_ownership "$dir" "DOTS/SYMLINK"
  done

  s "[DOTS] Setup completed ✔︎"
}
step_ensure_ownership() {
  section "[XDG] Ensuring ownership of XDG directories started..."
  for dir in "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_LOCAL_DIR" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_DESKTOP_DIR" "$XDG_DOWNLOAD_DIR" "$XDG_DOCUMENTS_DIR" "$XDG_MUSIC_DIR" "$XDG_PICTURES_DIR" "$XDG_VIDEOS_DIR" "$XDG_PROJECTS_DIR" "$XDG_WORKSPACE_DIR" "$XDG_RUNTIME_DIR"; do
    setup_dir "$dir" "XDG/CHOWN/$dir"
  done
  set_permission "$XDG_RUNTIME_DIR" "XDG/CHMOD/$XDG_RUNTIME_DIR" 700
  s "[XDG] Completed ✔︎"

  if [[ "$*" =~ '--zsh' ]]; then
    section "[ZSH] Ensuring ownership of ZSH directories started..."
    for dir in "$ZSH_DATA_DIR" "$ZSH_CACHE_DIR" "$ZSH_COMPCACHE" "$ZIM_HOME"; do
      setup_dir "$dir" "ZSH/CHOWN/$dir"
    done
    s "[ZSH] Completed ✔︎"
  fi
}
step_mise() {
  section "[MISE] Setting up..."

  if [ -z "${GITHUB_TOKEN:-}" ]; then
    w "[MISE] GITHUB_TOKEN not set, looking up for token..."

    GITHUB_TOKEN=""
    for location in /tmp/github_token /run/secrets/github_token $HOME/.github_token $HOME/.secrets/github_token; do
      if [ -f "$location" ]; then
        export GITHUB_TOKEN="$(cat "$location")"
        w "[MISE] GITHUB_TOKEN loaded from '$location' ✔︎"
        break
      fi
    done
  fi

  if [ -z "${GITHUB_TOKEN:-}" ]; then
    w "[MISE] No GitHub token found - API rate limits may apply"
  fi

  # Check if mise is installed
  if ! has_command "mise"; then
    w "[MISE] mise is not found! Installing..."
    MISE_INSTALL_PATH="$USR_LOCAL_BIN/mise"
    if has_command "curl"; then
      curl https://mise.run | sudo MISE_INSTALL_PATH=$MISE_INSTALL_PATH sh
    elif has_command "wget"; then
      wget -qO- https://mise.run | sudo MISE_INSTALL_PATH=$MISE_INSTALL_PATH sh
    else
      e "[MISE] Neither curl nor wget is installed. Please install one of them to proceed."
      return 1
    fi

    exec_cmd sudo chmod +x "$MISE_INSTALL_PATH"
  fi

  i "[MISE] Setting up global configuration..."
  export_env_and_make_dir "MISE_STATE_HOME" "$XDG_STATE_HOME/mise" "MISE"
  export_env_and_make_dir "MISE_GLOBAL_CONFIG_DIR" "$XDG_DATA_HOME/mise" "MISE"
  exec_cmd export MISE_GLOBAL_CONFIG_FILE="$XDG_DATA_HOME/mise/config.toml"
  exec_cmd mise settings set global_config_file "$XDG_DATA_HOME/mise/config.toml"
  exec_cmd mise settings add trusted_config_paths "$MISE_GLOBAL_CONFIG_DIR"
  exec_cmd mise settings add trusted_config_paths "$XDG_DATA_HOME/dots"
  exec_cmd mise settings set activate_aggressive true
  exec_cmd mise settings set auto_install true
  i "[MISE] Global configuration set to '$XDG_DATA_HOME/mise/config.toml' (owned by '$USERNAME') ✔︎"

  # Install global packages
  exec_cmd mise use --cd "$DOTS_DIR" --yes --global --pin ${PACKAGES[mise]}
  i "[MISE] Global packages installed: '${PACKAGES[mise]}' ✔︎"

  # Cleanup GitHub token if it exists
  cleanup_github_token "MISE"

  # Activate mise for the current session
  exec_cmd eval "$(mise activate zsh --yes --quiet --shims)"

  s "[MISE] Setup completed ✔︎"
}
step_zsh() {
  section "[ZSH] Setup started..."

  # Determine the current shell for the user in a cross-platform way
  if command -v getent >/dev/null 2>&1; then
    CURRENT_SHELL=$(getent passwd "$USERNAME" | cut -d: -f7)
  else
    # macOS and some BSDs: use dscl or fallback to /etc/passwd
    if command -v dscl >/dev/null 2>&1; then
      CURRENT_SHELL=$(dscl . -read /Users/"$USERNAME" UserShell | awk '{print $2}')
    else
      CURRENT_SHELL=$(awk -F: -v user="$USERNAME" '$1 == user {print $7}' /etc/passwd)
    fi
  fi

  ZSH_PATH="$(command -v zsh)"

  if [ "$CURRENT_SHELL" != "$ZSH_PATH" ]; then
    if command -v chsh >/dev/null 2>&1; then
      exec_cmd sudo chsh -s "$ZSH_PATH" "$USERNAME"
      i "[ZSH] '$USERNAME' shell set to '$ZSH_PATH' ✔︎"
    elif [ "$(uname)" = "Darwin" ] && command -v dscl >/dev/null 2>&1; then
      exec_cmd sudo dscl . -change /Users/"$USERNAME" UserShell "$CURRENT_SHELL" "$ZSH_PATH"
      i "[ZSH] '$USERNAME' shell set to '$ZSH_PATH' (via dscl) ✔︎"
    else
      w "[ZSH] Could not change shell automatically. Please set '$ZSH_PATH' as the shell for '$USERNAME' manually."
    fi
  else
    i "[ZSH] '$USERNAME' shell is already set to '$ZSH_PATH' ✔︎"
  fi

  # Create the ~/.cache/zsh/compcache directory if it doesn't exist
  setup_dir "$ZSH_COMPCACHE" "ZSH"

  # Create symlinks for the ZSH config files
  ZSH_CONFIG_FILES=".zshenv"
  for file in $ZSH_CONFIG_FILES; do
    if [ -f "$ZDOTDIR/$file" ] && [ ! -L "$HOME/$file" ]; then
      exec_cmd ln -sf "$ZDOTDIR/$file" "$HOME/$file"
      exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$HOME/$file"
      i "[ZSH] $ZDOTDIR/$file symlinked to $HOME/$file owned by '$USERNAME' ✔︎"
    fi
  done

  # Create ZIM's state directory if it doesn't exist
  setup_dir "$XDG_STATE_HOME/zim" "ZSH"

  s "[ZSH] Setup completed ✔︎"
}
step_nvim_setup_provider_npm() {
  section "[NVIM/NPM] Setting up NPM provider ($NPM_CONFIG_PREFIX)..."
  # https://neovim.io/doc/user/provider.html#provider-nodejs

  if ! command -v npm >/dev/null 2>&1; then
    w "[NVIM/NPM] npm is not installed! skipping..."
    return
  fi

  # Check if timeout command is available
  if ! command -v timeout >/dev/null 2>&1; then
    w "[NVIM/NPM] timeout command not available, using direct execution"
    TIMEOUT_CMD=""
  else
    TIMEOUT_CMD="timeout 300"
  fi

  # Configure the NPM environment variables
  # https://docs.npmjs.com/cli/v7/configuring-npm
  i "[NVIM/NPM] Configuring NPM environment..."
  export_env_and_make_dir "NPM_CONFIG_PREFIX" "$NPM_CONFIG_PREFIX" "NVIM/NPM" --force
  export_env_and_make_dir "NPM_CONFIG_CACHE" "$NPM_CONFIG_CACHE" "NVIM/NPM" --force
  exec_cmd export NPM_CONFIG_USERCONFIG="${NPM_CONFIG_USERCONFIG:-$XDG_CONFIG_HOME/npm/.npmrc}"
  i "[NVIM/NPM] Installing neovim package..."
  $TIMEOUT_CMD npm -g --prefix="$NPM_CONFIG_PREFIX" install neovim || {
    w "[NVIM/NPM] npm install failed or timed out, skipping NPM provider setup"
    return 1
  }
  i "[NVIM/NPM] Cleaning npm cache..."
  npm cache clean --force || w "[NVIM/NPM] npm cache clean failed, continuing..."
  i "[NVIM/NPM] NPM provider setup completed"
}
step_nvim_setup_provider_python() {
  section "[NVIM/PYTHON] Setting up Python provider ($XDG_CONFIG_HOME/nvim/.venv)..."
  # https://neovim.io/doc/user/provider.html#provider-python

  if ! command -v python3 >/dev/null 2>&1; then
    w "[NVIM/PYTHON] python3 is not installed! skipping..."
    return
  fi

  # Check if timeout command is available
  if ! command -v timeout >/dev/null 2>&1; then
    w "[NVIM/PYTHON] timeout command not available, using direct execution"
    TIMEOUT_CMD=""
  else
    TIMEOUT_CMD="timeout 300"
  fi

  setup_dir "$XDG_CACHE_HOME/pip" "NVIM/PYTHON"

  if [ ! -d "$XDG_CONFIG_HOME/nvim/.venv" ]; then
    exec_cmd cd "$XDG_CONFIG_HOME/nvim" && python3 -m venv "$XDG_CONFIG_HOME/nvim/.venv"
  fi

  # Install Python packages for neovim
  # Use a more robust approach with proper error handling
  if [ -d "$XDG_CONFIG_HOME/nvim/.venv" ]; then
    i "[NVIM/PYTHON] Virtual environment found, activating..."
    cd "$XDG_CONFIG_HOME/nvim" || return 1
    source "$XDG_CONFIG_HOME/nvim/.venv/bin/activate" || return 1

    # Use pip with explicit cache directory to avoid permission issues
    # Add timeout to prevent hanging
    i "[NVIM/PYTHON] Installing pynvim and neovim packages..."
    $TIMEOUT_CMD pip install --cache-dir "$XDG_CACHE_HOME/pip" pynvim neovim || {
      w "[NVIM/PYTHON] pip install failed, skipping Python provider setup"
      return 1
    }
    i "[NVIM/PYTHON] Python packages installed successfully"
  else
    w "[NVIM/PYTHON] Virtual environment not found at '$XDG_CONFIG_HOME/nvim/.venv'"
  fi
}
step_nvim_setup_provider_ruby() {
  section "[NVIM/RUBY] Setting up Ruby provider (${GEM_HOME:-${HOMEBREW_OPT:-$XDG_DATA_HOME}/gems})..."
  # https://neovim.io/doc/user/provider.html#provider-ruby

  if ! command -v gem >/dev/null 2>&1; then
    w "[NVIM/RUBY] gem is not installed! skipping..."
    return
  fi

  # Check if timeout command is available
  if ! command -v timeout >/dev/null 2>&1; then
    w "[NVIM/RUBY] timeout command not available, using direct execution"
    TIMEOUT_CMD=""
  else
    TIMEOUT_CMD="timeout 300"
  fi

  # Configure the gem home directory
  # https://guides.rubygems.org/command-reference/#gem-environment
  i "[NVIM/RUBY] Configuring Ruby environment..."
  export_env_and_make_dir "GEM_HOME" "${GEM_HOME:-${HOMEBREW_OPT:-$XDG_DATA_HOME}/gems}" "NVIM/RUBY"

  # Update the RubyGems system
  i "[NVIM/RUBY] Updating RubyGems system..."
  $TIMEOUT_CMD gem update --system --no-document || {
    w "[NVIM/RUBY] gem update failed or timed out, continuing with installation"
  }

  # Install neovim's required Ruby packages
  i "[NVIM/RUBY] Installing neovim gem..."
  if $TIMEOUT_CMD gem install neovim; then
    gem cleanup
  else
    w "[NVIM/RUBY] gem install failed or timed out, skipping Ruby provider setup"
    return 1
  fi
  i "[NVIM/RUBY] Ruby provider setup completed"
}
step_nvim() {
  section "[NVIM] Setup started..."

  # Check if nvim is installed
  if [ ! -x "$MISE_DATA_HOME/shims/nvim" ]; then
    w "[NVIM] nvim is not installed at '$MISE_DATA_HOME/shims/nvim'! skipping..."
    return
  fi

  # Check if nvim config directory exists
  if [ ! -d "$XDG_CONFIG_HOME/nvim" ]; then
    w "[NVIM] nvim is not installed at '$XDG_CONFIG_HOME/nvim'! skipping..."
    return
  fi

  # Create nvim's required directories
  setup_dir "$XDG_STATE_HOME/nvim" "NVIM"
  setup_dir "$XDG_DATA_HOME/nvim" "NVIM"

  # Setup nvim providers sequentially
  # This is more reliable than background processing in container environments
  i "[NVIM] Setting up NPM provider..."
  step_nvim_setup_provider_npm || w "[NVIM] NPM provider setup failed, continuing..."

  i "[NVIM] Setting up Python provider..."
  step_nvim_setup_provider_python || w "[NVIM] Python provider setup failed, continuing..."

  i "[NVIM] Setting up Ruby provider..."
  step_nvim_setup_provider_ruby || w "[NVIM] Ruby provider setup failed, continuing..."

  # Install nvim plugins
  i "[NVIM] Installing plugins..."
  # Check if timeout command is available
  if ! command -v timeout >/dev/null 2>&1; then
    w "[NVIM] timeout command not available, using direct execution"
    TIMEOUT_CMD=""
  else
    TIMEOUT_CMD="timeout 600" # 10 minutes for plugin installation
  fi

  $TIMEOUT_CMD bash -c "cd '$XDG_CONFIG_HOME/nvim' && '$MISE_DATA_HOME/shims/nvim' --headless +Lazy! sync +TSUpdateSync +MasonToolsUpdateSync +qa" || {
    w "[NVIM] Plugin installation failed or timed out, continuing..."
  }

  s "[NVIM] Setup completed ✔︎"
}
main() {
  step_setup_environment "$@"
  w "[INSTALL] Starting 🚀"
  step_prepare
  step_cleanup
  step_backup
  step_dotfiles
  step_ensure_ownership
  step_mise
  step_zsh
  step_nvim
  step_ensure_ownership --zsh
  s "[INSTALL] DONE ✔︎✔︎"
}

main "$@"
