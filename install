#!/usr/bin/env bash
set -eu

# Constants
# REPO_URL="https://github.com/roalcantara/dots"
# DOTS_DIR="$XDG_DATA_HOME/dots"
# BACKUP_DIR_ROOT="$HOME/.backup"

# # Configuration
# export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
# export XDG_LOCAL_DIR="${XDG_LOCAL_DIR:-$HOME/.local}"
# export XDG_DATA_HOME="${XDG_DATA_HOME:-$XDG_LOCAL_DIR/share}"
# export XDG_STATE_HOME="${XDG_STATE_HOME:-$XDG_LOCAL_DIR/state}"
# XDG_DIRS=("$XDG_CACHE_HOME" "$XDG_LOCAL_DIR" "$XDG_DATA_HOME" "$XDG_STATE_HOME")
# BACKUP_RESOURCES=".bashrc .bash_logout .bash_profile .profile .zshrc .zprofile .gitconfig .ssh/config .ssh/id_rsa .ssh/id_rsa.pub"
# BACKUP_DIR=""
# NON_INTERACTIVE=1
# DRY_RUN=0
# VERBOSE=0

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly PURPLE='\033[0;35m'
readonly NC='\033[0m'

# CONSTANTS
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
XDG_LOCAL_DIR=${XDG_LOCAL_DIR:-$HOME/.local}
XDG_DATA_HOME=${XDG_DATA_HOME:-$XDG_LOCAL_DIR/share}
XDG_STATE_HOME=${XDG_STATE_HOME:-$XDG_LOCAL_DIR/state}
ZDOTDIR=${ZDOTDIR:-$XDG_CONFIG_HOME/zsh}
ZSH_CACHE_DIR=${ZSH_CACHE_DIR:-$XDG_CACHE_HOME/zsh}
ZSH_COMPCACHE=${ZSH_COMPCACHE:-$ZSH_CACHE_DIR/compcache}
ZSH_COMPDUMP=${ZSH_COMPDUMP:-$ZSH_COMPCACHE/.zcompdump}
MISE_DATA_HOME=$XDG_DATA_HOME/mise

# Global variables for flags (no associative arrays needed)
FLAG_prepare="true"
FLAG_cleanup="true"
FLAG_backup="true"
FLAG_dotfiles="true"
FLAG_xdg="true"
FLAG_mise="true"
FLAG_zsh="true"
FLAG_nvim="true"
FLAG_chown="true"
FLAG_verbose="false"
FLAG_debug="false"
VALUE_timezone="UTC"
VALUE_username="vscode"
VALUE_groupname="vscode"
VALUE_repo_url="https://github.com/roalcantara/dots"
VALUE_dots_dir="$XDG_DATA_HOME/dots"
VALUE_backup_dir_root="$HOME/.backup"
VALUE_backup_resources=".bashrc .bash_logout .bash_profile .profile .zshrc .zprofile .gitconfig .ssh/config .ssh/id_rsa .ssh/id_rsa.pub"
VALUE_usr_local_bin="/usr/local/bin"
VALUE_xdg_zsh_setup_script="$ZDOTDIR/etc/functions/zsetup"

# Extract arguments from --args= format
extract_args_value() {
  input="$1"
  # Remove --args= prefix
  input="${input#--args=}"
  # Remove surrounding quotes
  input="${input#\'}"
  input="${input%\'}"
  input="${input#\"}"
  input="${input%\"}"
  echo "$input"
}
# Parse a single argument
parse_single_arg() {
  arg="$1"

  case "$arg" in
  --prepare) FLAG_prepare="true" ;;
  --cleanup) FLAG_cleanup="true" ;;
  --backup) FLAG_backup="true" ;;
  --dotfiles) FLAG_dotfiles="true" ;;
  --xdg) FLAG_xdg="true" ;;
  --mise) FLAG_mise="true" ;;
  --zsh) FLAG_zsh="true" ;;
  --nvim) FLAG_nvim="true" ;;
  --chown) FLAG_chown="true" ;;
  --verbose) FLAG_verbose="true" ;;
  --debug) FLAG_debug="true" ;;
  --timezone=*) VALUE_timezone="${arg#--timezone=}" ;;
  --username=*) VALUE_username="${arg#--username=}" ;;
  --groupname=*) VALUE_groupname="${arg#--groupname=}" ;;
  *)
    if [ "$FLAG_verbose" = "true" ]; then
      echo "Unknown argument: $arg" >&2
    fi
    ;;
  esac
}
# Parse arguments
parse_arguments() {
  # Check for --args= format first
  for arg in "$@"; do
    case "$arg" in
    --args=*)
      # Extract the arguments string
      args_string="$(extract_args_value "$arg")"

      # Parse each argument in the string
      # Simple word splitting (be careful with spaces in values)
      IFS=' '
      set -- $args_string
      for sub_arg in "$@"; do
        parse_single_arg "$sub_arg"
      done
      return
      ;;
    esac
  done

  # If no --args= found, parse direct arguments
  for arg in "$@"; do
    parse_single_arg "$arg"
  done
}

# Display parsed arguments
show_arguments() {
  echo "Arguments:"

  [ "$FLAG_prepare" = "true" ] && echo "  ✅ --prepare"
  [ "$FLAG_cleanup" = "true" ] && echo "  ✅ --cleanup"
  [ "$FLAG_backup" = "true" ] && echo "  ✅ --backup"
  [ "$FLAG_dotfiles" = "true" ] && echo "  ✅ --dotfiles"
  [ "$FLAG_xdg" = "true" ] && echo "  ✅ --xdg"
  [ "$FLAG_mise" = "true" ] && echo "  ✅ --mise"
  [ "$FLAG_zsh" = "true" ] && echo "  ✅ --zsh"
  [ "$FLAG_nvim" = "true" ] && echo "  ✅ --nvim"
  [ "$FLAG_chown" = "true" ] && echo "  ✅ --chown"
  [ "$FLAG_verbose" = "true" ] && echo "  ✅ --verbose"
  [ "$FLAG_debug" = "true" ] && echo "  ✅ --debug"
  [ -n "$VALUE_timezone" ] && echo "  📝 --timezone = '$VALUE_timezone'"
  [ -n "$VALUE_username" ] && echo "  📝 --username = '$VALUE_username'"
  [ -n "$VALUE_groupname" ] && echo "  📝 --groupname = '$VALUE_groupname'"
  [ -n "$VALUE_repo_url" ] && echo "  📝 --repo_url = '$VALUE_repo_url'"
  [ -n "$VALUE_dots_dir" ] && echo "  📝 --dots_dir = '$VALUE_dots_dir'"
  [ -n "$VALUE_backup_dir_root" ] && echo "  📝 --backup_dir_root = '$VALUE_backup_dir_root'"
  [ -n "$VALUE_backup_resources" ] && echo "  📝 --backup_resources = '$VALUE_backup_resources'"
  [ -n "$VALUE_usr_local_bin" ] && echo "  📝 --usr_local_bin = '$VALUE_usr_local_bin'"
  [ -n "$VALUE_xdg_zsh_setup_script" ] && echo "  📝 --xdg_zsh_setup_script = '$VALUE_xdg_zsh_setup_script'"
  echo
}
# Helper function to check if flag is enabled
is_enabled() {
  flag_name="$1"
  eval "[ \"\$FLAG_$flag_name\" = \"true\" ]"
}
# Helper function to get value
get_value() {
  value_name="$1"
  default="${2:-}"
  eval "echo \"\${VALUE_$value_name:-$default}\""
}
# Check if running in a container
is_container() {
  # Check environment variables, container-specific files, and cgroups
  if [ -n "${DOCKER_CONTAINER:-}" ] || [ -n "${container:-}" ] ||
    [ -f "/.dockerenv" ] || [ -f "/var/run/docker.sock" ] || [ -f "/run/.containerenv" ] ||
    ([ -f "/proc/1/cgroup" ] && (grep -q "docker" "/proc/1/cgroup" || grep -q '^0::/$' /proc/1/cgroup)); then
    echo "Running in container environment"
    return 0
  else
    echo "Not running in container environment"
    return 1
  fi
}
# Detect OS and architecture
detect_platform() {
  OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
  ARCH="$(uname -m)"

  # Translate architecture names
  if [ "$ARCH" = "x86_64" ]; then
    ARCH="amd64"
  elif [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
    ARCH="arm64"
  fi

  # Set environment type based on container detection
  if is_container; then
    ENV="container"
  else
    ENV="host"
  fi

  CONTEXT="$OS/$ARCH/$ENV"
  echo "Detected platform: '$CONTEXT' ✔︎"
}
# Logging functions
puts() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] ($CONTEXT) [$1] $2"; }
i() { puts "${BLUE}[INFO]${NC} $*"; }
e() { puts "${RED}[ERROR]${NC} $*" >&2; }
w() { puts "${YELLOW}[WARN]${NC} $*"; }
d() { puts "${PURPLE}[DEBUG]${NC} $*"; }
s() { puts "${GREEN}[SUCCESS]${NC} $*"; }

# Create directory/directories with specific owner and group
# Examples:
#  mkown "username" "groupname" "/path/to/dir3"
#  mkown "username" "groupname" "/path/to/dir1" "/path/to/dir2"
#  mkown --recursive "username" "groupname" "/path/to/dir1"
#  mkown -R "username" "groupname" "/path/to/dir1"
mkown() {
  if [ $# -lt 3 ]; then
    e "Usage: mkown [--recursive|-R] <owner> <group> <dir1> [dir2] [dir3] ..."
    return 1
  fi

  recursive=false

  # Check for recursive flag
  case "$1" in
  --recursive | -R)
    recursive=true
    shift
    ;;
  esac

  owner="$1"
  group="$2"
  shift 2

  # Process each directory argument
  for dir in "$@"; do
    if [ -d "$dir" ]; then
      d "Directory '$dir' already exists, skipping creation."
    else
      exec_cmd sudo mkdir -p "$dir"
      i "Created directory '$dir' ✔︎"
    fi

    if [ "$recursive" = "true" ]; then
      exec_cmd sudo chown -R "$owner:$group" "$dir"
      i "Set ownership of '$dir' (recursively) to '$owner:$group' ✔︎"
    else
      exec_cmd sudo chown "$owner:$group" "$dir"
      i "Set ownership of '$dir' to '$owner:$group' ✔︎"
    fi
  done
}
# Print a section header
section() {
  echo "===================================================="
  echo "$1"
  echo "===================================================="
}
# Execute a command
exec_cmd() {
  w "Executing: $*"
  "$@"
  return $?
}
# Check if a command exists
has_command() {
  command -v "$1" >/dev/null 2>&1
}

# Main function
main() {
  # Detect platform and set context
  detect_platform

  w "[INSTALL] ($CONTEXT) Starting 🚀"

  # Parse command line arguments
  parse_arguments "$@"

  # Show what was parsed
  show_arguments

  # Define common variables
  LOCALGROUP=$(id -gn 2>/dev/null)
  LOCALUSER=$(id -un 2>/dev/null)
  USERNAME="$(get_value "username" "${USER:-${LOCALUSER:-vscode}}")"
  GROUPNAME="$(get_value "groupname" "${GROUP:-${LOCALGROUP:-vscode}}}")"
  REPO_URL="$(get_value "repo_url" "$VALUE_repo_url")"
  DOTS_DIR="$(get_value "dots_dir" "$VALUE_dots_dir")"
  BACKUP_DIR_ROOT="$(get_value "backup_dir_root" "$VALUE_backup_dir_root")"
  USR_LOCAL_BIN="$(get_value "usr_local_bin" "$VALUE_usr_local_bin")"
  XDG_ZSH_SETUP_SCRIPT="$(get_value "xdg_zsh_setup_script" "$VALUE_xdg_zsh_setup_script")"
  BACKUP_DIR=''

  # Example of conditional execution
  if is_enabled "prepare"; then
    section "[PREP] Setting up essential dependencies..."

    # Detect platform and setup accordingly
    if has_command apt; then
      # https://guides.rubyonrails.org/development_dependencies_install.html#ubuntu
      exec_cmd apt-get update &&
        apt-get install -y --no-install-recommends sudo build-essential libssl-dev libffi-dev libyaml-dev libxml2-dev cowsay fortune fortunes fortunes-min &&
        sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/* &&
        sudo ln -sf /usr/games/cowsay $USR_LOCAL_BIN/cowsay && sudo ln -sf /usr/games/fortune $USR_LOCAL_BIN/fortune

      TZ="$(get_value "timezone" "${TZ:-'UTC'}")"
      if [ -n "$TZ" ]; then
        ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" >/etc/timezone
        i "[PREP] Timezone '$TZ' symlinked to /etc/localtime and added to /etc/timezone ✔︎"
      fi
      w "[PREP] (UBUNTU/DEBIAN) Using apt ✔︎"
    else
      e "Unsupported platform!"
      return 1
    fi

    s "[PREP] Completed ✔︎"
  fi

  if is_enabled "cleanup"; then
    section "[CLEAN] Initializing..."

    for e in "$HOME" /root; do
      for f in "$e/.bashrc" "$e/.bash_logout" "$e/.oh-my-zsh" "$e/.profile"; do
        if [ -e "$f" ]; then
          exec_cmd sudo rm -rf "$f"
          w "[CLEAN] '$f' removed ✔︎"
        fi
      done
    done
    s "[CLEAN] Completed (oh-my-zsh removed) ✔︎"
  fi

  if is_enabled "backup"; then
    section "[BAK] Initializing.."

    # Create backup directory with current timestamp
    BACKUP_DIR="$BACKUP_DIR_ROOT/$(date +%Y-%m-%d_%H-%M-%S)"
    exec_cmd sudo mkdir -p "$BACKUP_DIR"
    exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$BACKUP_DIR_ROOT"
    i "[BAK] Backup folder created at '$BACKUP_DIR' ("$USERNAME:$GROUPNAME") ✔"

    # Backup existing files
    for resource in $BACKUP_RESOURCES; do
      resource_path="$HOME/$resource"
      if [ -e "$resource_path" ]; then
        if [ -L "$resource_path" ]; then
          d "Backing up symlink: $resource_path"
        elif [ -d "$resource_path" ]; then
          d "Backing up directory: $resource_path"
        else
          d "Backing up file: $resource_path"
        fi

        exec_cmd sudo mv "$resource_path" "$BACKUP_DIR/"
        i "Backed up: $resource_path ✔"

        # If it was an XDG directory, recreate it with proper ownership
        exec_cmd sudo install -d -o "$USERNAME" -g "$USERNAME" "$resource_path"
        i "Recreated directory: $resource_path owned by $USERNAME:$GROUPNAME ✔"
      else
        d "Resource does not exist, skipping: $resource_path"
      fi
    done

    s "[BAK] Completed @ '$BACKUP_DIR@$USERNAME:$GROUPNAME' ✔"
  fi

  if is_enabled "dotfiles"; then
    section "[DOTS] Setup started.."

    # Ensure parent directory exists
    dots_parent_dir="$(dirname "$DOTS_DIR")"
    if [ ! -d "$dots_parent_dir" ]; then
      exec_cmd sudo mkdir -p "$dots_parent_dir"
      d "[DOTS] Created Dotfiles parent directory: '$dots_parent_dir'"
    fi
    exec_cmd sudo chown "$USERNAME:$GROUPNAME" "$dots_parent_dir"
    d "[DOTS] Dotfiles parent directory '$dots_parent_dir' is owned by '$USERNAME:$GROUPNAME' ✔"

    # Clone or update repository
    if [ -d "$DOTS_DIR/.git" ]; then
      i "[DOTS] Git repository already exists at '$DOTS_DIR'. Pulling latest changes..."
      if ! exec_cmd git -C "$DOTS_DIR" pull origin main; then
        e "[DOTS] Failed to update repository"
      fi
    else
      i "[DOTS] Cloning from $REPO_URL into '$DOTS_DIR'..."
      if ! exec_cmd sudo git clone --depth 1 "$REPO_URL" "$DOTS_DIR"; then
        e "[DOTS] Failed to clone repository"
      fi
      i "[DOTS] Dotfiles downloaded to '$DOTS_DIR' ✔"
    fi

    # Handle .config symlink
    config_symlink="$HOME/.config"
    if [ -e "$config_symlink" ]; then
      if [ -L "$config_symlink" ]; then
        current_target="$(readlink "$config_symlink")"
        if [ "$current_target" != "$DOTS_DIR/config" ]; then
          d "[DOTS] Backing up existing .config symlink to '$BACKUP_DIR'.."
          exec_cmd mv "$config_symlink" "$BACKUP_DIR/"
        fi
      else
        d "[DOTS] Backing up existing .config directory to '$BACKUP_DIR'.."
        exec_cmd mv "$config_symlink" "$BACKUP_DIR/"
      fi
    fi

    if [ ! -L "$config_symlink" ] && [ -d "$DOTS_DIR/config" ]; then
      i "[DOTS] Symlinking '$DOTS_DIR/config' to '$config_symlink'.."
      exec_cmd sudo ln -sf "$DOTS_DIR/config" "$config_symlink"
      d "[DOTS] Symlink created: '$config_symlink' -> '$DOTS_DIR/config' ✔"
    fi

    # mkown --no-mkdir -R "$USERNAME:$GROUPNAME" "$config_symlink"
    i "[DOTS] Ensuring correct permissions for '$config_symlink' symlink.."
    exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$config_symlink"
    i "[DOTS] '$config_symlink' is owned by '$USERNAME:$GROUPNAME' ✔"

    # mkown --no-mkdir -R "$USERNAME:$GROUPNAME" "$config_symlink"/*
    for dir in "$config_symlink"/*; do
      exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$dir"
      d "[DOTS] '$dir' is owned by '$USERNAME:$GROUPNAME' ✔"
    done

    s "[DOTS] Setup completed ✔"
  fi

  if is_enabled "xdg"; then
    if [ -x "$XDG_ZSH_SETUP_SCRIPT" ]; then
      section "[XDG] Setting up XDG/ZSH environment via '$XDG_ZSH_SETUP_SCRIPT'..."
      USERNAME="$USERNAME" GROUPNAME="$GROUPNAME" . "$XDG_ZSH_SETUP_SCRIPT"
      s "[XDG] Setting up XDG/ZSH environment for '$USERNAME:$GROUPNAME' via '$XDG_ZSH_SETUP_SCRIPT' ✔"
    fi
  fi

  if is_enabled "mise"; then
    section "[MISE] Setup started..."

    if [ -z "${GITHUB_TOKEN:-}" ]; then
      w "[MISE] GITHUB_TOKEN not set, looking up for token..."

      GITHUB_TOKEN=""
      for location in /tmp/github_token /run/secrets/github_token $HOME/.github_token $HOME/.secrets/github_token; do
        if [ -f "$location" ]; then
          export GITHUB_TOKEN="$(cat "$location")"
          w "[MISE] GITHUB_TOKEN loaded from '$location' ✔︎"
          break
        fi
      done

      if [ -z "${GITHUB_TOKEN:-}" ]; then
        w "[MISE] No GitHub token found - API rate limits may apply"
      fi
    fi

    # Check if mise is installed
    if ! has_command "mise"; then
      w "[MISE] mise is not found! Installing..."
      MISE_INSTALL_PATH="$USR_LOCAL_BIN/mise"
      if has_command "curl"; then
        curl https://mise.run | sudo MISE_INSTALL_PATH=$MISE_INSTALL_PATH sh
      elif has_command "wget"; then
        wget -qO- https://mise.run | sudo MISE_INSTALL_PATH=$MISE_INSTALL_PATH sh
      else
        e "[MISE] Neither curl nor wget is installed. Please install one of them to proceed."
        return 1
      fi
      i "[MISE] mise installed successfully system-wide at '$MISE_INSTALL_PATH' ✔︎"

      # Make sure it's executable
      sudo chmod +x $MISE_INSTALL_PATH
      w "[MISE] Now '$MISE_INSTALL_PATH' is executable! ✔︎"
    fi

    # mkwon -R "$USERNAME:$GROUPNAME" "$MISE_DATA_HOME" "$XDG_STATE_HOME/mise"
    i "[MISE] Setting up global configuration..."
    exec_cmd sudo mkdir -p "$MISE_DATA_HOME" "$XDG_STATE_HOME/mise"
    exec_cmd sudo chown -R "$USERNAME:$GROUPNAME" "$MISE_DATA_HOME" "$XDG_STATE_HOME/mise"
    i "[MISE] '$HOME/.local/(share|state)/mise' created and owned by '$USERNAME' ✔︎"

    # Set global configuration paths
    exec_cmd export MISE_GLOBAL_CONFIG_DIR="$MISE_DATA_HOME"
    exec_cmd export MISE_GLOBAL_CONFIG_FILE="$MISE_DATA_HOME/config.toml"
    i "[MISE] MISE_GLOBAL_CONFIG_FILE set to $MISE_DATA_HOME/config.toml (owned by '$USERNAME') ✔︎"

    # Create mise config directory if it doesn't exist
    exec_cmd mise settings set global_config_file "$MISE_DATA_HOME/config.toml"
    exec_cmd mise settings add trusted_config_paths "$MISE_DATA_HOME"
    exec_cmd mise settings add trusted_config_paths "$XDG_DATA_HOME/dots"
    exec_cmd mise settings set activate_aggressive true
    exec_cmd mise settings set auto_install true
    i "[MISE] mise global configuration set to '$MISE_DATA_HOME/config.toml' ✔︎"

    # Set mise to use global packages
    i "[MISE] Setting mise packages to be used globally..."
    exec_cmd mise use --cd "$DOTS_DIR" --yes --global --pin ripgrep age bat delta eza fd fzf gh neovim sops starship usage watchexec zoxide gum node python ruby
    w "[MISE] Mise packages being used globally ✔︎"

    # cleanup GitHub token
    if [ -n "${GITHUB_TOKEN:-}" ]; then
      exec_cmd unset GITHUB_TOKEN
      w "[MISE] GitHub token removed from environment"
    fi

    s "[MISE] Setup completed ✔︎"
  fi

  if is_enabled "zsh"; then
    section "[ZSH] Setup started..."

    # Create the ~/.cache/zsh/compcache directory if it doesn't exist
    if [ ! -d "$ZSH_COMPCACHE" ]; then
      mkdir -p "$ZSH_COMPCACHE"
      sudo chown -R "$USERNAME:$GROUPNAME" "$ZSH_COMPCACHE"
      i "[ZSH] $ZSH_COMPCACHE created and owned by '$USERNAME' ✔︎"
    fi

    # Create symlinks for the ZSH config files
    for file in .zshenv .zprofile .zshrc; do
      if [ -f "$ZDOTDIR/$file" ] && [ ! -L "$HOME/$file" ]; then
        ln -sf "$ZDOTDIR/$file" "$HOME/$file"
        sudo chown -R "$USERNAME:$GROUPNAME" "$HOME/$file"
        i "[ZSH] $ZDOTDIR/$file symlinked to $HOME/$file owned by '$USERNAME' ✔︎"
      fi
    done

    if [ ! -d "$XDG_STATE_HOME/zim" ]; then
      sudo mkdir -p "$XDG_STATE_HOME/zim"
      sudo chown -R "$USERNAME:$GROUPNAME" "$XDG_STATE_HOME/zim"
      i "[ZSH] $XDG_STATE_HOME/zim created and owned by '$USERNAME' ✔︎"
    fi

    s "[ZSH] Setup completed ✔︎"
  fi

  if is_enabled "nvim"; then
    section "[NVIM] Setup started..."

    # Create necessary directories for nvim and npm
    sudo mkdir -p "$XDG_STATE_HOME/nvim" "$XDG_DATA_HOME/nvim" "$XDG_STATE_HOME/npm"
    sudo chown -R "$USERNAME:$GROUPNAME" "$XDG_STATE_HOME/nvim" "$XDG_DATA_HOME/nvim" "$XDG_STATE_HOME/npm"
    i "[NVIM] '$XDG_STATE_HOME/npm' & '$XDG_LOCAL_DIR/(state|share)/nvim' created and owned by '$USERNAME' ✔︎"

    export npm_config_cache="$XDG_STATE_HOME/npm"
    i "[NVIM] npm_config_cache exported to '$npm_config_cache' (owned by '$USERNAME') ✔︎"

    # Check if nvim is installed
    if [ ! -x "$MISE_DATA_HOME/shims/nvim" ]; then
      w "[NVIM] nvim is not installed at '$MISE_DATA_HOME/shims/nvim'! skipping..."
      return
    fi

    if [ -d "$HOME/.config/nvim" ]; then
      cd "$HOME/.config/nvim" &&
        "$MISE_DATA_HOME/shims/nvim" --headless +verbose \
          +'Lazy! sync' \
          +'Lazy! clean' \
          +'Lazy! clear' \
          +'TSUpdateSync' \
          -c 'lua require("lazy").load({plugins = {"mason-lspconfig.nvim"}})' \
          -c 'MasonInstall ast-grep bash-language-server css-lsp diagnostic-languageserver docker-compose-language-service dockerfile-language-server eslint-lsp html-lsp json-lsp lua-language-server marksman neocmakelsp prettier pyright ruby-lsp shfmt stylua taplo vim-language-server vtsls yaml-language-server' +qa
    fi

    s "[NVIM] Setup completed ✔︎"
  fi

  if is_enabled "chown"; then
    section "[CHOWN] Ensuring ownership of essential directories started..."

    for dir in ".local" ".local/share"; do
      if [ -d "$HOME/$dir" ]; then
        sudo chown "$USERNAME:$GROUPNAME" "$HOME/$dir"
        i "[CHOWN] '$HOME/$dir' are owned by '$USERNAME:$GROUPNAME' ✔︎"
      else
        w "[CHOWN] '$HOME/$dir' does not exist. Skipping.. ✔︎"
      fi
    done

    for dir in ".cache" ".local/state" ".local/share/mise" ".local/share/nvim"; do
      if [ -d "$HOME/$dir" ]; then
        sudo chown -R "$USERNAME:$GROUPNAME" "$HOME/$dir"
        i "[CHOWN] '$HOME/$dir' are owned (recursively) by '$USERNAME:$GROUPNAME' ✔︎"
      else
        w "[CHOWN] '$HOME/$dir' does not exist. Skipping.. ✔︎"
      fi
    done

    s "[CHOWN] Completed ✔︎"
  fi

  echo
  s "[INSTALL] ($CONTEXT) DONE ✅"
}

# Run main function
main "$@"
