#!/usr/bin/env bash
# USAGE: install [-u username] [-g groupname] [-t timezone] [-p flox|mise] [-r repo] [-b branch]
# EXAMPLES:
#   ./install
#   ./install -u "vscode" -g "vscode"
#   ./install -u "vscode" -g "vscode" -t "America/Sao_Paulo" -p "flox" -r "https://github.com/roalcantara/dots" -b "main"
set -eu

# GLOBALS and CONSTANTS
declare -g -A COLORS=([E]='\033[0;31m' [F]='\033[0;31m' [S]='\033[0;32m' [W]='\033[1;33m' [I]='\033[0;34m' [MAGENTA]='\033[0;35m' [NC]='\033[0m')
declare -g USERNAME="roalcantara" GROUPNAME="staff" TIMEZONE="America/Sao_Paulo" REPO_URL="https://github.com/roalcantara/dots" BRANCH="main" USR_LOCAL_BIN="/usr/local/bin" PACKAGE_MANAGER="flox" FLOX_VERSION="1.7.2" CONFIGS_TO_BACKUP=".bashrc .bash_logout .bash_profile .profile .zshrc .zprofile .gitconfig .oh-my-zsh"
declare -g UNAME ARCH PLATFORM_ARCH DISTRO ENV CONTEXT HOME DOTS_SRC_DIR FLOX_PATH BACKUP_DIR
declare -g -A PACKAGES=(
  [mise]="node@22.17 python ripgrep bat delta eza fd fzf starship zoxide gum pre-commit tree-sitter neovim age sops"
  [flox]="nodejs python313Full ripgrep bat delta eza fd fzf starship zoxide gum pre-commit tree-sitter gitlint ruby neovim age sops"
  [apt]="sudo xclip xsel git zsh curl"
)

# UTILITIES functions
log() {
  echo -e "${COLORS[MAGENTA]} ==> [$(date '+%Y-%m-%d %H:%M:%S')]${COLORS[NC]} ${COLORS[$1]}[$1]${CONTEXT:+ ($CONTEXT)}${COLORS[NC]} ${*:2}"
}
info() { log "I" "$@"; }
warn() { log "W" "$@"; }
error() { log "E" "$@" >&2; }
fatal() { log "F" "$@" >&2; exit 1; }
success() { log "S" "$@"; }
ok() {
  log "S" "${COLORS[I]}==> |$1| [$(printf '%20s' "$2")] ==> READY ${4:-✔✔}${COLORS[NC]} ${3:-''}"
}
has_cmd() {
  command -v "$1" >/dev/null 2>&1
}
is_container() {
  if [ -n "${DOCKER_CONTAINER:-}" ] || [ -n "${container:-}" ] ||
    [ -f "/.dockerenv" ] || [ -f "/var/run/docker.sock" ] || [ -f "/run/.containerenv" ] ||
    ([ -f "/proc/1/cgroup" ] && (grep -q "docker" "/proc/1/cgroup" || grep -q '^0::/$' /proc/1/cgroup)); then
    return 0
  fi
  return 1
}
run_cmd() {
  info "Running: $*"; "$@"
}
ensure_dir() {
  [ -d "$1" ] || run_cmd mkdir -p "$1"
}
ensure_dir_and_export_var() {
  ensure_dir "$1"
  [ -n "$2" ] && export "$2"="$1"
}
ensure_dirs_and_export_vars() {
  for dir_var in "$@"; do
    ensure_dir_and_export_var "${dir_var%%:*}" "${dir_var##*:}";
  done
}
backup() {
  local target="$1" source="${2:-''}"
  if [ -e "$target" ]; then
    if is_container; then
      run_cmd rm -rf "$target"
    else
      run_cmd mv "$target" "${BACKUP_DIR:?}/"
    fi
  fi

  if [ -n "$source" ] && [ -e "$source" ]; then
    run_cmd ln -sf "$source" "$target"
  fi
}
group_exists() { [ "$UNAME" = "darwin" ] && dscl . -read /Groups/"$1" &>/dev/null || getent group "$1" &>/dev/null; }
user_exists() { id "$1" &>/dev/null; }
show_usage() {
  echo "Usage: $0 [options]" >&2
  echo "Options:" >&2
  echo "  -u, --username USER     Set username" >&2
  echo "  -g, --groupname GROUP   Set group name" >&2
  echo "  -t, --timezone TZ       Set timezone" >&2
  echo "  -p, --package-manager   Package manager (flox|mise)" >&2
  echo "  -r, --repo URL          Repository URL" >&2
  echo "  -b, --branch BRANCH     Git branch" >&2
}
get_github_token() {
  [ -n "${GITHUB_TOKEN:-}" ] && info "GitHub token READY! ✔" && return
  for location in /run/secrets/github_token /tmp/github_token "$HOME/.github_token" "$HOME/.secrets/github_token"; do
    if [ -f "$location" ]; then
      export GITHUB_TOKEN="$(cat "$location")"
      info "GitHub token loading READY => '$location' ✔"
      return
    fi
  done
  warn "No GitHub token found - API rate limits may apply..."
}
backup_home() {
  BACKUP_DIR=$HOME/.local/share/backup/$(date +%Y%m%d_%H%M%S)
  local ROOT_DIRS_TO_BACKUP=("$HOME" "/root")
  if ! is_container; then
    ROOT_DIRS_TO_BACKUP=("$HOME")
    ensure_dir "$BACKUP_DIR"
  fi
  for e in "${ROOT_DIRS_TO_BACKUP[@]}"; do
    for f in $CONFIGS_TO_BACKUP; do
      backup "${e:?}/$f"
    done
    ok "$1" "BAK$e" "{$CONFIGS_TO_BACKUP}" "✔"
  done
}
download_file() {
  local url="$1" output="$2"
  if [ "$output" = "-" ]; then
    # Stream to stdout if output is "-" (Unix convention)
    if has_cmd curl; then
      run_cmd curl -L "$url"
    elif has_cmd wget; then
      run_cmd wget -O- "$url"
    else
      fatal "No suitable download tool available or download failed"
    fi
  else
    # Download to file
    if has_cmd curl; then
      run_cmd curl -L "$url" -o "$output"
    elif has_cmd wget; then
      run_cmd wget "$url" -O "$output"
    else
      fatal "No suitable download tool available or download failed"
    fi
  fi
}
fix_flox_permissions() {
  local username="$1"

  if [ "$UNAME" != "darwin" ] && has_cmd flox; then
    info "Fixing Nix/Flox permissions for user '$username'..."

    # Fix Nix database permissions
    [ -d "/nix/var/nix" ] && run_cmd chown -R "$username:$GROUPNAME" "/nix/var/nix"

    # Fix user profile directory
    local user_profile_dir="/nix/var/nix/profiles/per-user/$username"
    [ -d "$user_profile_dir" ] || run_cmd mkdir -p "$user_profile_dir"
    run_cmd chown -R "$username:$GROUPNAME" "$user_profile_dir"

    # Fix user's flox directories
    if [ -d "/home/$username" ]; then
      run_cmd chown -R "$username:$GROUPNAME" "/home/$username"
    elif [ -d "/home/$username/.config/flox" ]; then
      run_cmd chown -R "$username:$GROUPNAME" "/home/$username/.config/flox"
    elif [ -d "/home/$username/.local/share/dots/config/flox" ]; then
      run_cmd chown -R "$username:$GROUPNAME" "/home/$username/.local/share/dots/config/flox"
    fi
  fi
}
package_manager_install_flox() {
  if [ "$UNAME" = "darwin" ]; then # curl -L https://downloads.flox.dev/by-env/stable/deb/flox-1.7.2.aarch64-darwin.pkg -o /tmp/flox.pkg && sudo installer -pkg /tmp/flox.pkg -target / && rm -f /tmp/flox.pkg && flox --version | wget https://downloads.flox.dev/by-env/stable/osx/flox-1.7.2.aarch64-darwin.pkg -O /tmp/flox.pkg && sudo installer -pkg /tmp/flox.pkg -target / && rm -f /tmp/flox.pkg && flox --version
    download_file "https://downloads.flox.dev/by-env/stable/osx/flox-${FLOX_VERSION}.${PLATFORM_ARCH}-darwin.pkg" "/tmp/flox.pkg"
    run_cmd sudo installer -pkg /tmp/flox.pkg -target / && rm -f /tmp/flox.pkg
  else # curl -L https://downloads.flox.dev/by-env/stable/deb/flox-1.7.2.aarch64-linux.deb -o /tmp/flox.deb && sudo dpkg -i /tmp/flox.deb && rm /tmp/flox.deb && flox --version | wget https://downloads.flox.dev/by-env/stable/deb/flox-1.7.2.aarch64-linux.deb -O /tmp/flox.deb && sudo dpkg -i /tmp/flox.deb && rm /tmp/flox.deb && flox --version
    download_file "https://downloads.flox.dev/by-env/stable/deb/flox-${FLOX_VERSION}.${PLATFORM_ARCH}-linux.deb" "/tmp/flox.deb"
    run_cmd sudo dpkg -i /tmp/flox.deb && rm -f /tmp/flox.deb

    # Fix permissions after installation for container use
    if [ -n "${USERNAME:-}" ] && [ "$USERNAME" != "root" ] && [ "$(id -u)" -eq 0 ]; then
      fix_flox_permissions "$USERNAME"
    fi
  fi
}
package_manager_install_mise() {
  # curl -L https://mise.run | MISE_INSTALL_PATH="/usr/local/bin/mise" sh && sudo chmod +x /usr/local/bin/mise && mise --version | wget https://mise.run -O- | MISE_INSTALL_PATH="/usr/local/bin/mise" sh && sudo chmod +x /usr/local/bin/mise && mise --version
  local install_path="$USR_LOCAL_BIN/mise"
  if [ "$(id -u)" -ne 0 ]; then # If running as non-root user, install to user directory
    install_path="$HOME/.local/bin/mise"
    mkdir -p "$(dirname "$install_path")"
  fi
  download_file "https://mise.run" "-" | MISE_INSTALL_PATH="$install_path" sh
  [ "$(id -u)" -eq 0 ] && run_cmd chmod +x "$install_path" || chmod +x "$install_path"
}
packages_install_flox() {
  # Run as root to avoid Nix permission issues, then fix ownership
  if [ "$(id -u)" -eq 0 ]; then
    # Run flox commands as root
    run_cmd flox init --name 'default' --dir "$HOME"
    run_cmd flox install --dir "$HOME" ${PACKAGES[flox]}

    # Fix ownership of created files
    run_cmd chown -R "$USERNAME:$GROUPNAME" "$HOME"
    run_cmd chown -R "$USERNAME:$GROUPNAME" "$HOME" 2>/dev/null || true
  else
    # Run normally if not root
    run_cmd flox init --name 'default' --dir "$HOME"
    run_cmd flox install --dir "$HOME" ${PACKAGES[flox]}
  fi

  run_cmd flox envs
  run_cmd flox list --dir "$HOME"
  eval "$(FLOX_SHELL=/bin/bash flox activate --dir $HOME)"
}
packages_install_mise() {
  run_cmd mise settings set global_config_file "$MISE_DATA_HOME/config.toml"
  run_cmd mise settings add trusted_config_paths "$MISE_GLOBAL_CONFIG_DIR"
  run_cmd mise settings add trusted_config_paths "$HOME/.local/share/dots"
  run_cmd mise settings set activate_aggressive true
  run_cmd mise settings set auto_install true
  run_cmd mise use --cd "$HOME/.local/share/dots" --yes --global --pin ${PACKAGES[mise]}
  run_cmd eval "$(mise activate zsh --yes --quiet --shims)"
}
ensure_user_and_group_darwin() {
  if ! user_exists "$USERNAME"; then
    local next_uid=$(dscl . -list /Users UniqueID | awk '{print $2}' | sort -n | tail -1)
    next_uid=$((next_uid + 1))
    run_cmd dscl . create /Users/"$USERNAME"
    run_cmd dscl . create /Users/"$USERNAME" UserShell /bin/zsh
    run_cmd dscl . create /Users/"$USERNAME" RealName "$USERNAME"
    run_cmd dscl . create /Users/"$USERNAME" UniqueID "$next_uid"
    run_cmd dscl . create /Users/"$USERNAME" PrimaryGroupID 20
    run_cmd dscl . create /Users/"$USERNAME" NFSHomeDirectory /Users/"$USERNAME"
    run_cmd createhomedir -c -u "$USERNAME"
    run_cmd dscl . append /Groups/admin GroupMembership "$USERNAME"
    if is_container; then
      ok "$1" "USER/GROUP" "/Users/$USERNAME passwordless created; Admin group access granted!" "✔"
    else
      run_cmd passwd "$USERNAME"
      run_cmd pwpolicy -u "$USERNAME" -setpolicy "passwordCannotBeAccountName=1,requiresAlpha=1,requiresNumeric=1,minChars=8,maxFailedLoginAttempts=5,usingHistory=5,canModifyPasswordforSelf=1,expiresEveryNDays=90"
      ok "$1" "USER/GROUP" "/Users/$USERNAME created; Forcing password change on first login!" "✔"
    fi
  fi
  if ! group_exists "$GROUPNAME"; then
    local next_gid=$(dscl . -list /Groups PrimaryGroupID | awk '{print $2}' | sort -n | tail -1)
    next_gid=$((next_gid + 1))
    run_cmd dscl . create /Groups/"$GROUPNAME"
    run_cmd dscl . create /Groups/"$GROUPNAME" PrimaryGroupID "$next_gid"
    ok "$1" "USER/GROUP" "/Groups/$GROUPNAME created; PrimaryGroupID=$next_gid!" "✔"
  fi
}
ensure_user_and_group_debian() {
  if ! group_exists "$GROUPNAME"; then
    run_cmd groupadd "$GROUPNAME";
    ok "$1" "USER/GROUP" "Group $GROUPNAME created!" "✔"
  fi
  if ! user_exists "$USERNAME"; then
    run_cmd useradd -m -s /bin/bash -G "$GROUPNAME" "$USERNAME"
    if is_container; then
      run_cmd usermod -aG sudo "$USERNAME" 2>/dev/null || run_cmd usermod -aG wheel "$USERNAME"
      run_cmd passwd -d "$USERNAME"
      echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/$USERNAME"
      run_cmd chmod 440 "/etc/sudoers.d/$USERNAME"
      ok "$1" "USER/GROUP" "User $USERNAME:$GROUPNAME passwordless created; Sudo access granted!" "✔"
    else
      run_cmd usermod -aG sudo "$USERNAME" 2>/dev/null || run_cmd usermod -aG wheel "$USERNAME"
      run_cmd passwd "$USERNAME"
      run_cmd chage -d 0 "$USERNAME"
      ok "$1" "USER/GROUP" "User $USERNAME:$GROUPNAME created; Forcing password change on first login!" "✔"
    fi
  fi
}
run_as_user() {
  local username="$1"; shift

  if [ "$(id -u)" -eq 0 ] && [ "$username" != "root" ]; then
    warn "Running command as user '$username' => '$*'"

    # Export all required function dependencies
    local all_functions="$(declare -f log info warn error fatal success ok run_cmd has_cmd download_file package_manager_install_flox package_manager_install_mise packages_install_flox packages_install_mise prepare_tools_zsh prepare_tools_nvim)"

    # Export required arrays and variables
    local all_arrays="$(declare -p COLORS PACKAGES)"

    # Preserve environment variables for the target user
    sudo -u "$username" -H \
      HOME="$HOME" \
      USERNAME="$USERNAME" \
      GROUPNAME="$GROUPNAME" \
      XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-}" \
      XDG_DATA_HOME="${XDG_DATA_HOME:-}" \
      MISE_DATA_HOME="${MISE_DATA_HOME:-}" \
      FLOX_PATH="${FLOX_PATH:-}" \
      GITHUB_TOKEN="${GITHUB_TOKEN:-}" \
      USR_LOCAL_BIN="$USR_LOCAL_BIN" \
      PLATFORM_ARCH="$PLATFORM_ARCH" \
      FLOX_VERSION="$FLOX_VERSION" \
      UNAME="$UNAME" \
      CONTEXT="$CONTEXT" \
      PATH="/usr/local/bin:$HOME/.local/bin:$PATH" \
      bash -c "
        # Import functions and arrays
        $all_functions
        $all_arrays
        # Execute the command
        $*
      "
  else
    warn "Running command as current user '$USER' => '$*'"
    bash -c "$*"
  fi
}

# PREPARATION functions
prepare_platform_detection() {
  UNAME="$(uname -s | tr '[:upper:]' '[:lower:]')"
  [ "$UNAME" != "darwin" ] && [ "$UNAME" != "linux" ] && fatal "$1 Unsupported System '$UNAME'! Supported: darwin, linux (Debian-based)"
  DISTRO=$( [ "$UNAME" = "darwin" ] && echo "darwin" || { [ -f "/etc/os-release" ] && . /etc/os-release && echo "$ID"; } || echo "unknown" )
  case "$(uname -m)" in aarch64|arm64) ARCH="arm64"; PLATFORM_ARCH="aarch64";; x86_64|amd64) ARCH="amd64"; PLATFORM_ARCH="x86_64";; *) fatal "$1 Unsupported arch '$(uname -m)'! Supported: arm64, amd64";; esac
  ENV=$(is_container && echo "container" || echo "host")
  CONTEXT="$UNAME/$ARCH/$ENV"
  success "$1 Context Detection READY => '$CONTEXT' ✔"
}
prepare_argument_parsing() {
  local step="$1"; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--username) USERNAME="$2"; shift 2 ;;
      -g|--groupname) GROUPNAME="$2"; shift 2 ;;
      -t|--timezone) TIMEZONE="$2"; shift 2 ;;
      -p|--package-manager) PACKAGE_MANAGER="$2"; shift 2 ;;
      -r|--repo) REPO_URL="$2"; shift 2 ;;
      -b|--branch) BRANCH="$2"; shift 2 ;;
      *)
        warn "$step Unknown option: $1" >&2
        show_usage
        exit 1
      ;;
    esac
  done
  [[ "$PACKAGE_MANAGER" != "flox" && "$PACKAGE_MANAGER" != "mise" ]] && show_usage && exit 1
  success "$step Arguments extraction READY => [USERNAME:$USERNAME, GROUPNAME:$GROUPNAME, TIMEZONE:$TIMEZONE, PACKAGE_MANAGER:$PACKAGE_MANAGER, REPO_URL:$REPO_URL, BRANCH:$BRANCH] ✔"
}
prepare_system_min_packages() {
  if has_cmd apt; then
    run_cmd apt-get update && apt-get install -y --no-install-recommends ${PACKAGES[apt]} && apt-get clean && rm -rf /var/lib/apt/lists/*
    success "$1 System MINIMAL packages installed successfully! ✔"
  else
    warn "$1 No SYSTEM PACKAGE MANAGER found! Skipping system packages installation..."
  fi
}
prepare_system_post_install() {
  [ -n "$TIMEZONE" ] && { ln -snf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime; echo "$TIMEZONE" > /etc/timezone; }
  success "$1 System post-install configuration READY! ✔"
}
prepare_package_manager() {
  local step="$1" mgr="$2"
  if ! has_cmd "$mgr"; then
    warn "$step Installing Package Manager '$mgr' as user '$USERNAME'..."
    case "$mgr" in
      flox) run_as_user "$USERNAME" "package_manager_install_flox" ;;
      mise) run_as_user "$USERNAME" "package_manager_install_mise" ;;
    esac
  fi
  # Verify it works for target user
  run_as_user "$USERNAME" "command -v $mgr && $mgr --version" || fatal "$step Package Manager '$mgr' not accessible by user '$USERNAME'!"
}
prepare_user_and_group() {
  [ "$UNAME" = "darwin" ] && ensure_user_and_group_darwin "$1" || ensure_user_and_group_debian "$1"
  export USER="$USERNAME"; export GROUP="$GROUPNAME";
  ok "$1" "USER/GROUP" "{USER=$USER, GROUP=$GROUP} ensured!" "✔"
}
prepare_home_and_xdg_dirs() {
  [ "$UNAME" = "darwin" ] && export HOME="/Users/$USERNAME" || export HOME="/home/$USERNAME"
  backup_home "$1"
  export XDG_CONFIG_HOME="$HOME/.config"
  ensure_dirs_and_export_vars \
    "$HOME/.cache:XDG_CACHE_HOME" \
    "$HOME/.local/share:XDG_DATA_HOME" \
    "$HOME/.local/state:XDG_STATE_HOME" \
    "/tmp/runtime-$(id -u "$USERNAME"):XDG_RUNTIME_DIR" \
    "$HOME/.local/bin:XDG_LOCAL_BIN_DIR" \
    "$HOME/Desktop:XDG_DESKTOP_DIR" \
    "$HOME/Downloads:XDG_DOWNLOAD_DIR" \
    "$HOME/Documents:XDG_DOCUMENTS_DIR" \
    "$HOME/Music:XDG_MUSIC_DIR" \
    "$HOME/Pictures:XDG_PICTURES_DIR" \
    "$HOME/Movies:XDG_VIDEOS_DIR" \
    "$HOME/Projects:XDG_PROJECTS_DIR" \
    "$HOME/Work:XDG_WORKSPACE_DIR" \
    "$HOME/.cache/zsh:ZSH_CACHE_DIR" \
    "$HOME/.cache/npm:NPM_CONFIG_CACHE" \
    "$HOME/.local/state/zim:ZIM_HOME" \
    "$HOME/.local/share/zsh:ZSH_DATA_DIR" \
    "$HOME/.local/share/npm:NPM_CONFIG_PREFIX" \
    "$HOME/.local/share/gems:GEM_HOME" \
    "$HOME/.local/share/mise:MISE_DATA_HOME" \
    "$HOME/.local/share/mise:MISE_GLOBAL_CONFIG_DIR"

  ok "$1" "HOME/XDG/DIRS" "{HOME=$HOME, XDG_CONFIG_HOME=$XDG_CONFIG_HOME, XDG_CACHE_HOME=$XDG_CACHE_HOME, XDG_DATA_HOME=$XDG_DATA_HOME, XDG_STATE_HOME=$XDG_STATE_HOME, ZSH_CACHE_DIR=$ZSH_CACHE_DIR, NPM_CONFIG_PREFIX=$NPM_CONFIG_PREFIX, GEM_HOME=$GEM_HOME, MISE_DATA_HOME=$MISE_DATA_HOME, MISE_GLOBAL_CONFIG_DIR=$MISE_GLOBAL_CONFIG_DIR} exported!" "✔"
}
prepare_tools_zsh() {
  local zsh_path="$(command -v zsh)"
  local current_shell="$(has_cmd getent && getent passwd "$USERNAME" | cut -d: -f7 || awk -F: -v user="$USERNAME" '$1 == user {print $7}' /etc/passwd)"
  if [ "$current_shell" != "$zsh_path" ] && has_cmd chsh; then
    if run_cmd chsh -s "$zsh_path" "$USERNAME" 2>/dev/null; then
      info "$1 Successfully changed default shell to $zsh_path for user '$USERNAME'"
    else
      warn "$1 ZSH Failed to change default shell..."
    fi
  fi
  ok "$1" "TOOLS/ZSH" "$zsh_path ensured for user '$USERNAME'!" "✔"
}
prepare_tools_nvim() {
  [ ! -d "$XDG_CONFIG_HOME/nvim" ] && { warn "$1 Neovim config not found at '$XDG_CONFIG_HOME/nvim'! Skipping..."; return; }
  has_cmd npm && timeout 300 npm -g --prefix="$NPM_CONFIG_PREFIX" install neovim 2>/dev/null || warn "$1 NEOVIM/PROVIDERS/NPM NOT FOUND => NPM packages installation skipped..."
  has_cmd python3 && { run_cmd rm -rf "$XDG_CONFIG_HOME/nvim/.venv" && cd "$XDG_CONFIG_HOME/nvim" && python3 -m venv .venv && source .venv/bin/activate && timeout 300 pip install pynvim neovim 2>/dev/null; } || warn "$1 NEOVIM/PROVIDERS/PYTHON NOT FOUND => PIP packages installation skipped..."
  has_cmd gem && timeout 300 gem install neovim 2>/dev/null || warn "$1 NEOVIM/PROVIDERS/RUBY NOT FOUND => Gems installation skipped..."
  has_cmd nvim && timeout 600 nvim --headless "+Lazy! sync" "+TSUpdateSync" "+MasonToolsUpdateSync" "+qa" 2>/dev/null || warn "$1 NEOVIM/MASON plugins failed => non-fatal, continue the setup..."
  ok "$1" "TOOLS/NEOVIM" "Neovim fully configured for development!"
}

# CORE functions
setup_ownership() {
  run_cmd chown -R "$USERNAME:$GROUPNAME" "$HOME" 2>/dev/null || sudo chown -R "$USERNAME:$GROUPNAME" "$HOME" || {
    fatal "$1 Failed to ensure ownership of $HOME to '$USERNAME:$GROUPNAME'"
  }
  ok "$1" "CHOWN$HOME" "{USER=$USERNAME, GROUP=$GROUPNAME}" "${2:-✔}"
}
setup_system() {
  prepare_platform_detection "$1"
  prepare_argument_parsing "$1" "${@:2}"
  prepare_system_min_packages "$1"
  prepare_system_post_install "$1"
  ok "$1" "SYSTEM/PACKAGES" "System prepared for $CONTEXT!"
}
setup_user_home_and_dotfiles() {
  prepare_user_and_group "$1"
  prepare_home_and_xdg_dirs "$1"
  if [ ! -d "$HOME/.local/share/dots" ]; then # Clone repo if not present
    run_cmd git clone --branch "$BRANCH" --depth 1 "$REPO_URL" "$HOME/.local/share/dots"
  elif [ -d "$HOME/.local/share/dots/.git" ]; then # Update repo if already present
    run_cmd git -C "$HOME/.local/share/dots" pull origin "$BRANCH"
  fi
  [ -d "$HOME/.local/share/dots/config" ] && backup "$HOME/.config" "$HOME/.local/share/dots/config" || fatal "Source directory '$HOME/.local/share/dots/config' not found!"
  backup "$HOME/.zshenv" "$HOME/.config/zsh/.zshenv"
  ensure_dirs_and_export_vars "$HOME/.config/zsh:ZDOTDIR" "$HOME/.config/flox:FLOX_PATH"
  is_container && run_cmd rm -rf "$HOME/.local/share/dots/.git"
  ok "$1" "USER/HOME/DOTS" "{XDG_CONFIG_HOME=$XDG_CONFIG_HOME, ZDOTDIR=$ZDOTDIR, FLOX_PATH=$FLOX_PATH}"
}
setup_user_context() {
  setup_ownership "$1" # Just ensure ownership, no user switching
  ok "$1" "USER_CONTEXT" "User context prepared for $USERNAME"
}
setup_package_manager() {
  local original_pm="$PACKAGE_MANAGER"
  if ! prepare_package_manager "$1" "$PACKAGE_MANAGER"; then
    local fallback_pm=$([ "$PACKAGE_MANAGER" = "flox" ] && echo "mise" || echo "flox")
    warn "$1 Trying '$fallback_pm' as fallback..."
    if prepare_package_manager "$1" "$fallback_pm"; then
      PACKAGE_MANAGER="$fallback_pm"
      warn "$1 Successfully switched to $fallback_pm"
    else
      fatal "$1 Both '$original_pm' and '$fallback_pm' installation failed"
    fi
  fi
  ok "$1" "PM/$PACKAGE_MANAGER"
}
setup_packages() {
  get_github_token
  if [ "$PACKAGE_MANAGER" = "flox" ]; then # Run flox setup directly (handles permissions internally)
    packages_install_flox
  else # Run mise as target user
    run_as_user "$USERNAME" "packages_install_mise"
  fi
  ok "$1" "PM/$PACKAGE_MANAGER/PACKAGES" "{${PACKAGES[$PACKAGE_MANAGER]}}"
}
setup_tools() {
  prepare_tools_zsh "$1" # Run chsh as current user (likely root) since it needs system access
  run_as_user "$USERNAME" "prepare_tools_nvim '$1'"
  ok "$1" "TOOLS"
}

# MAIN execution
setup_system "1/7" "$@"
setup_user_home_and_dotfiles "2/7"
setup_user_context "3/7"
setup_package_manager "4/7"
setup_packages "5/7"
setup_tools "6/7"
setup_ownership "7/7" "Installation completed! Restart your shell to use the new environment! 🚀🚀"

