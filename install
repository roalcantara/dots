#!/usr/bin/env bash
# Sets up this machine: mise, the dots checkout, the age key, then mise bootstrap (design.md §10).
# curl -fsSL https://raw.githubusercontent.com/roalcantara/dots/main/install | bash
# Env: DOTS_BRANCH (main), DOTS_REPO (clone URL), DOTS_HISTORY (the private history origin),
#      DOTS_PROFILE (desktop), DOTS_AGE_KEY (the key, for tests; otherwise it is read from the terminal).
set -euo pipefail

MISE_VERSION="2026.10.22"
DOTS="$HOME/.local/share/dots"
KEY="$DOTS/config/age/keys.txt"
BRANCH="${DOTS_BRANCH:-main}"
REPO="${DOTS_REPO:-https://github.com/roalcantara/dots.git}"
HISTORY="${DOTS_HISTORY:-https://github.com/roalcantara/dots-history.git}"
PROFILE="${DOTS_PROFILE:-desktop}"
export PATH="$HOME/.local/bin:$PATH"

# Prerequisites mise cannot provide itself:
# - git: this script clones the repo and mise clones the history (a fresh Ubuntu desktop has no git);
# - Linux desktop: flatpak and the Flathub remote, which the flatpak apps in packages.toml need before
#   mise installs them in the same step.
need=()
command -v git >/dev/null || need+=(git)
if [ "$(uname -s)" = Linux ] && [ "$PROFILE" = desktop ]; then
  command -v flatpak >/dev/null || need+=(flatpak)
fi
if [ ${#need[@]} -gt 0 ]; then
  if [ "$(uname -s)" = Darwin ]; then
    echo "install: git is missing; run 'xcode-select --install', then rerun install" >&2
    exit 2
  elif command -v apt-get >/dev/null; then
    sudo=""
    [ "$(id -u)" -eq 0 ] || sudo="sudo"
    $sudo apt-get update -qq
    $sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${need[@]}"
  else
    echo "install: missing ${need[*]}; install them, then rerun install" >&2
    exit 2
  fi
fi
if command -v flatpak >/dev/null && [ "$PROFILE" = desktop ]; then
  flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
fi

command -v mise >/dev/null || curl -fsSL https://mise.run | MISE_VERSION="v$MISE_VERSION" sh
[ -d "$DOTS/.git" ] || git clone --branch "$BRANCH" "$REPO" "$DOTS"

if [ ! -s "$KEY" ]; then
  key="${DOTS_AGE_KEY:-}"
  if [ -z "$key" ]; then
    printf 'Paste the age key (AGE-SECRET-KEY-1...) and press Enter: ' >/dev/tty
    IFS= read -rs key </dev/tty
    printf '\n' >/dev/tty
  fi
  case "$key" in AGE-SECRET-KEY-1*) ;; *) echo "install: that is not an age secret key" >&2; exit 2 ;; esac
  (umask 077 && printf '%s\n' "$key" >"$KEY")
fi
mkdir -p "$DOTS/config/mise"
if command -v age-keygen >/dev/null 2>&1 && [ -s "$KEY" ]; then
  pub="$(age-keygen -y "$KEY" 2>/dev/null || true)"
  if [ -n "$pub" ]; then
    printf '[history.encryption]\nrecipients = ["%s"]\n' "$pub" > "$DOTS/config/mise/config.local.toml"
  fi
fi
# The first adopt runs before ~/.config/mise links into the repo, so mise finds the key at its default path.
# Only into a real folder: through the link it would land in the public checkout. The folder is removed below.
if [ ! -L "$HOME/.config/mise" ]; then
  mkdir -p "$HOME/.config/mise"
  [ -e "$HOME/.config/mise/age.txt" ] || (umask 077 && cp "$KEY" "$HOME/.config/mise/age.txt")
fi

case "$HISTORY" in
  https://github.com/*)
    hosts="$HOME/.config/gh/hosts.yml"
    had_hosts=0
    [ -e "$hosts" ] && had_hosts=1
    mise exec gh@latest -- gh auth status >/dev/null 2>&1 ||
      mise exec gh@latest -- gh auth login --hostname github.com --git-protocol https --web
    mise exec gh@latest -- gh auth setup-git --hostname github.com
    # The history tracks hosts.yml: a copy written by this sign-in would conflict with it and pause the whole
    # restore. Keep the new token in memory instead (the git credential helper reads GH_TOKEN too).
    if [ "$had_hosts" = 0 ] && [ -e "$hosts" ]; then
      GH_TOKEN="$(mise exec gh@latest -- gh auth token)"
      export GH_TOKEN
      rm -f "$hosts"
    fi
    ;;
esac

BOOTSTRAP_ARGS=("-E" "$PROFILE" "--yes")
# Containers only: replace the base image's .bashrc/.profile. On a host, --force-dotfiles would replace a real
# ~/.ssh or ~/.gnupg folder with a link and delete the keys in it.
if [ "$PROFILE" = "container" ]; then BOOTSTRAP_ARGS+=("--force-dotfiles" "--skip" "user"); fi

mise bootstrap --adopt "$HISTORY" "${BOOTSTRAP_ARGS[@]}"
ln -sfn ../.local/share/dots/config/age "$HOME/.config/age"
if [ ! -L "$HOME/.config/mise" ]; then
  test -f "$HOME/.config/mise/config.local.toml" && cat "$HOME/.config/mise/config.local.toml" >> "$DOTS/config/mise/config.local.toml"
  rm -rf "$HOME/.config/mise" # with age.txt: from here on the key is read from ~/.config/age/keys.txt
fi
ln -sfn ../.local/share/dots/config/mise "$HOME/.config/mise"
mise bootstrap "${BOOTSTRAP_ARGS[@]}"
