{
  "name": "raycast-scripts-node",
  "version": "1.0.0",
  "description": "Centralises common scripts for Raycast extensions using Node.js",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "watch": "tsx watch index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "puppeteer": "^24.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}