#!/usr/bin/env sh
# JankyBorders: the outline around windows (docs/TILING.md).
# https://github.com/FelixKratz/JankyBorders — the LaunchAgent in config/mise/conf.d/yabai.toml runs
# `borders`, which reads this file.
# Omarchy's focused colours: cyan to green (rgba(33ccffee) rgba(00ff99ee) 45deg), 5 wide. Unfocused windows get
# no outline: JankyBorders draws one width for all, and 5 was too heavy on them. Colours are 0xAARRGGBB. yb border turns the
# focused outline amber while the window is zoomed.
borders active_color="gradient(top_left=0xee33ccff,bottom_right=0xee00ff99)" inactive_color=0x00000000 width=5.0 style=round hidpi=on
