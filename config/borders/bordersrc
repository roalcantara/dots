#!/usr/bin/env sh
# JankyBorders: the outline around windows (docs/TILING.md).
# https://github.com/FelixKratz/JankyBorders — the LaunchAgent in config/mise/conf.d/yabai.toml runs
# `borders`, which reads this file.
# Omarchy's border: 2 wide, cyan to green when focused (rgba(33ccffee) rgba(00ff99ee) 45deg), translucent grey
# (rgba(595959aa)) otherwise. Colours are 0xAARRGGBB.
borders active_color="gradient(top_left=0xee33ccff,bottom_right=0xee00ff99)" inactive_color=0xaa595959 width=2.0 style=round hidpi=on
