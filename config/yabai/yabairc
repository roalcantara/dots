#!/usr/bin/env sh
# yabai: the tiling window manager behind the fn layer (docs/TILING.md).
# https://github.com/asmvik/yabai/blob/master/doc/yabai.asciidoc
#
# Started by the LaunchAgent in config/mise/conf.d/yabai.toml (`yb run`: Homebrew's yabai, or the build
# `yb use` chose). The scripting addition needs SIP partly off and the sudoers rule `yb sa` writes for that
# binary; `yb load-sa` runs `sudo -n`, which never waits for a password, so a stale rule only costs the
# addition's extras (instant switching, scratchpad, pinning, moving spaces), never a hung login.
"$HOME/.local/bin/yb" load-sa
yabai -m signal --add event=dock_did_restart label=load_sa action="$HOME/.local/bin/yb load-sa"

# Omarchy's look (default/hypr/looknfeel): 10 between windows and at the edges, no shadows.
# Dwindle tiling: each new window splits the newest tile (insertion point last), along its longer side
# (split_type auto), and takes the right or bottom half (second_child). Sizes set with fn + − / = stay put
# (auto_balance off); fn + b balances on demand.
yabai -m config \
  layout bsp \
  split_type auto \
  split_ratio 0.50 \
  auto_balance off \
  window_placement second_child \
  window_insertion_point last \
  window_zoom_persist on \
  top_padding 10 \
  bottom_padding 10 \
  left_padding 10 \
  right_padding 10 \
  window_gap 10 \
  window_shadow off \
  window_opacity off \
  window_animation_duration 0.0 \
  insert_feedback_color 0xffd75f5f \
  mouse_follows_focus on \
  focus_follows_mouse off \
  display_arrangement_order default \
  window_origin_display default \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

# Windows that should float: settings, small utilities, launchers and dialogs.
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add subrole="^AXDialog$" manage=off
yabai -m rule --apply

# Ten labelled spaces: s1-s5 on the built-in screen, s6-s10 on the external one (yb spaces).
SPACES="$HOME/.local/bin/yb spaces"
yabai -m signal --add event=display_added label=spaces_added action="$SPACES"
yabai -m signal --add event=display_removed label=spaces_removed action="$SPACES"
yabai -m signal --add event=display_moved label=spaces_moved action="$SPACES"

# The space strip in the menu bar (SwiftBar, config/swiftbar): redraw on every change, including focus
# moving between screens (application_front_switched).
BAR="open -g 'swiftbar://refreshplugin?name=spaces'"
yabai -m signal --add event=space_changed label=bar_space action="$BAR"
yabai -m signal --add event=display_changed label=bar_display action="$BAR"
yabai -m signal --add event=window_created label=bar_window_created action="$BAR"
yabai -m signal --add event=window_destroyed label=bar_window_destroyed action="$BAR"
yabai -m signal --add event=application_front_switched label=bar_front action="$BAR"

# The outline turns amber while the focused window is zoomed (yb border).
yabai -m signal --add event=window_focused label=border_window_focused action="$HOME/.local/bin/yb border"
yabai -m signal --add event=application_front_switched label=border_application_front_switched action="$HOME/.local/bin/yb border"

# The tiling trace (yb log): yabai's own events, next to the keys yb logs.
yabai -m signal --add event=window_created label=trace_window_created action="$HOME/.local/bin/yb event window_created"
yabai -m signal --add event=window_destroyed label=trace_window_destroyed action="$HOME/.local/bin/yb event window_destroyed"
yabai -m signal --add event=space_changed label=trace_space_changed action="$HOME/.local/bin/yb event space_changed"
yabai -m signal --add event=display_changed label=trace_display_changed action="$HOME/.local/bin/yb event display_changed"
yabai -m signal --add event=application_front_switched label=trace_application_front_switched action="$HOME/.local/bin/yb event application_front_switched"

$HOME/.local/bin/yb spaces
echo "yabai configuration loaded"
