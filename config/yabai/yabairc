#!/usr/bin/env sh
# yabai: the tiling window manager behind the fn layer (docs/TILING.md).
# https://github.com/asmvik/yabai/blob/master/doc/yabai.asciidoc
#
# Started by the LaunchAgent in config/mise/conf.d/yabai.toml. The scripting addition needs SIP partly
# off and the sudoers rule `yb sa` writes; `sudo -n` never waits for a password, so a stale rule only
# costs the addition's extras (instant switching, scratchpad, pinning), never a hung login.
sudo -n /opt/homebrew/bin/yabai --load-sa
yabai -m signal --add event=dock_did_restart label=load_sa action="sudo -n /opt/homebrew/bin/yabai --load-sa"

# Omarchy's look (default/hypr/looknfeel): 10 between windows and at the edges, no shadows.
yabai -m config \
  layout bsp \
  split_type auto \
  split_ratio 0.50 \
  auto_balance on \
  window_placement second_child \
  window_insertion_point focused \
  window_zoom_persist on \
  top_padding 10 \
  bottom_padding 10 \
  left_padding 10 \
  right_padding 10 \
  window_gap 10 \
  window_shadow off \
  window_opacity off \
  window_animation_duration 0.0 \
  insert_feedback_color 0xffd75f5f \
  mouse_follows_focus on \
  focus_follows_mouse off \
  display_arrangement_order default \
  window_origin_display default \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

# Windows that should float: settings, small utilities, launchers and dialogs.
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add subrole="^AXDialog$" manage=off
yabai -m rule --apply

# Ten labelled spaces: s1-s5 on the built-in screen, s6-s10 on the external one (yb spaces).
SPACES="$HOME/.local/bin/yb spaces"
yabai -m signal --add event=display_added label=spaces_added action="$SPACES"
yabai -m signal --add event=display_removed label=spaces_removed action="$SPACES"
yabai -m signal --add event=display_moved label=spaces_moved action="$SPACES"

# The kb Raycast extension's space strip (roalcantara/kb-raycast, command yabai.screen).
KB="nohup open -g 'raycast://extensions/roalcantara/kb/yabai.screen?launchType=background' >/dev/null 2>&1 &"
yabai -m signal --add event=space_changed label=kb_space action="$KB"
yabai -m signal --add event=display_changed label=kb_display action="$KB"
yabai -m signal --add event=window_created label=kb_window_created action="$KB"
yabai -m signal --add event=window_destroyed label=kb_window_destroyed action="$KB"

$HOME/.local/bin/yb spaces
echo "yabai configuration loaded"
