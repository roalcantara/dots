################################################################################


# A theme to use. It can be a built-in theme name, a custom theme name, or an absolute path to a custom theme file.
# Some themes are "Ayu Mirage" "Andromeda" "catppuccin-macchiato" "catppuccin-mocha" "catppuccin-frappe" "Kanagawa Wave" "tokyonight_moon"
# https://ghostty.org/docs/config/reference#theme
theme = "TokyoNight"
# Color palette for the 256 colors used by many terminal apps (https://ditig.com/256-colors-cheat-sheet). It is defined as N=COLOR where:
# - N is 0-255 of the terminal color table. It can be decimal (default), binary (0b), octal (0o), or hexadecimal (0x).
# - COLOR is a typical RGB color code such as #AABBCC or AABBCC, or a named X11 color
# List of 256 colors for Xterm prompt: https://ditig.com/256-colors-cheat-sheet
# https://ghostty.org/docs/config/reference#palette
# palette
# Foreground color for the window. Specified as either hex (#RRGGBB or RRGGBB) or a named X11 color
# List of 256 colors for Xterm prompt: https://ditig.com/256-colors-cheat-sheet
# https://ghostty.org/docs/config/reference#foreground
# foreground = #RRGGBB
# Background color for the window. Specified as either hex (#RRGGBB or RRGGBB) or a named X11 color
# List of 256 colors for Xterm prompt: https://ditig.com/256-colors-cheat-sheet
# https://ghostty.org/docs/config/reference#background
background = "#1D212F"
# Foreground color for selection. Specified as either hex (#RRGGBB or RRGGBB) or a named X11 color.
# If this is not set, then the selection color is just the inverted window foreground. NOTE: not to be confused with the cell fg
# List of 256 colors for Xterm prompt: https://ditig.com/256-colors-cheat-sheet
# https://ghostty.org/docs/config/reference#selection-foreground
# selection-foreground = #RRGGBB
# Background color for selection. Specified as either hex (#RRGGBB or RRGGBB) or a named X11 color.
# If this is not set, then the selection color is just the inverted window background. NOTE: not to be confused with the cell bg
# List of 256 colors for Xterm prompt: https://ditig.com/256-colors-cheat-sheet
# https://ghostty.org/docs/config/reference#selection-background
# selection-background = #RRGGBB
# Color space used to alpha blending: native | liner | linear-corrected
# https://ghostty.org/docs/config/reference#alpha-blending
alpha-blending = native


################################################################################
## WINDOW SETTINGS #############################################################
################################################################################


# Horizontal window padding.
# Applies padding between the terminal cells and the left and right window borders.
# https://ghostty.org/docs/config/reference#window-padding-x
window-padding-x = 15
# Vertical window padding.
# Applies padding between the terminal cells and the top and bottom window borders.
# https://ghostty.org/docs/config/reference#window-padding-y
window-padding-y = 15
# The theme to use for the windows: auto | system | light | dark | ghostty (only linux)
# https://ghostty.org/docs/config/reference#window-theme
window-theme = auto
# Specifies a preference; the actual OS, desktop environment, window manager, etc. may override this preference: none | auto | client | system
# auto - Automatically decide to use either client-side or server-side decorations based on the detected preferences of the current OS and desktop environment. This option usually makes Ghostty look the most "native" for your desktop.
# https://ghostty.org/docs/config/reference#window-decoration
window-decoration = auto
# The colorspace to use for the windows: srgb | display-p3 | a98-rgb
# https://ghostty.org/docs/config/reference#window-colorspace
window-colorspace = display-p3
# The viewport dimensions are usually not perfectly divisible by the cell size.
# In this case, some extra padding on the end of a column and the bottom of the final row may exist.
# If true, the extra padding is automatically balanced between all four edges to minimize imbalance on one side
# https://ghostty.org/docs/config/reference#window-padding-balance
window-padding-balance = false
# The color of the padding area of the window: background | extend | extend-always
# https://ghostty.org/docs/config/reference#window-padding-color
window-padding-color = extend-always
# The font that will be used for the application's window and tab titles
# https://ghostty.org/docs/config/reference#window-title-font-family
window-title-font-family = "JetBrainsMonoNL NFM Thin"
# The text that will be displayed in the subtitle of the window
# https://ghostty.org/docs/config/reference#window-subtitle
window-subtitle = false


################################################################################
## MAIN SETTINGS
## https://ghostty.org/docs/config/reference
################################################################################

# Enable URL matching. URLs are matched on hover with control (Linux) or command (macOS) pressed and open using the default system application for the linked URL.
# https://ghostty.org/docs/config/reference#link-url
link-url=true
# When true, link previews are shown for all matched URLs. When false, link previews are never shown.
# https://ghostty.org/docs/config/reference#link-previews
link-previews=true
# Only the XDG config path ($XDG_CONFIG_HOME/ghostty/config).
# https://ghostty.org/docs/config/reference#config-default-files
config-default-files=true
# Do not confirm that a surface should be closed before closing it
# https://ghostty.org/docs/config/reference#confirm-close-surface
confirm-close-surface=false
# Quit after the last surface is closed
# https://ghostty.org/docs/config/reference#quit-after-last-window-closed
quit-after-last-window-closed = true
# Enable shell integration auto-injection
# Shell integration greatly enhances the terminal experience:
# - Working directory reporting so new tabs, splits inherit the previous terminal's working directory.
# - Prompt marking that enables the "jump_to_prompt" keybinding.
# - If you're sitting at a prompt, closing a terminal will not ask for confirmation.
# - Resizing the window with a complex prompt usually paints much better.
# https://ghostty.org/docs/config/reference#shell-integration
# https://ghostty.org/docs/features/shell-integration
shell-integration = detect
# Prevent sudo from resetting environment variables and raise errors about missing or unsuitable terminal: xterm-ghostty when running some programs
# https://ghostty.org/docs/config/reference#shell-integration-features
# https://ghostty.org/docs/features/shell-integration
# https://ghostty.org/docs/help/terminfo#sudo
shell-integration-features = sudo, no-cursor, ssh-env, ssh-terminfo
# The style of the cursor. This sets the default style. A running program can still request an explicit cursor style using escape sequences (such as CSI q). Shell configurations will often request specific cursor styles.
# https://ghostty.org/docs/config/reference#cursor-style
cursor-style = block
# Enables the ability to move the cursor at prompts by using alt+click on Linux and option+click on macOS.
# https://ghostty.org/docs/config/reference#cursor-click-to-move
cursor-click-to-move = true
# Quick Terminal
# A Lightweight terminal displayed as a modal/popup for instant access and quick commands without interrupting work
# https://ghostty.org/docs/config/reference#quick-terminal-position
quick-terminal-screen = mouse
quick-terminal-position = center
# Duration (secs) of quick terminal enter/exit animation. 0 disable it.
# https://ghostty.org/docs/config/reference#quick-terminal-autohide
quick-terminal-animation-duration = .5
# https://ghostty.org/docs/config/reference#quick-terminal-autohide
quick-terminal-autohide = true
# https://ghostty.org/docs/config/reference#quick-terminal-space-behavior
quick-terminal-space-behavior = remain

################################################################################
## MACOS SETTINGS
## https://ghostty.org/docs/features#macos
################################################################################


# Automatically enable the "Secure Input" feature when it detects that a password prompt is being displayed
# https://ghostty.org/docs/config/reference#macos-auto-secure-input
macos-auto-secure-input = true
# Show a graphical indication when secure input is enabled
# https://ghostty.org/docs/config/reference#macos-secure-input-indication
macos-secure-input-indication = true
# The style of the macOS titlebar: native | transparent | tabs | hidden
# https://ghostty.org/docs/config/reference#macos-titlebar-style
macos-titlebar-style = hidden
# Use non-native fullscreen mode: visible-menu | true | false
# https://ghostty.org/docs/config/reference#macos-non-native-fullscreen
macos-non-native-fullscreen = true
# Whether to enable the macOS window shadow
# With some window managers and window transparency settings, you may find false more visually appealing.
# https://ghostty.org/docs/config/reference#macos-window-shadow
macos-window-shadow = true
# Use option as alt key
# https://ghostty.org/docs/config/reference#macos-option-as-alt
macos-option-as-alt = true
# Whether macOS Shortcuts are allowed to control Ghostty
# https://ghostty.org/docs/config/reference#macos-shortcuts
macos-shortcuts = ask
# The opacity level (opposite of transparency) of the background.
# A value of 1 is fully opaque and a value of 0 is fully transparent.
# https://ghostty.org/docs/config/reference#background-opacity
background-opacity = 1
# Whether to blur the background when background-opacity is less than 1.
#    a nonnegative integer specifying the blur intensity
#    false, equivalent to a blur intensity of 0
#    true, equivalent to the default blur intensity of 20, which is reasonable for a good looking blur.
#    Higher blur intensities may cause strange rendering and performance issues.
# https://ghostty.org/docs/config/reference#background-blur
background-blur = true


################################################################################
## CLIPBOARD & MOUSE SETTINGS
################################################################################


# Allow programs running in the terminal to read to the system clipboard
# https://ghostty.org/docs/config/reference#clipboard-read
clipboard-read = allow
# Allow programs running in the terminal to write to the system clipboard
# https://ghostty.org/docs/config/reference#clipboard-write
clipboard-write = allow
# Trims trailing whitespace on data that is copied to the clipboard
# https://ghostty.org/docs/config/reference#clipboard-trim-trailing-spaces
clipboard-trim-trailing-spaces = true
# Automatically copy selected text to the clipboard
# https://ghostty.org/docs/config/reference#copy-on-select
copy-on-select = clipboard
# Hide the mouse immediately when typing
# https://ghostty.org/docs/config/reference#mouse-hide-while-typing
mouse-hide-while-typing = true
# Enable the mouse to shift-click to capture text
# https://ghostty.org/docs/config/reference#mouse-shift-capture
mouse-shift-capture = true
# When there are multiple split panes, the mouse selects the focused pane
# https://ghostty.org/docs/config/reference#focus-follows-mouse
focus-follows-mouse = true

# The action to take when the user right-clicks on the terminal surface
# https://ghostty.org/docs/config/reference#right-click-action
right-click-action = context-menu


