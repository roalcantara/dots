################################################################################
## FONTS #######################################################################
## https://ghostty.org/docs/config/reference#font-family
## To see all available fonts run: ghostty +list-fonts
################################################################################


# Font size in points. I.E.: 13.5pt @ 2px/pt = 27px
# https://ghostty.org/docs/config/reference#font-size
font-size = 13
# The font families to use | ghostty +list-fonts
# https://ghostty.org/docs/config/reference#font-family
# font-family = "Fira Code Retina"
font-family = Cascadia Code PL
# https://ghostty.org/docs/config/reference#font-style
# font-style = Regular
# https://ghostty.org/docs/config/reference#font-style-bold
# font-style-bold = Semibold
# https://ghostty.org/docs/config/reference#font-style-italic
# font-style-italic = Italic
# https://ghostty.org/docs/config/reference#font-style-bold-italic
# font-style-bold-italic = Semibold Italic
# fonts with a thicker stroke
# https://ghostty.org/docs/config/reference#font-thicken
font-thicken = true
# 0-255 where 0 corresponds to the lightest available thickening
# https://ghostty.org/docs/config/reference#font-thicken-strength
font-thicken-strength = 50
# Apply a font feature (comma separated list)
# https://ghostty.org/docs/config/reference#font-feature
# font-feature = "'cv01', 'cv02', 'cv06', 'cv09', 'cv13', 'cv14', 'cv17', 'cv22', 'cv25', 'cv26', 'cv28', 'cv29', 'cv30', 'cv31', 'cv32', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss09', 'ss10', 'zero', 'onum'"
# font-feature = "'ss01', 'ss02', 'ss03', 'ss19', 'ss20', 'calt'"
font-feature = "+calt, +liga, +dlig, +rclt, +ss20, +zero, +ccmp"
# All of the configurations behavior adjust various metrics determined by the font
# https://ghostty.org/docs/config/reference#adjust-cell-height
adjust-cell-height = 10
# Distance in pixels or percentage adjustment from the bottom of the cell to the text baseline
# https://ghostty.org/docs/config/reference#adjust-font-baseline
# adjust-font-baseline = 5


################################################################################
## THEME & COLORS ##############################################################
## To see all available themes run: ghostty +list-themes
