# shellcheck disable=all

# Fast, feature-rich, and cross-platform terminal emulator that uses platform-native UI and GPU acceleration.
# https://ghostty.org/docs/config

######## FONTS
font-family = Cascadia Code NF
font-feature = "'ss01', 'ss02', 'ss03', 'ss19', 'ss20', 'calt'"
# font-family = "Fira Code Retina"
# font-feature = "'cv01', 'cv02', 'cv06', 'cv09', 'cv13', 'cv14', 'cv17', 'cv22', 'cv25', 'cv26', 'cv28', 'cv29', 'cv30', 'cv31', 'cv32', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss09', 'ss10', 'zero', 'onum'"
# font-family = JetBrainsMonoNL NFM
# font-feature = "+calt, +liga, +dlig, +rclt, +ss20, +zero, +ccmp"
font-size = 15
font-style = Regular
font-style-bold = Semibold
font-style-italic = Italic
font-style-bold-italic = Semibold Italic
font-thicken = true
font-thicken-strength = 0
adjust-cell-height = 10
# adjust-font-baseline = 5

######## THEME & COLORS
theme = Catppuccin Mocha
background = #1D212F
alpha-blending = native

######## WINDOW
window-padding-x = 15
window-padding-y = 15
window-theme = auto
window-decoration = auto
window-colorspace = display-p3
window-padding-balance = false
window-padding-color = extend-always
window-title-font-family = "JetBrainsMonoNL NFM Thin"
window-subtitle = false

######## MAIN
link-url = true
link-previews = true
config-default-files = true
confirm-close-surface = false
quit-after-last-window-closed = false
shell-integration = detect
shell-integration-features = sudo, no-cursor, ssh-env, ssh-terminfo
cursor-style = block
cursor-click-to-move = true

######## Quick Terminal
quick-terminal-screen = mouse
quick-terminal-position = top
quick-terminal-autohide = true
quick-terminal-space-behavior = move
quick-terminal-animation-duration = .1
async-backend = auto
desktop-notifications = true

######## MACOS
macos-auto-secure-input = true
macos-secure-input-indication = true
macos-titlebar-style = tabs
macos-non-native-fullscreen = true
macos-window-shadow = true
macos-option-as-alt = true
macos-shortcuts = allow
background-opacity = 0.90
background-blur = true
macos-dock-drop-behavior = new-window

######## CLIPBOARD & MOUSE SETTINGS
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard
mouse-hide-while-typing = true
mouse-shift-capture = true
focus-follows-mouse = true
right-click-action = context-menu
custom-shader-animation = true

######## KEYBINDINGS
# UNBIND: APPLICATION (SUPER) ---------------------------------------------------
# select_all
keybind = super+a=unbind
# new_window
keybind = super+n=unbind
# clear_screen
keybind = super+k=unbind
# quit
keybind = super+q=unbind
# close_surface
keybind = super+w=unbind
# jump_to_prompt:-1
keybind = super+up=unbind
# increase_font_size:1
keybind = super+plus=unbind
# reset_font_size
keybind = super+zero=unbind
# close_all_windows
keybind = super+alt+w=unbind
# scroll_page_up
keybind = super+page_up=unbind
# scroll_page_down
keybind = super+page_down=unbind
# decrease_font_size:1
keybind = super+minus=unbind
# scroll_to_top
keybind = super+home=unbind
# increase_font_size:1
keybind = super+equal=unbind
# toggle_fullscreen
keybind = super+enter=unbind
# jump_to_prompt:1
keybind = super+down=unbind
# open_config
keybind = super+comma=unbind
# UNBIND: INSPECTOR & ALT CHORDS -----------------------------------------------
# inspector:toggle
keybind = super+alt+i=unbind
# close_all_windows
keybind = super+alt+shift+w=unbind
# write_screen_file:open
keybind = super+alt+shift+j=unbind
# UNBIND: RESIZE SPLIT (SUPER+CTRL) --------------------------------------------
# toggle_fullscreen
keybind = super+ctrl+f=unbind
# resize_split:up,10
keybind = super+ctrl+up=unbind
# resize_split:down,10
keybind = super+ctrl+down=unbind
# resize_split:left,10
keybind = super+ctrl+left=unbind
# resize_split:right,10
keybind = super+ctrl+right=unbind
# equalize_splits
keybind = super+ctrl+equal=unbind
# UNBIND: NEW TAB CHORDS (SUPER/CMD+SHIFT+T) -----------------------------------
keybind = super+shift+t=unbind
keybind = unconsumed:super+shift+t=unbind
keybind = global:unconsumed:super+shift+t=unbind
keybind = cmd+shift+t=unbind
keybind = unconsumed:cmd+shift+t=unbind
keybind = global:unconsumed:cmd+shift+t=unbind
# UNBIND: SUPER+SHIFT ----------------------------------------------------------
# close_window
keybind = super+shift+w=unbind
# paste_from_selection
keybind = super+shift+v=unbind
# write_screen_file:paste
keybind = super+shift+j=unbind
# jump_to_prompt:-1
keybind = super+shift+up=unbind
# toggle_split_zoom
keybind = super+shift+enter=unbind
# jump_to_prompt:1
keybind = super+shift+down=unbind
# reload_config
keybind = super+shift+comma=unbind
# ghost help
keybind = super+shift+slash=unbind
keybind = super+?=unbind
# UNBIND: SHIFT + MOVEMENT (SELECTION ADJUST) ----------------------------------
# adjust_selection:up
keybind = shift+up=unbind
# adjust_selection:end
keybind = shift+end=unbind
# adjust_selection:down
keybind = shift+down=unbind
# adjust_selection:left
keybind = shift+left=unbind
# adjust_selection:home
keybind = shift+home=unbind
# adjust_selection:right
keybind = shift+right=unbind
# adjust_selection:page_up
keybind = shift+page_up=unbind
# adjust_selection:page_down
keybind = shift+page_down=unbind
# UNBIND: SUPER ARROW KEYS -----------------------------------------------------
keybind = super+up=unbind
keybind = super+down=unbind
keybind = super+right=unbind
keybind = super+left=unbind
# UNBIND: COMMAND PALETTE (DEFAULT) --------------------------------------------
keybind = global:unconsumed:super+shift+p=unbind
# UNBIND: TAB SHORTCUTS --------------------------------------------------------
# new_tab
keybind = super+t=unbind
keybind = super+alt+t=unbind
# next_tab
keybind = ctrl+tab=unbind
keybind = super+shift+right_bracket=unbind
# previous_tab
keybind = ctrl+shift+tab=unbind
keybind = super+shift+left_bracket=unbind
# goto_tab
keybind = super+one=unbind
keybind = super+two=unbind
keybind = super+three=unbind
keybind = super+four=unbind
keybind = super+five=unbind
keybind = super+six=unbind
keybind = super+seven=unbind
keybind = super+eight=unbind
keybind = super+nine=unbind
keybind = super+shift+left_shift=unbind
keybind = super+shift+backslash=unbind
keybind = global:unconsumed:shift+cmd+backslash=unbind
keybind = global:unconsumed:shift+super+backslash=unbind
# TABS: OPTIONAL ACTIONS (L⌘ — COMMENTED; L⌘+T IS QUICK TERMINAL) --------------
# keybind = unconsumed:super+ctrl+alt+t=new_tab
# keybind = unconsumed:super+ctrl+alt+tab=next_tab
# keybind = unconsumed:super+ctrl+alt+shift+tab=previous_tab
# keybind = unconsumed:super+ctrl+alt+one=goto_tab:1
# keybind = unconsumed:super+ctrl+alt+two=goto_tab:2
# keybind = unconsumed:super+ctrl+alt+three=goto_tab:3
# keybind = unconsumed:super+ctrl+alt+four=goto_tab:4
# keybind = unconsumed:super+ctrl+alt+five=goto_tab:5
# keybind = unconsumed:super+ctrl+alt+six=goto_tab:6
# keybind = unconsumed:super+ctrl+alt+seven=goto_tab:7
# keybind = unconsumed:super+ctrl+alt+eight=goto_tab:8
# keybind = unconsumed:super+ctrl+alt+nine=goto_tab:9
# ----- UNBIND: CHORDS RESERVED FOR L⌘ (NEW WINDOW / QUICK TERMINAL) -----
keybind = super+ctrl+alt+n=unbind
keybind = super+ctrl+alt+t=unbind
# UNBIND: SPLITS GOTO ----------------------------------------------------------
# DEFAULT: goto_split:up / down / left / right / previous / next
keybind = super+alt+up=unbind
keybind = super+alt+down=unbind
keybind = super+alt+left=unbind
keybind = super+alt+right=unbind
keybind = super+right_bracket=unbind
keybind = super+left_bracket=unbind
# BIND: SPLITS: GOTO (FOCUS) ---------------------------------------------------
keybind = super+ctrl+alt+up=unbind
keybind = super+ctrl+alt+left=unbind
keybind = super+ctrl+alt+down=unbind
keybind = super+ctrl+alt+right=unbind
# Ghostty layer (Karabiner F3-layer emits ctrl+alt+arrows) ---------------------
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+alt+right=goto_split:right
# BIND: SPLITS: GOTO (ROTATE FOCUS) --------------------------------------------
keybind = super+ctrl+alt+left_bracket=unbind
keybind = super+ctrl+alt+right_bracket=unbind
keybind = ctrl+alt+left_bracket=goto_split:previous
keybind = ctrl+alt+right_bracket=goto_split:next
# BIND: SPLITS: NEW_SPLIT ------------------------------------------------------
keybind = super+ctrl+alt+shift+up=unbind
keybind = super+ctrl+alt+shift+down=unbind
keybind = super+ctrl+alt+shift+right=unbind
keybind = super+ctrl+alt+shift+left=unbind
keybind = ctrl+alt+shift+up=new_split:up
keybind = ctrl+alt+shift+down=new_split:down
keybind = ctrl+alt+shift+right=new_split:right
keybind = ctrl+alt+shift+left=new_split:left
# BIND: SURFACE (CURRENT SPLIT/WINDOW) -----------------------------------------
keybind = super+ctrl+alt+w=unbind
keybind = ctrl+alt+w=close_surface
# BIND: WINDOW / SURFACE -------------------------------------------------------
# Same modifier as splits; binds that are not pane grid operations.
keybind = unconsumed:ctrl+l=clear_screen
keybind = super+ctrl+alt+n=unbind
keybind = super+ctrl+alt+enter=unbind
keybind = super+ctrl+alt+q=unbind
keybind = ctrl+alt+n=new_window
keybind = ctrl+alt+enter=toggle_fullscreen
keybind = ctrl+alt+q=quit
# BIND: INSPECTOR --------------------------------------------------------------
keybind = super+ctrl+alt+i=unbind
keybind = ctrl+alt+i=inspector:toggle
# BIND: RELOAD CONFIG ----------------------------------------------------------
keybind = super+ctrl+alt+comma=unbind
keybind = ctrl+alt+comma=reload_config
# BIND: PASTE FROM SELECTION --------------------------------------------------
# keybind = performable:super+ctrl+alt+v=paste_from_selection
# QUICK TERMINAL ---------------------------------------------------------------
# https://ghostty.org/docs/config/reference#quick-terminal-position
keybind = super+ctrl+alt+t=unbind
keybind = global:ctrl+alt+t=toggle_quick_terminal
# COMMAND PALETTE --------------------------------------------------------------
keybind = super+ctrl+alt+p=unbind
keybind = ctrl+alt+p=toggle_command_palette
# BIND: CLAUDE CODE: SHIFT+ENTER ----------------------------------------------
keybind = shift+enter=text:/n
config-file = ?auto/theme.ghostty
