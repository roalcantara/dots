# Every user package. Installed by the post-packages hook in
# config/mise/conf.d/bootstrap.toml; `brew bundle …` reads it through HOMEBREW_BUNDLE_FILE.
# HOMEBREW_DOTS_PROFILE is the mise profile list (brew passes only HOMEBREW_* variables to a Brewfile):
# container gets the first group; desktop (the default, what `install` sets up) everything down to DEVTOOLS;
# dev (`mise run setup dev`: desktop,dev) everything.
profiles = ENV.fetch("HOMEBREW_DOTS_PROFILE", "desktop").split(",").map(&:strip)
dev = profiles.include?("dev")
desktop = dev || profiles.include?("desktop")

# No `tap` lines: brew bundle taps a third-party tap when an entry names it in full (user/tap/name). A `tap` line
# would tap it in every profile, while that entry's `trusted: true` applies only in its own profile, so brew warns
# "taps are not trusted" (can1357/tap on desktop, where omp is not listed).

# Everywhere, containers included: the minimal shell set
brew "zoxide"
brew "fzf"
brew "eza"
brew "bat"
brew "ripgrep"
brew "fd"
brew "jq"
brew "neovim"
brew "mise"
brew "git-delta"

# Desktop only below. `brew bundle add` appends here, so new packages are desktop-only unless moved up.
return unless desktop

# Desktop: formulae
