#!/usr/bin/env bash

set -euo pipefail

# Neovim Startup Analysis Script
# Analyzes the startup.csv file generated by benchmark
#
# Usage: analyzer [options]
#
# Options
#   -h, --help             Show this help message
#
# Key Features
#   - Comprehensive Data Collection: Captures all the metrics you specified plus additional useful ones
#   - Multiple Run Averaging: Reduces measurement noise by averaging multiple runs
#   - Detailed Log Analysis: Parses startup logs to categorize timing by component type
#   - Cross-Platform: Works on macOS, Linux, and containers
#   - Git Integration: Tracks configuration changes via commit hash and file hash
#   - Extensible: Easy to add new metrics or modify existing ones
#
# Workflow
#   1. chmod +x benchmark analyzer         # Make it executable first
#   2. benchmark -r 10                     # Run the benchmark targeting ~/.config/nvim
#   3. analyzer summary                    # Show summary statistics and recent benchmarks
#   4. analyzer recent 10                  # Show last 10 benchmarks
#   5. analyzer trends                     # Show performance trends over time
#   6. analyzer compare abc123 def456      # Compare two configurations
#   7. analyzer export json               # Export data to JSON
#   8. analyzer export summary            # Export data to summary
#
# Examples
#   chmod +x benchmark analyzer         # Make it executable first
#   benchmark -r 20                     # Run the benchmark targeting ~/.config/nvim
#   analyzer summary                    # Show summary statistics and recent benchmarks

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
CSV_FILE="$CONFIG_DIR/etc/logs/startup.csv"
USE_GUM=true

# Check if gum is available
if ! command -v gum >/dev/null 2>&1; then
  USE_GUM=false
fi

# Check if CSV exists
if [[ ! -f "$CSV_FILE" ]]; then
  if [[ "$USE_GUM" == "true" ]]; then
    gum log --level error "CSV file not found at $CSV_FILE"
    gum log --level info "Run nvim-benchmark.sh first to generate data."
  else
    echo "Error: CSV file not found at $CSV_FILE"
    echo "Run nvim-benchmark.sh first to generate data."
  fi
  exit 1
fi

# Logging function
log_info() {
  if [[ "$USE_GUM" == "true" ]]; then
    gum log --time DateTime --level info "$1"
  else
    echo "INFO: $1"
  fi
}

log_error() {
  if [[ "$USE_GUM" == "true" ]]; then
    gum log --time DateTime --level error "$1"
  else
    echo "ERROR: $1"
  fi
}

# Spinner wrapper function
with_spinner() {
  local title="$1"
  local cmd="$2"

  if [[ "$USE_GUM" == "true" ]]; then
    gum spin --spinner dot --title "$title" -- bash -c "$cmd"
  else
    echo "$title"
    bash -c "$cmd"
  fi
}

# Function to select configuration interactively
select_config() {
  local prompt="$1"
  local configs=$(tail -n 50 "$CSV_FILE" | cut -d',' -f17 | sort | uniq | grep -v '^$')
  local config=""

  if [[ -z "$configs" ]]; then
    log_error "No configurations found in recent data"
    return 1
  fi

  # Method 1: Try gum choose
  if command -v gum >/dev/null 2>&1; then
    config=$(echo "$configs" | gum choose --header "$prompt")

  # Method 2: Try fzf
  elif command -v fzf >/dev/null 2>&1; then
    config=$(echo "$configs" | fzf --prompt "$prompt > " --height 10 --border --info=inline)

  # Method 3: Fallback to manual input with list
  else
    echo "$prompt"
    echo "Available configurations:"
    echo "$configs" | nl -w2 -s'. '
    echo ""
    read -rp "Enter configuration hash: " config

    # Validate that the entered config exists
    if ! echo "$configs" | grep -q "^$config$"; then
      echo "Warning: Configuration '$config' not found in recent data"
      read -rp "Continue anyway? (y/N): " confirm
      if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        return 1
      fi
    fi
  fi

  echo "$config"
}

# Function to show recent benchmarks
show_recent() {
  local count=${1:-10}

  if [[ "$USE_GUM" == "true" ]]; then
    gum format "## 📊 Recent $count Benchmarks"
    echo ""

    # Create table data
    {
      echo "TIMESTAMP,DURATION,TOTAL_MS,PLUGINS,CONFIG"
      tail -n "$count" "$CSV_FILE" | awk -F',' '{
                printf "%s,%sms,%sms,%s,%s\n", $1, $2, $13, $6, substr($17,1,8)
            }'
    } | gum table --widths 20,10,10,8,10 --height $((count + 3))
  else
    echo "=== Recent $count Benchmarks ==="
    echo "TIMESTAMP              DURATION  TOTAL_MS  PLUGINS  CONFIG"
    echo "────────────────────── ────────  ────────  ───────  ──────"
    tail -n "$count" "$CSV_FILE" | awk -F',' '{
            printf "%-20s %6sms  %6sms  %7s  %s\n", $1, $2, $13, $6, substr($17,1,8)
        }'
  fi
}

# Function to show performance trends
show_trends() {
  if [[ "$USE_GUM" == "true" ]]; then
    gum format "## 📈 Performance Trends"
    echo ""
    gum format "**Daily Averages (last 7 days):**"
    echo ""

    # Generate trend data
    {
      echo "DATE,COUNT,AVG_DURATION,AVG_TOTAL"
      tail -n 100 "$CSV_FILE" | awk -F',' '{
                date = substr($1, 1, 10)
                duration[date] += $2
                total[date] += $13
                count[date]++
            }
            END {
                for (d in count) {
                    printf "%s,%d,%.1fms,%.1fms\n", d, count[d], duration[d]/count[d], total[d]/count[d]
                }
            }' | sort -k1 | tail -7
    } | gum table --widths 12,8,15,12 --height 10
  else
    echo "=== Performance Trends ==="
    echo "Daily Averages (last 7 days):"
    echo "DATE       COUNT  AVG_DURATION  AVG_TOTAL"
    echo "────────── ─────  ────────────  ─────────"
    tail -n 100 "$CSV_FILE" | awk -F',' '{
            date = substr($1, 1, 10)
            duration[date] += $2
            total[date] += $13
            count[date]++
        }
        END {
            for (d in count) {
                printf "%-10s %5d  %9.1fms  %7.1fms\n", d, count[d], duration[d]/count[d], total[d]/count[d]
            }
        }' | sort -k1 | tail -7
  fi
}

# Function to show slowest operations
show_slowest() {
  if [[ "$USE_GUM" == "true" ]]; then
    gum format "## 🐌 Most Common Slow Operations"
    echo ""

    local temp_file=$(mktemp)
    tail -n 50 "$CSV_FILE" | cut -d',' -f14 |
      sed 's/; /\n/g' |
      sort | uniq -c | sort -nr | head -10 |
      awk '{$1=$1; print NR","$0}' >"$temp_file"

    {
      echo "RANK,COUNT,OPERATION"
      cat "$temp_file"
    } | gum table --widths 5,8,60 --height 13

    rm "$temp_file"
  else
    echo "=== Most Common Slow Operations ==="
    tail -n 50 "$CSV_FILE" | cut -d',' -f14 |
      sed 's/; /\n/g' |
      sort | uniq -c | sort -nr | head -10 |
      awk '{$1=$1; print NR". "$0}'
  fi
}

# Function to show config impact
show_config_impact() {
  if [[ "$USE_GUM" == "true" ]]; then
    gum format "## ⚙️ Configuration Impact"
    echo ""

    local temp_file=$(mktemp)
    tail -n 100 "$CSV_FILE" | awk -F',' '{
            config = substr($17, 1, 8)
            duration[config] += $2
            total[config] += $13
            count[config]++
        }
        END {
            for (c in count) {
                printf "%s,%d,%.1fms,%.1fms\n", c, count[c], duration[c]/count[c], total[c]/count[c]
            }
        }' | sort -k3 -n >"$temp_file"

    {
      echo "CONFIG,COUNT,AVG_DURATION,AVG_TOTAL"
      cat "$temp_file"
    } | gum table --widths 10,8,15,12 --height 12

    rm "$temp_file"
  else
    echo "=== Configuration Impact ==="
    echo "CONFIG    COUNT  AVG_DURATION  AVG_TOTAL"
    echo "────────  ─────  ────────────  ─────────"
    tail -n 100 "$CSV_FILE" | awk -F',' '{
            config = substr($17, 1, 8)
            duration[config] += $2
            total[config] += $13
            count[config]++
        }
        END {
            for (c in count) {
                printf "%-8s  %5d  %9.1fms  %7.1fms\n", c, count[c], duration[c]/count[c], total[c]/count[c]
            }
        }' | sort -k3 -n
  fi
}

# Function to compare configurations
compare_configs() {
  local config1="$1"
  local config2="$2"

  if [[ "$USE_GUM" == "true" ]]; then
    gum format "## ⚖️ Comparing Configurations"
    echo ""
    gum format "**Config 1:** \`$config1\`"
    gum format "**Config 2:** \`$config2\`"
    echo ""

    # Generate comparison data
    local temp_result=$(mktemp)
    awk -F',' -v c1="$config1" -v c2="$config2" '
        $17 == c1 {
            c1_duration += $2; c1_total += $13; c1_count++
        }
        $17 == c2 {
            c2_duration += $2; c2_total += $13; c2_count++
        }
        END {
            if (c1_count > 0 && c2_count > 0) {
                c1_avg_dur = c1_duration / c1_count
                c1_avg_total = c1_total / c1_count
                c2_avg_dur = c2_duration / c2_count
                c2_avg_total = c2_total / c2_count
                
                printf "Avg Duration,%.1fms,%.1fms,%+.1fms\n", c1_avg_dur, c2_avg_dur, c2_avg_dur - c1_avg_dur
                printf "Avg Total,%.1fms,%.1fms,%+.1fms\n", c1_avg_total, c2_avg_total, c2_avg_total - c1_avg_total
                printf "Sample Count,%d,%d,%+d\n", c1_count, c2_count, c2_count - c1_count
                
                improvement = ((c1_avg_total - c2_avg_total) / c1_avg_total) * 100
                printf "IMPROVEMENT,%.1f%%\n", improvement
            } else {
                printf "ERROR,One or both configurations not found\n"
            }
        }' "$CSV_FILE" >"$temp_result"

    if grep -q "ERROR" "$temp_result"; then
      gum log --level error "One or both configurations not found in data"
    else
      {
        echo "METRIC,CONFIG1,CONFIG2,DIFFERENCE"
        head -3 "$temp_result"
      } | gum table --widths 15,12,12,15 --height 6

      local improvement=$(tail -1 "$temp_result" | cut -d',' -f2)
      echo ""
      if (($(echo "$improvement > 0" | bc -l))); then
        gum format "✅ **Config 2 is ${improvement}% faster**"
      else
        gum format "❌ **Config 2 is $(echo "${improvement#-}" | bc)% slower**"
      fi
    fi

    rm "$temp_result"
  else
    echo "=== Comparing Configurations ==="
    echo "Config 1: $config1"
    echo "Config 2: $config2"
    echo ""

    # Get stats for each config
    awk -F',' -v c1="$config1" -v c2="$config2" '
        $17 == c1 {
            c1_duration += $2; c1_total += $13; c1_count++
        }
        $17 == c2 {
            c2_duration += $2; c2_total += $13; c2_count++
        }
        END {
            if (c1_count > 0 && c2_count > 0) {
                c1_avg_dur = c1_duration / c1_count
                c1_avg_total = c1_total / c1_count
                c2_avg_dur = c2_duration / c2_count
                c2_avg_total = c2_total / c2_count
                
                print "                 CONFIG1    CONFIG2    DIFFERENCE"
                print "               ─────────  ─────────  ──────────"
                printf "Avg Duration:  %7.1fms  %7.1fms  %+7.1fms\n", c1_avg_dur, c2_avg_dur, c2_avg_dur - c1_avg_dur
                printf "Avg Total:     %7.1fms  %7.1fms  %+7.1fms\n", c1_avg_total, c2_avg_total, c2_avg_total - c1_avg_total
                printf "Sample Count:  %9d  %9d\n", c1_count, c2_count
                
                improvement = ((c1_avg_total - c2_avg_total) / c1_avg_total) * 100
                if (improvement > 0) {
                    printf "\n✅ Config 2 is %.1f%% faster\n", improvement
                } else {
                    printf "\n❌ Config 2 is %.1f%% slower\n", -improvement
                }
            } else {
                print "Error: One or both configurations not found in data"
            }
        }' "$CSV_FILE"
  fi
}

# Enhanced compare function with interactive selection
compare_configs_interactive() {
  local config1=""
  local config2=""

  if [[ "$USE_GUM" == "true" ]]; then
    gum format "## ⚖️ Configuration Comparison"
    echo ""
    gum format "Select two configurations to compare performance:"
    echo ""
  else
    echo "=== Configuration Comparison ==="
    echo "Select two configurations to compare performance:"
    echo ""
  fi

  # Select first configuration
  config1=$(select_config "Select first configuration:")
  if [[ -z "$config1" ]]; then
    log_error "No first configuration selected"
    return 1
  fi

  if [[ "$USE_GUM" == "true" ]]; then
    gum log --level info "First configuration: $config1"
  else
    echo "First configuration: $config1"
  fi

  # Select second configuration
  config2=$(select_config "Select second configuration:")
  if [[ -z "$config2" ]]; then
    log_error "No second configuration selected"
    return 1
  fi

  if [[ "$USE_GUM" == "true" ]]; then
    gum log --level info "Second configuration: $config2"
    echo ""
  else
    echo "Second configuration: $config2"
    echo ""
  fi

  # Prevent comparing the same configuration
  if [[ "$config1" == "$config2" ]]; then
    log_error "Cannot compare a configuration with itself"
    return 1
  fi

  # Run the comparison
  compare_configs "$config1" "$config2"
}

# Function to export for external analysis
export_data() {
  local format="$1"
  case "$format" in
  json)
    if [[ "$USE_GUM" == "true" ]]; then
      gum format "## 📤 Exporting to JSON"
    else
      echo "=== Exporting to JSON ==="
    fi
    awk -F',' 'NR==1 {
                # Store headers
                for(i=1; i<=NF; i++) headers[i] = $i
                next
            }
            NR>1 {
                printf "{"
                for(i=1; i<=NF; i++) {
                    if(i>1) printf ","
                    printf "\"%s\":\"%s\"", headers[i], $i
                }
                printf "}\n"
            }' "$CSV_FILE"
    ;;
  summary)
    if [[ "$USE_GUM" == "true" ]]; then
      gum format "## 📋 Summary Statistics"
      echo ""

      local temp_summary=$(mktemp)
      awk -F',' 'NR>1 {
                    duration += $2; total += $13; plugins += $6; lua_files += $7
                    count++
                    if (NR == 2) first_date = $1
                    last_date = $1
                }
                END {
                    printf "Total Benchmarks,%d\n", count
                    printf "Average Duration,%.1fms\n", duration/count
                    printf "Average Total Time,%.1fms\n", total/count
                    printf "Average Plugins,%.0f\n", plugins/count
                    printf "Average Lua Files,%.0f\n", lua_files/count
                    printf "First Benchmark,%s\n", first_date
                    printf "Last Benchmark,%s\n", last_date
                }' "$CSV_FILE" >"$temp_summary"

      {
        echo "METRIC,VALUE"
        cat "$temp_summary"
      } | gum table --widths 20,25 --height 10

      rm "$temp_summary"
    else
      echo "=== Summary Statistics ==="
      awk -F',' 'NR>1 {
                    duration += $2; total += $13; plugins += $6; lua_files += $7
                    count++
                }
                END {
                    printf "Total Benchmarks: %d\n", count
                    printf "Average Duration: %.1fms\n", duration/count
                    printf "Average Total Time: %.1fms\n", total/count
                    printf "Average Plugins: %.0f\n", plugins/count
                    printf "Average Lua Files: %.0f\n", lua_files/count
                    
                    printf "\nFirst Benchmark: "
                    system("head -n2 \"" FILENAME "\" | tail -n1 | cut -d\",\" -f1")
                    printf "Last Benchmark: "
                    system("tail -n1 \"" FILENAME "\" | cut -d\",\" -f1")
                }' "$CSV_FILE"
    fi
    ;;
  *)
    log_error "Unknown format: $format"
    if [[ "$USE_GUM" == "true" ]]; then
      gum format "Available formats: **json**, **summary**"
    else
      echo "Available formats: json, summary"
    fi
    ;;
  esac
}

# Interactive mode function
interactive_mode() {
  if [[ "$USE_GUM" != "true" ]]; then
    echo "Interactive mode requires gum. Please install gum or use command-line arguments."
    exit 1
  fi

  gum format "# 🚀 Neovim Startup Analyzer"
  echo ""
  gum format "**Data file:** \`$CSV_FILE\`"
  echo ""

  while true; do
    local choice=$(gum choose --height 12 \
      "📊 Show recent benchmarks" \
      "📈 Show performance trends" \
      "🐌 Show slowest operations" \
      "⚙️ Show configuration impact" \
      "⚖️ Compare configurations" \
      "📋 Export summary" \
      "📤 Export JSON" \
      "❌ Exit")

    echo ""
    case "$choice" in
    "📊 Show recent benchmarks")
      local count=$(gum input --placeholder "Number of recent benchmarks (default: 10)" --value "10")
      with_spinner "Loading recent benchmarks..." "show_recent ${count:-10}"
      ;;
    "📈 Show performance trends")
      with_spinner "Analyzing performance trends..." "show_trends"
      ;;
    "🐌 Show slowest operations")
      with_spinner "Finding slowest operations..." "show_slowest"
      ;;
    "⚙️ Show configuration impact")
      with_spinner "Analyzing configuration impact..." "show_config_impact"
      ;;
    "⚖️ Compare configurations")
      compare_configs_interactive
      ;;
    "📋 Export summary")
      with_spinner "Generating summary..." "export_data summary"
      ;;
    "📤 Export JSON")
      with_spinner "Exporting to JSON..." "export_data json"
      ;;
    "❌ Exit")
      gum format "👋 **Thanks for using Neovim Startup Analyzer!**"
      exit 0
      ;;
    esac
    echo ""
    gum confirm "Continue?" || break
  done
}

# Main function
main() {
  local command="${1:-interactive}"

  case "$command" in
  recent)
    with_spinner "Loading recent benchmarks..." "show_recent ${2:-10}"
    ;;
  trends)
    with_spinner "Analyzing performance trends..." "show_trends"
    ;;
  slowest)
    with_spinner "Finding slowest operations..." "show_slowest"
    ;;
  config-impact)
    with_spinner "Analyzing configuration impact..." "show_config_impact"
    ;;
  compare)
    if [[ $# -lt 3 ]]; then
      # Interactive mode - use the new selection function
      compare_configs_interactive
    else
      # Command line mode - use provided arguments
      with_spinner "Comparing configurations..." "compare_configs '$2' '$3'"
    fi
    ;;
  compare-interactive)
    # Force interactive selection even in command line mode
    compare_configs_interactive
    ;;
  export)
    export_data "${2:-summary}"
    ;;
  interactive)
    if [[ "$USE_GUM" == "true" ]]; then
      interactive_mode
    else
      # Fallback to summary if gum not available
      log_info "GUM not available, showing summary instead"
      export_data summary
      echo ""
      show_recent 5
      echo ""
      show_trends
    fi
    ;;
  summary)
    if [[ "$USE_GUM" == "true" ]]; then
      gum format "# 🚀 Neovim Startup Analysis"
      echo ""
      gum format "**Data file:** \`$CSV_FILE\`"
      echo ""
    else
      echo "=== Neovim Startup Analysis ==="
      echo "Data file: $CSV_FILE"
      echo ""
    fi

    with_spinner "Generating summary..." "export_data summary"
    echo ""
    with_spinner "Loading recent benchmarks..." "show_recent 5"
    echo ""
    with_spinner "Analyzing trends..." "show_trends"
    ;;
  *)
    if [[ "$USE_GUM" == "true" ]]; then
      gum format "# 🚀 Neovim Startup Analysis"
      echo ""
      gum format "**Data file:** \`$CSV_FILE\`"
      echo ""
    else
      echo "=== Neovim Startup Analysis ==="
      echo "Data file: $CSV_FILE"
      echo ""
    fi

    with_spinner "Generating summary..." "export_data summary"
    echo ""
    with_spinner "Loading recent benchmarks..." "show_recent 5"
    echo ""
    with_spinner "Analyzing trends..." "show_trends"
    ;;
  esac
}

