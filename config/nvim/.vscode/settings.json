{
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.fixAll": "always"
    }
  },
  "Lua.addonManager.enable": true,
  "Lua.codeLens.enable": true,
  "Lua.completion.enable": true,
  "Lua.completion.autoRequire": true,
  "Lua.completion.callSnippet": "Replace",
  "Lua.completion.displayContext": 1,
  "Lua.completion.keywordSnippet": "Replace",
  "Lua.completion.showWord": "Fallback",
  "Lua.completion.workspaceWord": true,
  "Lua.diagnostics.enable": true,
  "Lua.diagnostics.disable": [
    "undefined-doc-name",
    "missing-parameter",
    "different-requires",
    "no-unknown",
    "undefined-field",
    "redefined-local"
  ],
  "Lua.diagnostics.disableScheme": [
    "git"
  ],
  "Lua.diagnostics.globals": [
    "_",
    "_G",
    "after_each",
    "after",
    "After",
    "assert.are_not.equals",
    "assert.are.equal",
    "assert.are.equals",
    "assert.are.same",
    "assert.are",
    "assert.has_no.errors",
    "assert.has.errors",
    "assert.is_false",
    "assert.is_not_true",
    "assert.is_true",
    "assert.spy",
    "assert.stub",
    "assert.True",
    "before_each",
    "before",
    "Before",
    "cmp",
    "context",
    "coroutine",
    "describe",
    "describle",
    "error",
    "finally",
    "FzfLua",
    "getmetatable",
    "Given",
    "home",
    "hs",
    "inspect",
    "io",
    "ipairs",
    "it",
    "jit",
    "LazyVim",
    "lspconfig",
    "M",
    "math",
    "mock.revert",
    "neo",
    "next",
    "os",
    "package",
    "packer_plugins",
    "pairs",
    "pcall",
    "Pending",
    "print",
    "require",
    "select",
    "self",
    "setmetatable",
    "setup",
    "Snacks",
    "spy.new",
    "spy.on",
    "std",
    "string",
    "table",
    "teardown",
    "Then",
    "tonumber",
    "tostring",
    "type",
    "unpack",
    "vim.fs.joinpath",
    "vim",
    "Vim",
    "When",
    "mock",
    "stub",
    "spy"
  ],
  "Lua.diagnostics.globalsRegex": [],
  "Lua.diagnostics.groupFileStatus": {
    "ambiguity": "Opened",
    "await": "Opened",
    "codestyle": "Opened",
    "conventions": "Opened",
    "duplicate": "Opened",
    "global": "Opened",
    "luadoc": "Opened",
    "redefined": "Opened",
    "strict": "Opened",
    "strong": "Opened",
    "type-check": "Opened",
    "unbalanced": "Opened",
    "unused": "Opened"
  },
  "Lua.diagnostics.groupSeverity": {
    "ambiguity": "Fallback",
    "await": "Fallback",
    "codestyle": "Fallback",
    "conventions": "Fallback",
    "duplicate": "Fallback",
    "global": "Fallback",
    "luadoc": "Fallback",
    "redefined": "Fallback",
    "strict": "Fallback",
    "strong": "Fallback",
    "type-check": "Fallback",
    "unbalanced": "Fallback",
    "unused": "Fallback"
  },
  "Lua.diagnostics.ignoredFiles": "Disable",
  "Lua.diagnostics.libraryFiles": "Disable",
  "Lua.diagnostics.neededFileStatus": {
    "ambiguity-1": "Opened",
    "assign-type-mismatch": "Opened",
    "codestyle-check": "Opened"
  },
  "Lua.diagnostics.severity": {
    "ambiguity-1": "Error!",
    "assign-type-mismatch": "Error!",
    "name-style-check": "Hint",
    "no-unknown": "Hint",
    "spell-check": "Hint",
    "await-in-sync": "Hint",
    "unused-local": "Hint",
    "unused-function": "Hint",
    "unused-label": "Hint"
  },
  "Lua.diagnostics.unusedLocalExclude": [
    "_*"
  ],
  "Lua.diagnostics.workspaceDelay": 3000,
  "Lua.diagnostics.workspaceEvent": "OnSave",
  "Lua.diagnostics.workspaceRate": 100,
  "Lua.format.enable": true,
  "Lua.format.defaultConfig": {
    "indent_style": "space",
    "indent_size": "2",
    "quote_style": "single",
    "continuation_indent": "2"
  },
  "Lua.hint.arrayIndex": "Disable",
  "Lua.hint.await": true,
  "Lua.hint.awaitPropagate": false,
  "Lua.hint.enable": true,
  "Lua.hint.paramName": "All",
  "Lua.hint.paramType": true,
  "Lua.hint.semicolon": "Disable",
  "Lua.hint.setType": true,
  "Lua.hover.enable": true,
  "Lua.hover.enumsLimit": 20,
  "Lua.hover.expandAlias": true,
  "Lua.hover.previewFields": 50,
  "Lua.hover.viewNumber": true,
  "Lua.hover.viewString": true,
  "Lua.hover.viewStringMax": 1000,
  "Lua.language.completeAnnotation": true,
  "Lua.language.fixIndent": true,
  "Lua.nameStyle.config": {
    "json": ".",
    "lua": "."
  },
  "Lua.runtime.builtin": {
    "bit": "default",
    "coroutine": "default",
    "debug": "default",
    "io": "default",
    "jit": "default",
    "math": "default",
    "os": "default",
    "package": "default",
    "string": "default",
    "table": "default"
  },
  "Lua.runtime.fileEncoding": "utf8",
  "Lua.runtime.meta": "${version} ${language} ${encoding}",
  "Lua.runtime.nonstandardSymbol": [],
  "Lua.runtime.path": [
    "lua/?.lua",
    "lua/?/init.lua",
    "?.lua",
    "?/init.lua",
    "/opt/homebrew/share/nvim/runtime/lua/?.lua",
    "/opt/homebrew/share/nvim/runtime/lua/?/init.lua",
    "/opt/homebrew/share/nvim/runtime/lua/vim/?.lua",
    "/usr/local/share/nvim/runtime/lua/?.lua",
    "/usr/local/share/nvim/runtime/lua/?/init.lua",
    "/usr/local/share/nvim/runtime/lua/vim/?.lua",
    "/opt/local/share/nvim/runtime/lua/?.lua",
    "/opt/local/share/nvim/runtime/lua/?/init.lua",
    "/opt/local/share/nvim/runtime/lua/vim/?.lua",
    "~/.local/share/nvim/lazy/LazyVim/lua/?.lua",
    "~/.local/share/nvim/lazy/LazyVim/lua/?/init.lua",
    "~/.local/share/nvim/lazy/*/lua/?.lua",
    "~/.local/share/nvim/lazy/*/lua/?/init.lua",
    "~/.local/share/nvim/mason/packages/*/lua/?.lua",
    "~/.local/share/nvim/mason/packages/*/lua/?/init.lua"
  ],
  "Lua.runtime.pathStrict": false,
  "Lua.runtime.pluginArgs": [],
  "Lua.runtime.special": {
    "include": "require",
    "vim": "require"
  },
  "Lua.runtime.unicodeName": false,
  "Lua.runtime.version": "LuaJIT",
  "Lua.semantic.enable": true,
  "Lua.semantic.annotation": true,
  "Lua.semantic.keyword": false,
  "Lua.semantic.variable": true,
  "Lua.signatureHelp.enable": false,
  "Lua.type.castNumberToInteger": true,
  "Lua.type.checkTableShape": true,
  "Lua.type.inferParamType": true,
  "Lua.type.inferTableSize": 10,
  "Lua.type.weakNilCheck": true,
  "Lua.type.weakUnionCheck": true,
  "Lua.typeFormat.config": {},
  "Lua.window.progressBar": true,
  "Lua.window.statusBar": true,
  "Lua.workspace.checkThirdParty": false,
  "Lua.workspace.ignoreSubmodules": true,
  "Lua.workspace.maxPreload": 2000,
  "Lua.workspace.preloadFileSize": 1000,
  "Lua.workspace.useGitIgnore": true,
