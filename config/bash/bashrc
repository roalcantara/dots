# shellcheck shell=bash disable=SC1090,SC1091
# https://gnu.org/savannah-checkouts/gnu/bash/manual/bash.html#Bash-Startup-Files

# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# Contains commands that should run every time a new shell is launched - aliases, functions, custom prompts, history customizations..
# https://linuxize.com/post/bashrc-vs-bash-profile

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

# append to the history file, don't overwrite it
shopt -s histappend

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
shopt -s globstar

# Load XDG environment variables from .profile
if [ -f $HOME/.profile ]; then
  source $HOME/.profile
fi

# THEME {
  # The theme in the dots config file (config/dots/config.toml): `name` for every tool, `eza` optionally for eza's and
  # ls's colours. The same small reader as config/theme/config.zsh, in bash; without the file, the theme link.
  # eza prefers EZA_COLORS/EXA_COLORS to the theme's eza/theme.yml; drop any inherited from the pre-theme palette.
  unset EZA_COLORS EXA_COLORS LSCOLORS
  _dots_themes="${DOTS_THEMES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/theme/themes}"
  _dots_config="${DOTS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/dots/config.toml}"
  _dots_name="" _dots_eza="" _dots_section="" _dots_dir="" _dots_eza_dir=""
  if [ -r "$_dots_config" ]; then
    while IFS= read -r _dots_line || [ -n "$_dots_line" ]; do
      if [[ $_dots_line =~ ^[[:space:]]*\[([^]]+)\][[:space:]]*(#.*)?$ ]]; then
        _dots_section="${BASH_REMATCH[1]//[[:space:]]/}"
      elif [ "$_dots_section" = theme ] && [[ $_dots_line =~ ^[[:space:]]*(name|eza)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]]; then
        if [ "${BASH_REMATCH[1]}" = name ]; then _dots_name="${BASH_REMATCH[2]}"; else _dots_eza="${BASH_REMATCH[2]}"; fi
      fi
    done < "$_dots_config"
    [ -n "$_dots_name" ] && [ -r "$_dots_themes/$_dots_name/env.bash" ] && _dots_dir="$_dots_themes/$_dots_name"
    [ -n "$_dots_eza" ] && [ -r "$_dots_themes/$_dots_eza/eza.sh" ] && _dots_eza_dir="$_dots_themes/$_dots_eza"
  else
    _dots_link="${DOTS_THEME_LINK:-${XDG_STATE_HOME:-$HOME/.local/state}/dots/theme/current}"
    [ -r "$_dots_link/env.bash" ] && _dots_dir="$_dots_link"
  fi
  if [ -n "$_dots_dir" ]; then
    export DOTS_THEME_DIR="$_dots_dir" DOTS_EZA_DIR="${_dots_eza_dir:-$_dots_dir}"
    . "$_dots_dir/env.bash"
    [ -r "$DOTS_EZA_DIR/eza.sh" ] && . "$DOTS_EZA_DIR/eza.sh"
  fi
  unset _dots_themes _dots_config _dots_name _dots_eza _dots_section _dots_dir _dots_eza_dir _dots_line _dots_link
# }

# PATH; Where the shell searches for commands; set PATH so it includes user's private bin if it exists
# cargo installs (brew bundle `cargo` entries) go to $CARGO_HOME/bin; last, so its rustup proxies never shadow `cargo`.
export PATH="${XDG_LOCAL_BIN_DIR:-$HOME/.local/bin}:${NPM_CONFIG_PREFIX:-$XDG_DATA_HOME/npm/bin}:${PNPM_HOME:-$XDG_DATA_HOME/pnpm}:/usr/local/bin:/usr/local/sbin:${PATH}:${CARGO_HOME:-$XDG_DATA_HOME/cargo}/bin"

: "${HOMEBREW_PREFIX:=${HOMEBREW_PREFIX:-$(
  if [ -d /opt/homebrew ]; then
    echo "/opt/homebrew"
  elif [ -d /home/linuxbrew/.linuxbrew ]; then
    echo "/home/linuxbrew/.linuxbrew"
  else
    echo "/usr/local"
  fi
)}}"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
  debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
xterm-color | *-256color) color_prompt=yes ;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
  if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
    # We have color support; assume it's compliant with Ecma-48
    # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
    # a case would tend to support setf rather than setaf.)
    color_prompt=yes
  else
    color_prompt=
  fi
fi

if [ "$color_prompt" = yes ]; then
  PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
  PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm* | rxvt*) PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1" ;;
*) ;;
esac

# colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# Homebrew (installed by mise bootstrap)
if ! command -v brew >/dev/null && [ -x "$HOMEBREW_PREFIX/bin/brew" ]; then
  eval "$("$HOMEBREW_PREFIX"/bin/brew shellenv)"
fi
export HOMEBREW_BUNDLE_FILE="$HOME/.local/share/dots/config/homebrew/Brewfile"

# GOMI {
  # `rm` sends files to a restorable trash instead of deleting them.
  # The real rm is `\rm` or `command rm`; scripts and `bash -c` keep it.
  # https://gomi.dev
  if command -v gomi >/dev/null; then
    alias rm=gomi
  fi
# }

# MISE | https://mise.jdx.dev/ {
  if command -v mise >/dev/null; then
    eval "$(mise activate bash)"
  fi
# }

# EDITOR {
  # Set default editor to nvim, vim or vi
  # https://neovim.io/doc/user/starting.html#config
  if command -v nvim >/dev/null; then
    export EDITOR=${EDITOR:-"$(command -v nvim)"}
    export VIM_PATH=${VIM_PATH:-$XDG_CONFIG_HOME/nvim}
    export MYVIMRC=${MYVIMRC:-$VIM_PATH/init.lua}
    export NVIM_LOG_FILE=${NVIM_LOG_FILE:-$XDG_CACHE_HOME/nvim/.nvimlog}
    alias vim=nvim
    alias vi=nvim
  else
    export EDITOR=${EDITOR:-"$(command -v vim || command -v vi)"}
    alias vi=vim
  fi
  export VISUAL=${VISUAL:-$EDITOR}
  export SUDO_EDITOR=${SUDO_EDITOR:-$EDITOR}
  export GIT_EDITOR=${GIT_EDITOR:-"$EDITOR -c 'startinsert'"}
  export LAUNCH_EDITOR=${LAUNCH_EDITOR:-$EDITOR}
# }

# TERM {
  if [ "$TERM_PROGRAM" = "ghostty" ]; then
    if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
      builtin source "$GHOSTTY_RESOURCES_DIR"/shell-integration/bash/ghostty.bash
    fi
    export SNACKS_GHOSTTY=true
  elif [[ "$TERM_PROGRAM" == "vscode" ]] && command -v code >/dev/null; then
    builtin source "$(code --locate-shell-integration-path bash)"
  fi
  export TERM="${TERM:-xterm-256color}"
# }
