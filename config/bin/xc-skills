#USAGE cmd "__preview" hide=#true help="Internal preview helper" {
#USAGE   arg "[target]" help="Target path to preview"
#USAGE }
#USAGE cmd "__clip" hide=#true help="Internal clipboard helper"
#USAGE cmd "sync" help="Mirror symlinks from source to one or more target or agent paths" {
#USAGE   flag "--dry-run" help="Print actions without making filesystem changes"
#USAGE   flag "--prune" help="Remove destination symlinks not present in source"
#USAGE   flag "-s --source <PATH>" help="Source directory (default: ~/.claude/skills)"
#USAGE   flag "-a --agent <agent>..." help="Agent name; resolved via lookup table (repeatable)"
#USAGE   flag "-t --target <path>..." help="Target directory path (repeatable)"
#USAGE   flag "-l --local" help="Use project/local path instead of global path for agents"
#USAGE   example "xc-skills sync"
#USAGE   example "xc-skills sync --dry-run"
#USAGE   example "xc-skills sync --prune"
#USAGE   example "xc-skills sync -s ~/.claude/skills -a antigravity"
#USAGE   example "xc-skills sync -s ~/.claude/skills -t ~/.gemini/antigravity/skills --dry-run --prune"
#USAGE }
#USAGE cmd "collect" help="Bring regular files from agent dirs into source; replace with symlinks" {
#USAGE   flag "--dry-run" help="Print actions without making filesystem changes"
#USAGE   flag "-s --source <PATH>" help="Source directory (default: ~/.agents/skills)"
#USAGE   flag "-a --agent <agent>..." help="Agent name; resolved via lookup table (repeatable)"
#USAGE   flag "-t --target <path>..." help="Target directory path (repeatable)"
#USAGE   flag "-l --local" help="Use project/local path instead of global path for agents"
#USAGE   example "xc-skills collect --dry-run"
#USAGE }

SCRIPT_NAME="${0##*/}"
declare SCRIPT_PATH
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
  SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
else
  SCRIPT_PATH="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)/$(basename "$0")"
fi

# ── helpers ───────────────────────────────────────────────────────────────────

log() { printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
err() { printf 'ERROR: %s\n' "$*" >&2; }

usage() {
  command usage bash "$SCRIPT_PATH" --help
}

_copy_to_clipboard() {
  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
    wl-copy
  elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
  elif [[ -n "${DISPLAY:-}" ]] && command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --input
  else
    local data
    data="$(base64 | tr -d '\n')"
    printf '\e]52;c;%s\a' "$data" >/dev/tty
  fi
}

_preview_skill() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    return 0
  fi

  local file=""
  if [[ -f "$target/SKILL.md" ]]; then
    file="$target/SKILL.md"
  elif [[ -f "$target" ]]; then
    file="$target"
  elif [[ -f "$target/README.md" ]]; then
    file="$target/README.md"
  fi

  if [[ -n "$file" && -f "$file" ]]; then
    if command -v glow >/dev/null 2>&1; then
      glow -s dracula "$file" </dev/null
    elif command -v bat >/dev/null 2>&1; then
      bat --color=always -l md --paging=never "$file"
    else
      cat "$file"
    fi
  elif [[ -d "$target" ]]; then
    echo "No SKILL.md found in $target"
    echo ""
    ls -la "$target"
  else
    echo "Target not found: $target"
  fi
}

run_cmd() {
  if ((dry_run)); then
    printf '[dry-run] '
    printf '%q ' "$@"
    printf '\n'
  else
    "$@"
  fi
}

