# ── agent path resolver ───────────────────────────────────────────────────────
# Outputs the resolved path for a given agent name.
# Usage: resolve_agent_path <agent> <local_flag> <pwd>
# Prints the path to stdout; exits 1 if agent is unknown.
resolve_agent_path() {
  local agent="$1"
  local local_flag="$2"
  local base_pwd="$3"

  if ((local_flag)); then
    if [[ -z "${AGENT_PROJECT_PATH[$agent]+set}" ]]; then
      err "Unknown agent: $agent"
      return 1
    fi
    printf '%s/%s\n' "$base_pwd" "${AGENT_PROJECT_PATH[$agent]}"
  else
    if [[ -z "${AGENT_GLOBAL_PATH[$agent]+set}" ]]; then
      err "Unknown agent: $agent"
      return 1
    fi
    printf '%s/%s\n' "$HOME" "${AGENT_GLOBAL_PATH[$agent]}"
  fi
}

# ── ls command ────────────────────────────────────────────────────────────────

cmd_ls() {
  local local_flag=0
  local raw=0
  local explicit_source=""

  while (($# > 0)); do
    case "$1" in
      -l|--local) local_flag=1 ;;
      -r|--raw) raw=1 ;;
      -s|--source)
        shift
        if (($# == 0)); then err "--source requires a PATH argument"; usage >&2; exit 1; fi
        explicit_source="$1"
        ;;
      -*) err "Unknown option: $1"; usage >&2; exit 1 ;;
      *)  err "Unexpected argument: $1"; usage >&2; exit 1 ;;
    esac
    shift
  done

  local source_dir=""
  if [[ -n "$explicit_source" ]]; then
    source_dir="$explicit_source"
  elif ((local_flag)); then
    source_dir="$PWD/.agents/skills"
  else
    source_dir="$HOME/.agents/skills"
  fi

  if [[ ! -d "$source_dir" ]]; then
    err "Skills directory not found: $source_dir"
    exit 1
  fi

  shopt -s nullglob
  local -a entries=("$source_dir"/*)
  shopt -u nullglob

  local -a skills=()
  for entry in "${entries[@]}"; do
    local base="${entry##*/}"
    [[ "$base" == .* ]] && continue
    if [[ -d "$entry" || -f "$entry" ]]; then
      skills+=("$entry")
    fi
  done

  if [[ ${#skills[@]} -eq 0 ]]; then
    log "No skills found in $source_dir"
    exit 0
  fi

  if ((raw)) || [[ ! -t 1 || ! -t 0 ]]; then
    printf '%s\n' "${skills[@]}"
    exit 0
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    err "fzf is required for interactive mode. Use --raw for script output."
    exit 1
  fi

  local preview_cmd="\"$SCRIPT_PATH\" __preview {}"
  local header="↵ select  Tab multi  ^O edit  ^N copy-name  ^P copy-path  ^U update  Esc exit"

  local scope_flag="-g"
  ((local_flag)) && scope_flag="-p"

  local selected
  selected=$(printf '%s\n' "${skills[@]}" | fzf \
    --multi \
    --height="100%" \
    --header="$header" \
    --preview="$preview_cmd" \
    --preview-window="right:60%:wrap:border-rounded" \
    --bind="tab:toggle+down,btab:toggle+up" \
    --bind="ctrl-o:execute(sh -c 'files=(); for p in {+}; do [ -f \"\$p/SKILL.md\" ] && files+=(\"\$p/SKILL.md\") || files+=(\"\$p\"); done; \${EDITOR:-nvim} \"\${files[@]}\"' >/dev/tty)" \
    --bind="ctrl-n:execute-silent(sh -c 'for p in {+}; do basename \"\$p\"; done | \"$SCRIPT_PATH\" __clip')" \
    --bind="ctrl-p:execute-silent(sh -c 'for p in {+}; do echo \"\$p\" | sed \"s|^$HOME|~|\"; done | \"$SCRIPT_PATH\" __clip')" \
    --bind="ctrl-u:execute(sh -c 'names=(); for p in {+}; do names+=(\"\$(basename \"\$p\")\"); done; if command -v skills >/dev/null 2>&1; then echo \"Updating skills: \${names[*]}\"; command skills update $scope_flag \"\${names[@]}\"; else echo \"ERROR: skills CLI not found on PATH\"; fi; read -n1 -r -p \"Press any key to continue...\"' >/dev/tty)" \
  ) || true

  if [[ -n "$selected" ]]; then
    printf '%s\n' "$selected"
  fi
}

# ── sync command ──────────────────────────────────────────────────────────────

cmd_sync() {
  local dry_run=0
  local prune=0
  local local_flag=0
  local local_flag_count=0
  local explicit_source=""
  local explicit_source_count=0
  local agents=()
  local explicit_targets=()

  # Parse sync-specific arguments
  while (($# > 0)); do
    case "$1" in
      --dry-run)
        dry_run=1
        ;;
      --prune)
        prune=1
        ;;
      -s|--source)
        shift
        if (($# == 0)); then
          err "--source requires a PATH argument"
          usage >&2
          exit 1
        fi
        explicit_source_count=$((explicit_source_count + 1))
        if ((explicit_source_count > 1)); then
          err "--source can only be given once"
          exit 1
        fi
        explicit_source="$1"
        ;;
      -a|--agent)
        shift
        if (($# == 0)); then
          err "--agent requires a NAME argument"
          usage >&2
          exit 1
        fi
        agents+=("$1")
        ;;
      -t|--target)
        shift
        if (($# == 0)); then
          err "--target requires a PATH argument"
          usage >&2
          exit 1
        fi
        explicit_targets+=("$1")
        ;;
      -l|--local)
        local_flag_count=$((local_flag_count + 1))
        if ((local_flag_count > 1)); then
          err "--local can only be given once"
          exit 1
        fi
        local_flag=1
        ;;
      -*)
        err "Unknown option: $1"
        usage >&2
        exit 1
        ;;
      *)
        err "Unexpected argument: $1"
        usage >&2
        exit 1
        ;;
    esac
    shift
  done

  # ── resolve source directory ──────────────────────────────────────────────

  local source_dir=""
  if [[ -n "$explicit_source" ]]; then
    if [[ ! -d "$explicit_source" ]]; then
      err "Source directory not found: $explicit_source"
      exit 1
    fi
    source_dir="$explicit_source"
  else
    # Default: try ~/.claude/skills
    local default_source="$HOME/.claude/skills"
    if [[ -d "$default_source" ]]; then
      source_dir="$default_source"
    else
      err "No source skills directory found. Checked: $default_source"
      err "Use -s/--source to specify a source directory."
      exit 1
    fi
  fi

  # ── validate source has symlinks ─────────────────────────────────────────

  shopt -s nullglob
  local -a source_entries=("$source_dir"/*)
  shopt -u nullglob

  if [[ ${#source_entries[@]} -eq 0 ]]; then
    err "Source directory has no symlinks to sync: $source_dir"
    exit 1
  fi

  local has_symlinks=0
  for entry in "${source_entries[@]}"; do
    if [[ -L "$entry" ]]; then
      has_symlinks=1
      break
    fi
  done

  if ((!has_symlinks)); then
    err "Source directory has no symlinks to sync: $source_dir"
    exit 1
  fi

  # ── validate agent names if given ─────────────────────────────────────────

  local base_pwd="$PWD"
  for agent in "${agents[@]}"; do
    if ! resolve_agent_path "$agent" "$local_flag" "$base_pwd" >/dev/null 2>&1; then
      err "Unknown agent: $agent"
      exit 1
    fi
  done

  # ── build destination list ────────────────────────────────────────────────

  local -a destinations=()

  if [[ ${#agents[@]} -eq 0 && ${#explicit_targets[@]} -eq 0 ]]; then
    # Default destinations: all known agents (global or local based on -l)
    local table_ref
    if ((local_flag)); then
      declare -n table_ref=AGENT_PROJECT_PATH
    else
      declare -n table_ref=AGENT_GLOBAL_PATH
    fi
    for agent in "${!table_ref[@]}"; do
      local resolved
      resolved=$(resolve_agent_path "$agent" "$local_flag" "$base_pwd")
      destinations+=("$resolved")
    done
  else
    # Explicit destinations
    for agent in "${agents[@]}"; do
      local resolved
      resolved=$(resolve_agent_path "$agent" "$local_flag" "$base_pwd")
      destinations+=("$resolved")
    done
    for target in "${explicit_targets[@]}"; do
      destinations+=("$target")
    done
  fi

  # Deduplicate destinations
  local -A seen_dests=()
  local -a unique_destinations=()
  for dest in "${destinations[@]}"; do
    if [[ -z "${seen_dests[$dest]+set}" ]]; then
      seen_dests[$dest]=1
      unique_destinations+=("$dest")
    fi
  done

  # ── perform synchronization ───────────────────────────────────────────────

  local overall_errors=0

  for dest in "${unique_destinations[@]}"; do
    local created=0 replaced=0 unchanged=0 skipped_non_symlink=0 pruned=0 errors=0

    # Ensure destination directory exists
    if [[ ! -d "$dest" ]]; then
      if ! run_cmd /bin/mkdir -p "$dest"; then
        err "Cannot create destination directory: $dest"
        errors=$((errors + 1))
        overall_errors=$((overall_errors + 1))
        log "Destination: $dest | created=$created replaced=$replaced unchanged=$unchanged skipped_non_symlink=$skipped_non_symlink pruned=$pruned errors=$errors"
        continue
      fi
    fi

    # Ensure destination directory is writable
    if [[ ! -w "$dest" ]]; then
      warn "Destination directory is not writable, skipping: $dest"
      continue
    fi

    # Sync each symlink from source
    for src in "${source_entries[@]}"; do
      [[ -L "$src" ]] || continue

      local name="${src##*/}"
      local target
      target="$(/usr/bin/readlink "$src")"
      local out="$dest/$name"

      if [[ -e "$out" || -L "$out" ]]; then
        if [[ -L "$out" ]]; then
          local existing_target
          existing_target="$(/usr/bin/readlink "$out")"
          if [[ "$existing_target" == "$target" ]]; then
            unchanged=$((unchanged + 1))
            continue
          fi
          if run_cmd /bin/rm -f "$out"; then
            replaced=$((replaced + 1))
          else
            errors=$((errors + 1))
            overall_errors=$((overall_errors + 1))
            continue
          fi
        else
          skipped_non_symlink=$((skipped_non_symlink + 1))
          warn "Non-symlink exists, leaving untouched: $out"
          continue
        fi
      else
        created=$((created + 1))
      fi

      if ! run_cmd /bin/ln -s "$target" "$out"; then
        errors=$((errors + 1))
        overall_errors=$((overall_errors + 1))
      fi
    done

    if ((prune)); then
      shopt -s nullglob
      local -a dest_entries=("$dest"/*)
      shopt -u nullglob
      for entry in "${dest_entries[@]}"; do
        [[ -L "$entry" ]] || continue
        local entry_name="${entry##*/}"
        if [[ ! -L "$source_dir/$entry_name" ]]; then
          if run_cmd /bin/rm -f "$entry"; then
            pruned=$((pruned + 1))
          else
            errors=$((errors + 1))
            overall_errors=$((overall_errors + 1))
          fi
        fi
      done
    fi

    log "Destination: $dest | created=$created replaced=$replaced unchanged=$unchanged skipped_non_symlink=$skipped_non_symlink pruned=$pruned errors=$errors"
  done

  if ((overall_errors > 0)); then
    warn "Completed with $overall_errors operation error(s)."
    exit 2
  fi

  log "Synchronization completed successfully."
}

# ── collect command ────────────────────────────────────────────────────────────

cmd_collect() {
  local dry_run=0
  local local_flag=0
  local local_flag_count=0
  local explicit_source=""
  local explicit_source_count=0
  local agents=()
  local explicit_targets=()

  while (($# > 0)); do
    case "$1" in
      --dry-run) dry_run=1 ;;
      -s|--source)
        shift
        if (($# == 0)); then err "--source requires a PATH argument"; usage >&2; exit 1; fi
        explicit_source_count=$((explicit_source_count + 1))
        if ((explicit_source_count > 1)); then err "--source can only be given once"; exit 1; fi
        explicit_source="$1"
        ;;
      -a|--agent)
        shift
        if (($# == 0)); then err "--agent requires a NAME argument"; usage >&2; exit 1; fi
        agents+=("$1")
        ;;
      -t|--target)
        shift
        if (($# == 0)); then err "--target requires a PATH argument"; usage >&2; exit 1; fi
        explicit_targets+=("$1")
        ;;
      -l|--local)
        local_flag_count=$((local_flag_count + 1))
        if ((local_flag_count > 1)); then err "--local can only be given once"; exit 1; fi
        local_flag=1
        ;;
      -*) err "Unknown option: $1"; usage >&2; exit 1 ;;
      *)  err "Unexpected argument: $1"; usage >&2; exit 1 ;;
    esac
    shift
  done

  # ── resolve source ──────────────────────────────────────────────────────────

  local source_dir="${explicit_source:-$HOME/.agents/skills}"

  if ! run_cmd /bin/mkdir -p "$source_dir"; then
    err "Cannot create source directory: $source_dir"
    exit 1
  fi

  if [[ ! -w "$source_dir" ]]; then
    err "Source directory is not writable: $source_dir"
    exit 1
  fi

  # ── validate agents ─────────────────────────────────────────────────────────

  local base_pwd="$PWD"
  for agent in "${agents[@]}"; do
    if ! resolve_agent_path "$agent" "$local_flag" "$base_pwd" >/dev/null 2>&1; then
      err "Unknown agent: $agent"
      exit 1
    fi
  done

  # ── build inspection list ───────────────────────────────────────────────────

  local inspect_dirs=()

  if [[ ${#agents[@]} -eq 0 && ${#explicit_targets[@]} -eq 0 ]]; then
    # All known agents — global or local; skip absent dirs
    local table_ref
    if ((local_flag)); then
      declare -n table_ref=AGENT_PROJECT_PATH
    else
      declare -n table_ref=AGENT_GLOBAL_PATH
    fi
    for agent in "${!table_ref[@]}"; do
      local resolved
      resolved=$(resolve_agent_path "$agent" "$local_flag" "$base_pwd")
      [[ -d "$resolved" ]] && inspect_dirs+=("$resolved")
    done
  else
    for agent in "${agents[@]}"; do
      local resolved
      resolved=$(resolve_agent_path "$agent" "$local_flag" "$base_pwd")
      [[ -d "$resolved" ]] && inspect_dirs+=("$resolved")
    done
    for target in "${explicit_targets[@]}"; do
      [[ -d "$target" ]] && inspect_dirs+=("$target")
    done
  fi

  # ── collect ─────────────────────────────────────────────────────────────────

  local overall_errors=0

  for inspect_dir in "${inspect_dirs[@]}"; do
    local copied=0 linked=0 skipped_symlink=0 skipped_other=0 errors=0

    shopt -s nullglob
    local entries=("$inspect_dir"/*)
    shopt -u nullglob

    for entry in "${entries[@]}"; do
      local name="${entry##*/}"
      local src_file="$source_dir/$name"

      # Already a symlink — skip
      if [[ -L "$entry" ]]; then
        skipped_symlink=$((skipped_symlink + 1))
        continue
      fi

      # Not a regular file — skip with warning
      if [[ ! -f "$entry" ]]; then
        skipped_other=$((skipped_other + 1))
        warn "Not a regular file, skipping: $entry"
        continue
      fi

      # Copy to source if not already there
      if [[ ! -e "$src_file" ]]; then
        if run_cmd /bin/cp "$entry" "$src_file"; then
          copied=$((copied + 1))
        else
          errors=$((errors + 1)); overall_errors=$((overall_errors + 1))
          continue
        fi
      else
        warn "File already exists in source (skipping copy): $src_file"
        linked=$((linked + 1))
      fi

      # Remove original and create symlink
      if run_cmd /bin/rm -f "$entry" && run_cmd /bin/ln -s "$src_file" "$entry"; then
        :
      else
        errors=$((errors + 1)); overall_errors=$((overall_errors + 1))
      fi
    done

    log "Agent: $inspect_dir | copied=$copied linked=$linked skipped_symlink=$skipped_symlink skipped_other=$skipped_other errors=$errors"
  done

  if ((overall_errors > 0)); then
    warn "Completed with $overall_errors operation error(s)."
    exit 2
  fi

  log "Collection completed successfully."
}

# ── main ──────────────────────────────────────────────────────────────────────

main() {
  if (($# == 0)); then
    usage
    exit 1
  fi

  case "$1" in
    ls)      shift; cmd_ls "$@" ;;
    sync)    shift; cmd_sync "$@" ;;
    collect) shift; cmd_collect "$@" ;;
    __clip)    _copy_to_clipboard; exit 0 ;;
    __preview) shift; _preview_skill "$@"; exit 0 ;;
    -*) err "Unknown option: $1"; usage >&2; exit 1 ;;
    *)  err "Unknown subcommand: $1"; usage >&2; exit 1 ;;
  esac
}

main "$@"
