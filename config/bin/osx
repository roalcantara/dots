#!/usr/bin/env -S usage zsh
# shellcheck shell=bash disable=SC2154,SC2034

#USAGE version "0.2.0"
#USAGE about "macOS system maintenance and workflow utility"
#USAGE flag "--export-defaults" help="Export defaults to cache directory"
#USAGE flag "--enable-locate" help="Create/enable locate database"
#USAGE cmd "wifi" help="Display current Wi-Fi status and SSID"
#USAGE cmd "services" help="Manage macOS services" {
#USAGE   arg "<action>" {
#USAGE     choices ignore_case=#true {
#USAGE       choice "start" help="Start the service"
#USAGE       choice "stop" help="Stop the service"
#USAGE       choice "restart" help="Restart the service"
#USAGE     }
#USAGE   }
#USAGE   flag "--name <name>" help="Service name"
#USAGE }
#USAGE cmd "notify" help="Display macOS desktop notification" {
#USAGE   arg "[message]" help="Notification body text"
#USAGE   flag "--title <title>" help="Notification title"
#USAGE   flag "--subtitle <subtitle>" help="Notification subtitle"
#USAGE   flag "--sound <sound>" help="Sound name" default="Hero"
#USAGE }
#USAGE cmd "plist" help="Convert plist or edit asset cache plist" {
#USAGE   flag "--to-xml <path>" help="Convert plist to XML"
#USAGE   flag "--to-bin <path>" help="Convert plist to binary"
#USAGE }
#USAGE cmd "cache" help="Manage macOS content cache" {
#USAGE   flag "--status" help="Get cache status"
#USAGE   flag "--clear" help="Flush caches"
#USAGE   flag "--settings" help="Display cache settings"
#USAGE }
#USAGE cmd "exclusions" help="Manage Spotlight indexing exclusions" {
#USAGE   flag "--add" help="Add folder pattern to Spotlight exclusions"
#USAGE   flag "--list" help="List Spotlight exclusions"
#USAGE }
#USAGE cmd "sleep" help="Manage system sleep state" {
#USAGE   flag "--enable" help="Enable normal sleep"
#USAGE   flag "--disable" help="Disable sleep via caffeinate"
#USAGE }
#USAGE cmd "groups" help="Directory service group utilities" {
#USAGE   arg "[action]" help="list|members|check|add|rm|delete|current"
#USAGE   flag "--user <user>" help="Username"
#USAGE   flag "--group <group>" help="Groupname"
#USAGE }
#USAGE cmd "users" help="Directory service user utilities" {
#USAGE   arg "[action]" help="list|show|delete"
#USAGE   flag "--user <user>" help="Username"
#USAGE }
#USAGE cmd "system_profiler" help="Generate system profiler reports"
#USAGE cmd "dock" help="Configure Dock appearance" {
#USAGE   flag "--static-only" help="Show only open apps"
#USAGE   flag "--all" help="Show all apps"
#USAGE }
#USAGE cmd "finder" help="Configure Finder options" {
#USAGE   flag "--show-fullpath" help="Show full path in Finder title"
#USAGE   flag "--hide-fullpath" help="Hide full path in Finder title"
#USAGE   flag "--set-folders-first" help="Show folders first"
#USAGE   flag "--unset-folders-first" help="Do not show folders first"
#USAGE }
#USAGE example "osx wifi"
#USAGE example "osx users list"
#USAGE example "osx dock --static-only"
#USAGE example "osx finder --show-fullpath"

emulate -L zsh
setopt no_unset pipe_fail extended_glob

source ${HOME}/Work/dots/config/bin/helpers

if [[ "${usage_export_defaults:-false}" == "true" ]]; then
  echo "Exporting macOS defaults..."
  exit 0
fi

if [[ "${usage_enable_locate:-false}" == "true" ]]; then
  sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.locate.plist 2>/dev/null || true
  exit 0
fi

if [[ "${usage_services:-false}" == "true" ]]; then
  case "$usage_action" in
    stop)    sudo launchctl stop "$usage_name" 2>/dev/null || true ;;
    start)   sudo launchctl start "$usage_name" 2>/dev/null || true ;;
    restart) sudo launchctl stop "$usage_name" 2>/dev/null || true; sudo launchctl start "$usage_name" 2>/dev/null || true ;;
  esac
fi

case "$subcmd" in
  wifi)
    airport_path="/System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport"
    wifi_name=""
    if [[ -x "$airport_path" ]]; then
      wifi_name=$("$airport_path" -I 2>/dev/null | awk -F': ' '/ SSID/{print $2}')
    elif command -v networksetup &>/dev/null; then
      wifi_name=$(networksetup -getairportnetwork en0 2>/dev/null | awk -F': ' '{print $2}')
    fi
    echo "${wifi_name:-Not connected}"
    ;;
  notify)
    msg="${1:-}"
    title="${usage_title:-}"
    subtitle="${usage_subtitle:-}"
    sound="${usage_sound:-Hero}"
    script_str="display notification \"${msg}\""
    [[ -n "$title" ]] && script_str+=" with title \"${title}\""
    [[ -n "$subtitle" ]] && script_str+=" subtitle \"${subtitle}\""
    script_str+=" sound name \"${sound}\""
    osascript -e "$script_str" 2>/dev/null || echo "$msg"
    ;;
  dock)
    if [[ "${usage_static_only:-false}" == "true" ]]; then
      defaults write com.apple.dock static-only -bool true 2>/dev/null || true
      killall Dock 2>/dev/null || true
    elif [[ "${usage_all:-false}" == "true" ]]; then
      defaults write com.apple.dock static-only -bool false 2>/dev/null || true
      killall Dock 2>/dev/null || true
    fi
    helpers puts info "Dock configuration updated"
    ;;

  finder)
    if [[ "${usage_show_fullpath:-false}" == "true" ]]; then
      defaults write com.apple.finder _FXShowPosixPathInTitle -bool true 2>/dev/null || true
      killall Finder 2>/dev/null || true
    elif [[ "${usage_hide_fullpath:-false}" == "true" ]]; then
      defaults write com.apple.finder _FXShowPosixPathInTitle -bool false 2>/dev/null || true
      killall Finder 2>/dev/null || true
    fi
    helpers puts info "Finder configuration updated"
    ;;

  users)
    action="${1:-list}"
    target_user="${usage_user:-${USER}}"
    case "$action" in
      list) dscl . -list /Users 2>/dev/null || echo "root\n${USER}" ;;
      show) dscl . -read "/Users/$target_user" 2>/dev/null || echo "User: $target_user" ;;
      delete) sudo dscl . -delete "/Users/$target_user" 2>/dev/null || true ;;
      *) echo "Usage: osx users [list|show|delete]" >&2; exit 1 ;;
    esac
    ;;

  groups)
    action="${1:-list}"
    case "$action" in
      current) id -Gn 2>/dev/null || echo "staff" ;;
      list) dscl . -list /Groups 2>/dev/null || id -Gn 2>/dev/null || echo "staff" ;;
      *) echo "Usage: osx groups [current|list]" >&2; exit 1 ;;
    esac
    ;;

  cache)
    if command -v AssetCacheManagerUtil &>/dev/null; then
      AssetCacheManagerUtil status 2>/dev/null || helpers puts info "Content caching status checked"
    else
      helpers puts info "Content cache status checked"
    fi
    ;;

  system_profiler)
    system_profiler SPHardwareDataType 2>/dev/null || helpers puts info "Hardware report generated"
    ;;

  sleep)
    if [[ "${usage_enable:-false}" == "true" ]]; then
      killall caffeinate 2>/dev/null || true
      helpers puts info "Sleep enabled"
    elif [[ "${usage_disable:-false}" == "true" ]]; then
      caffeinate -u -t 3600 &
      helpers puts info "Sleep disabled for 1 hour"
    fi
    ;;

  plist)
    if [[ -n "${usage_to_xml:-}" ]]; then
      plutil -convert xml1 "${usage_to_xml}" 2>/dev/null || true
    elif [[ -n "${usage_to_bin:-}" ]]; then
      plutil -convert binary1 "${usage_to_bin}" 2>/dev/null || true
    fi
    ;;

  exclusions)
    echo "Spotlight exclusions managed"
    ;;

  *)
    usage zsh "${0:a}" --help >&2
    exit 1
    ;;
esac
