#? There is NO WARRANTY, to the extent permitted by law.
#? http://docopt.org · Command-line interface description language

##? xc-puts - Formats and prints a message
##?
##? Usage:
##?    xc-puts [-g|--green] [-r|--red] [-y|--yellow] [-b|--blue] [-d|--debug] [-e|--error] [-f|--fatal] [-i|--info] [-w|--warn] [-p|--prefix] <message>
##?    xc-puts -h | --help
##?
##? Arguments:
##?    message       The text message to print
##?
##? Options:
##?    -p, --prefix  Print message with prefix
##?    -g, --green   Print message in green
##?    -r, --red     Print message in red
##?    -y, --yellow  Print message in yellow
##?    -b, --blue    Print message in blue
##?    -d, --debug   Print log message in debug
##?    -e, --error   Print log message in error
##?    -f, --fatal   Print log message in fatal
##?    -i, --info    Print log message in info
##?    -w, --warn    Print log message in warn
##?    -h, --help    Show this screen
##?
##? Examples:
##?    xc-puts --green 'Success!'
##?    xc-puts --red 'Error!'
##?    xc-puts --yellow 'Warning!'
##?    xc-puts --prefix 'SETUP' 'Message!'
##?    xc-puts --prefix 'SETUP' --warn 'Message!'

readonly XC_PUTS_ROOT="${${(%):-%x}:a:h}"

_xc_usage_find() {
  if command -v xc-usage >/dev/null 2>&1; then
    command xc-usage "$@"
    return $?
  fi
  if [[ -x "${XC_PUTS_ROOT}/xc-usage" ]]; then
    "${XC_PUTS_ROOT}/xc-usage" "$@"
    return $?
  fi
  print -u2 "xc-puts: xc-usage not found on PATH or at ${XC_PUTS_ROOT}/xc-usage"
  return 127
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  _xc_usage_find "${0:a}"
  exit $?
fi

_has_command() {
  command -v "$1" >/dev/null 2>&1
}

local message
local color=""
local level=""
local prefix_val=""
local zsh_color=""

zparseopts -D -E -F \
  p:=prefix_val -prefix:=prefix_val \
  g=green -green=green \
  r=red -red=red \
  y=yellow -yellow=yellow \
  b=blue -blue=blue \
  d=debug -debug=debug \
  e=error -error=error \
  f=fatal -fatal=fatal \
  i=info -info=info \
  w=warn -warn=warn ||
  return 1

message="$1"

if [[ -z "$message" ]]; then
  _xc_usage_find "${0:a}" >&2
  exit 1
fi

local prefix_value=""
if (( ${#prefix_val} )); then
  prefix_value="${prefix_val[2]}"
fi

if (( ${#debug} )); then
  level="debug"
elif (( ${#error} )); then
  level="error"
elif (( ${#fatal} )); then
  level="fatal"
elif (( ${#info} )); then
  level="info"
elif (( ${#warn} )); then
  level="warn"
fi

if (( ${#green} || ${#debug} )); then
  color="#04B575"
  zsh_color="%F{green}"
elif (( ${#red} || ${#error} || ${#fatal} )); then
  color="#F44336"
  zsh_color="%F{red}"
elif (( ${#yellow} || ${#warn} )); then
  color="#F4AC45"
  zsh_color="%F{yellow}"
elif (( ${#blue} || ${#info} )); then
  color="#2196F3"
  zsh_color="%F{blue}"
fi

if _has_command gum; then
  if [[ -n "$level" ]]; then
    if (( ${#prefix_val} )); then
      gum log --time DateTime --level "$level" --prefix="$prefix_value" "$message"
    else
      gum log --time DateTime --level "$level" "$message"
    fi
  else
    if (( ${#prefix_val} )); then
      gum style --foreground "$color" --prefix "$prefix_value" "$message"
    else
      gum style --foreground "$color" "$message"
    fi
  fi
  exit 0
fi

if [[ -n "$level" ]]; then
  local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
  local level_upper=$(echo "$level" | tr '[:lower:]' '[:upper:]')
  if (( ${#prefix_val} )); then
    print -P "%F{white}${timestamp}%f ${zsh_color}${level_upper}%f %F{gray}${prefix_value}:%f ${message}"
  else
    print -P "%F{white}${timestamp}%f ${zsh_color}${level_upper}%f ${message}"
  fi
else
  if [[ -n "$zsh_color" ]]; then
    print -P "${zsh_color}${message}%f"
  else
    print "$message"
  fi
fi
