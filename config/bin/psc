#!/usr/bin/env -S usage zsh
# shellcheck shell=bash disable=SC2154

#USAGE version "0.1.0"
#USAGE about "Copies the pass|gopass key value to clipboard"
#USAGE arg "[key]" help="Secret path in gopass"
#USAGE example "psc"
#USAGE example "psc tools/bitly.com/token"

source /Users/roalcantara/Work/dots/config/bin/src/helpers
h::needs_command gopass

if [[ -z "${usage_key:-}" ]]; then
  if [[ ! -t 1 ]]; then
    h::puts fatal "key argument required in non-interactive environment"
  fi
  items=$(gopass ls --flat 2>/dev/null || true)
  if h::has_command gum; then
    usage_key=$(echo "$items" | gum filter --limit=1)
  elif h::has_command fzf; then
    usage_key=$(echo "$items" | fzf)
  else
    h::puts fatal "Interactive selection requires gum or fzf"
  fi
fi
[[ -z "${usage_key:-}" ]] && exit 0

exec gopass show --clip "$usage_key"
