#!/usr/bin/env zsh

#? xc-fabric - Interactive Fabric pattern runner with fzf/gum fallbacks
#?
#? Usage:
#?   xc-fabric [options]
#?   xc-fabric [options] wizard
#?   xc-fabric [options] run <pattern> [url]
#?   xc-fabric [options] ls
#?   xc-fabric [options] update
#?   xc-fabric [options] show <pattern>
#?   xc-fabric [options] strategies
#?   xc-fabric [options] scrape <url> [pattern]
#?   xc-fabric -h | --help
#?
#? Options:
#?   -r, --raw                 Print raw output without TUI rendering
#?   --model <model>           Pass a model to fabric
#?   -c, --copy                Pass --copy to fabric
#?   -o, --output <file>       Pass --output to fabric and skip rendering
#?   -v <value>                Pass a fabric variable token verbatim
#?   --variable=<value>        Pass a fabric variable token verbatim
#?   --strategy <name>         Pass a fabric strategy to fabric
#?   --no-preview              Disable picker previews
#?   -y, --yes                 Skip confirmations
#?   --yt-timestamps           Use YouTube transcript timestamps
#?   --yt-comments             Include YouTube comments
#?   --yt-metadata             Include YouTube metadata
#?   --yt-playlist             Process a YouTube playlist
#?
#? Subcommands:
#?   wizard                    Guided pattern run
#?   run <pattern> [url]       Run a named pattern against stdin, clipboard, or URL
#?   ls                        List Fabric patterns with descriptions
#?   update                    Refresh Fabric patterns with fabric -U
#?   show <pattern>            Show a pattern definition
#?   strategies                List Fabric strategies
#?   scrape <url> [pattern]    Scrape a URL with fabric -u, optionally through a pattern
#?
#? Examples:
#?   xc-fabric
#?   xc-fabric ls --raw
#?   echo "Hello" | xc-fabric run summarize --raw
#?   xc-fabric run summarize https://youtu.be/example --yt-metadata

case "${1:-}" in
  -h|--help)
    grep '^#?' "${0}" | sed 's/^#? \{0,1\}//'
    exit 0
    ;;
esac

set -euo pipefail

readonly SCRIPT_NAME="${0:t}"

RAW=0
COPY=0
YES=0
NO_PREVIEW=0
YT_TIMESTAMPS=0
YT_COMMENTS=0
YT_METADATA=0
YT_PLAYLIST=0
MODEL=""
OUTPUT=""
STRATEGY=""
COMMAND=""
typeset -ga VARS=()
typeset -ga POSITIONALS=()

_has_fabric() { command -v fabric-ai >/dev/null 2>&1; }
_has_gum() { command -v gum >/dev/null 2>&1; }
_has_glow() { command -v glow >/dev/null 2>&1; }
_has_bat() { command -v bat >/dev/null 2>&1; }
_has_fzf() { command -v fzf >/dev/null 2>&1; }

_h_log() {
  local level="$1"
  shift
  local message="$*"

  if _has_gum; then
    gum log --time DateTime --level "$level" "$message"
  else
    printf '%s %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$level" "$message" >&2
  fi
}

_h_info() {
  _h_log "info" "$@"
  return 0
}

_h_warn() {
  _h_log "warn" "$@"
  return 0
}

_h_error() {
  _h_log "error" "$@"
  return 0
}

_h_fatal() {
  _h_log "fatal" "$@"
  exit 1
}

_h_prompt() {
  local text="$1"
  local answer=""

  if _has_gum; then
    gum input --prompt="$text"
  else
    read -r "?$text" answer
    printf '%s\n' "$answer"
  fi
}

_h_confirm() {
  local question="$1"
  local answer=""

  if _has_gum; then
    gum confirm "$question"
  else
    read -r "?$question [y/N] " answer
    [[ "$answer" == "y" ]]
  fi
}

_h_spinner() {
  local title="$1"
  shift
  [[ "${1:-}" == "--" ]] && shift

  if _has_gum; then
    gum spin --spinner dot --title "${title}..." -- "$@"
  else
    printf '%s...\n' "$title" >&2
    "$@"
  fi
}

_h_table() {
  if _has_gum; then
    gum table --separator $'\t' --columns "PATTERN,DESCRIPTION" --widths "30,60"
  else
    cat
  fi
}

_h_choose() {
  local header="$1"
  local items
  local answer=""
  items=$(cat)

  if _has_gum; then
    printf '%s\n' "$items" | gum choose --header "$header"
  else
    printf '%s\n%s\n' "$header" "$items" >&2
    if [[ -r /dev/tty ]]; then
      read -r answer </dev/tty
      printf '%s\n' "$answer"
    else
      printf '%s\n' "$items" | head -n 1
    fi
  fi
}

_h_filter() {
  local header=""
  local placeholder=""
  local preview=""
  local -a gum_args=()

  while (( $# > 0 )); do
    case "$1" in
      --header)
        shift
        header="${1:-}"
        ;;
      --placeholder)
        shift
        placeholder="${1:-}"
        ;;
      --preview)
        shift
        preview="${1:-}"
        ;;
    esac
    shift || true
  done

  [[ -n "$header" ]] && gum_args+=(--header "$header")
  [[ -n "$placeholder" ]] && gum_args+=(--placeholder "$placeholder")

  if _has_fzf; then
    local pat_dir
    local edit_cmd
    local reload_cmd
    pat_dir=$(_patterns_dir)
    [[ -z "$header" ]] && header="Enter run  Ctrl-/ preview  Ctrl-O edit  Ctrl-R reload  ? help"
    [[ -z "$preview" ]] && preview="head -50 ${pat_dir}/{}/system.md 2>/dev/null"
    edit_cmd="${EDITOR:-vi} \"${pat_dir}/{}/system.md\" </dev/tty >/dev/tty 2>&1"
    # fzf reload runs in a fresh shell, so this bind is intentionally self-contained.
    reload_cmd="find \"${pat_dir}\" -mindepth 1 -maxdepth 1 -type d -exec basename {} \\; 2>/dev/null | sort"

    fzf \
      --header="$header" \
      --preview="$preview" \
      --preview-window 'right:60%:wrap' \
      --bind 'ctrl-/:toggle-preview' \
      --bind "ctrl-o:execute(${edit_cmd})" \
      --bind "ctrl-r:reload(${reload_cmd})" \
      --bind '?:execute(printf "%s\n" "Keys: Enter run  Ctrl-/ toggle preview  Ctrl-O editor  Ctrl-R reload  ? help  Esc cancel" | less >/dev/tty 2>&1)'
  elif _has_gum; then
    gum filter "${gum_args[@]}"
  else
    local items
    local answer=""
    items=$(cat)
    [[ -n "$header" ]] && printf '%s\n' "$header" >&2
    printf '%s\n' "$items" >&2
    if [[ -r /dev/tty ]]; then
      read -r answer </dev/tty
      printf '%s\n' "$answer"
    else
      printf '%s\n' "$items" | head -n 1
    fi
  fi
}

_h_write() {
  local placeholder="${1:-}"

  if _has_gum; then
    gum write --placeholder "$placeholder"
  else
    [[ -n "$placeholder" ]] && printf '%s\n' "$placeholder" >&2
    cat
  fi
}

_h_clip() {
  case "$(uname)" in
    Darwin)
      command -v pbpaste >/dev/null 2>&1 || return 1
      pbpaste
      ;;
    Linux)
      if command -v wl-paste >/dev/null 2>&1; then
        wl-paste --no-newline
      elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -o
      elif command -v xsel >/dev/null 2>&1; then
        xsel --clipboard --output
      else
        return 1
      fi
      ;;
    *)
      return 1
      ;;
  esac
}

_check_deps() {
  _has_fabric || _h_fatal "fabric-ai not found!"

  _has_gum || _h_warn "gum not found! Interactive features disabled."

  if ! _has_glow; then
    if _has_bat; then
      _h_warn "glow not found! Falling back to bat."
    else
      _h_warn "glow not found! Falling back to cat."
    fi
  fi
}

_patterns_dir() {
  printf '%s\n' "${FABRIC_PATTERNS_DIR:-${HOME}/.config/fabric/patterns}"
}

_pattern_description() {
  local system_file="$1"
  local fallback="$2"
  local line

  if [[ -f "$system_file" ]]; then
    while IFS= read -r line; do
      [[ -z "${line//[[:space:]]/}" ]] && continue
      [[ "$line" == \#* ]] && continue
      printf '%s\n' "$line"
      return 0
    done <"$system_file"
  fi

  printf '%s\n' "$fallback"
}

_list_patterns() {
  local pat_dir
  local dir
  local name
  local desc
  pat_dir=$(_patterns_dir)

  [[ -d "$pat_dir" ]] || return 0

  for dir in "$pat_dir"/*(/N); do
    name="${dir:t}"
    desc=$(_pattern_description "$dir/system.md" "$name")
    printf '%s\t%s\n' "$name" "$desc"
  done | sort
}

_is_youtube_url() {
  [[ "${1:-}" =~ '^https://(www[.])?(youtube[.]com|youtu[.]be)' ]]
}

_is_youtube_pattern() {
  local pattern="${1:l}"
  [[ "$pattern" == *youtube* || "$pattern" == *yt* ]]
}

_read_input() {
  if [[ ! -t 0 ]]; then
    cat -
  else
    local clip
    clip=$(_h_clip) || _h_fatal "no input available (clipboard empty or unsupported on $(uname))"
    [[ -n "$clip" ]] || _h_fatal "no input available (clipboard empty or unsupported on $(uname))"
    printf '%s' "$clip"
  fi
}

_render_output() {
  local result="$1"

  if _has_glow; then
    printf '%s\n' "$result" | glow
  elif _has_bat; then
    printf '%s\n' "$result" | bat
  else
    printf '%s\n' "$result"
  fi
}

_build_yt_args() {
  if [[ "$YT_TIMESTAMPS" == "1" ]]; then
    printf '%s\n' "--transcript-with-timestamps"
  fi
  if [[ "$YT_COMMENTS" == "1" ]]; then
    printf '%s\n' "--comments"
  fi
  if [[ "$YT_METADATA" == "1" ]]; then
    printf '%s\n' "--metadata"
  fi
  if [[ "$YT_PLAYLIST" == "1" ]]; then
    printf '%s\n' "--playlist"
  fi
  return 0
}

_exec_fabric() {
  local pattern="$1"
  local input="$2"
  local result
  local -a args=(--pattern "$pattern")

  [[ -n "$MODEL" ]] && args+=(--model "$MODEL")
  [[ -n "$OUTPUT" ]] && args+=(--output "$OUTPUT")
  [[ "$COPY" == "1" ]] && args+=(--copy)
  [[ -n "$STRATEGY" ]] && args+=(--strategy "$STRATEGY")
  (( ${#VARS[@]} > 0 )) && args+=("${VARS[@]}")

  if [[ "$RAW" == "1" ]]; then
    printf '%s' "$input" | fabric-ai "${args[@]}"
  elif [[ -n "$OUTPUT" ]]; then
    printf '%s' "$input" | _h_spinner "Running ${pattern}" -- fabric-ai "${args[@]}"
  else
    result=$(printf '%s' "$input" | _h_spinner "Running ${pattern}" -- fabric-ai "${args[@]}")
    _render_output "$result"
  fi
}

_exec_fabric_youtube() {
  local pattern="${1:-}"
  local url="${2:-}"
  local result
  local built_yt_args
  local -a yt_args=()
  local -a args

  [[ -n "$pattern" && -n "$url" ]] || _h_fatal "pattern and URL are required"

  built_yt_args=$(_build_yt_args)
  if [[ -n "$built_yt_args" ]]; then
    yt_args=("${(@f)built_yt_args}")
  fi
  args=(-y "$url" --pattern "$pattern" "${yt_args[@]}")

  [[ -n "$MODEL" ]] && args+=(--model "$MODEL")
  [[ -n "$OUTPUT" ]] && args+=(--output "$OUTPUT")
  [[ "$COPY" == "1" ]] && args+=(--copy)
  [[ -n "$STRATEGY" ]] && args+=(--strategy "$STRATEGY")
  (( ${#VARS[@]} > 0 )) && args+=("${VARS[@]}")

  if [[ "$RAW" == "1" ]]; then
    fabric-ai "${args[@]}"
  elif [[ -n "$OUTPUT" ]]; then
    _h_spinner "Running ${pattern} on YouTube URL" -- fabric-ai "${args[@]}"
  else
    result=$(_h_spinner "Running ${pattern} on YouTube URL" -- fabric-ai "${args[@]}")
    _render_output "$result"
  fi
}

_exec_fabric_scrape() {
  local url="$1"
  local pattern="${2:-}"
  local result
  local -a args=(-u "$url")

  [[ -n "$pattern" ]] && args+=(--pattern "$pattern")
  [[ -n "$MODEL" ]] && args+=(--model "$MODEL")
  [[ -n "$OUTPUT" ]] && args+=(--output "$OUTPUT")
  [[ "$COPY" == "1" ]] && args+=(--copy)
  [[ -n "$STRATEGY" ]] && args+=(--strategy "$STRATEGY")
  (( ${#VARS[@]} > 0 )) && args+=("${VARS[@]}")

  if [[ "$RAW" == "1" ]]; then
    fabric-ai "${args[@]}"
  elif [[ -n "$OUTPUT" ]]; then
    _h_spinner "Scraping ${url}" -- fabric-ai "${args[@]}"
  else
    result=$(_h_spinner "Scraping ${url}" -- fabric-ai "${args[@]}")
    _render_output "$result"
  fi
}

cmd_default() {
  local patterns_tsv
  local selected
  local input
  local pat_dir
  local preview=""

  patterns_tsv=$(_list_patterns)
  if [[ "$RAW" == "1" ]]; then
    [[ -n "$patterns_tsv" ]] && printf '%s\n' "$patterns_tsv"
    return 0
  fi

  [[ -n "$patterns_tsv" ]] || return 0
  pat_dir=$(_patterns_dir)
  if [[ "$NO_PREVIEW" != "1" ]]; then
    preview="glow -s dark ${pat_dir}/{}/system.md 2>/dev/null || bat ${pat_dir}/{}/system.md 2>/dev/null || head -50 ${pat_dir}/{}/system.md 2>/dev/null"
  fi

  if [[ -n "$preview" ]]; then
    selected=$(printf '%s\n' "$patterns_tsv" | awk -F'\t' '{print $1}' | _h_filter --header "Select a pattern" --preview "$preview" || true)
  else
    selected=$(printf '%s\n' "$patterns_tsv" | awk -F'\t' '{print $1}' | _h_filter --header "Select a pattern" || true)
  fi
  [[ -n "$selected" ]] || return 0

  input=$(_read_input)
  _exec_fabric "$selected" "$input"
}

cmd_wizard() {
  local patterns_tsv
  local selected
  local system_file
  local placeholders
  local placeholder
  local name
  local value
  local input

  patterns_tsv=$(_list_patterns)
  [[ -n "$patterns_tsv" ]] || return 0

  selected=$(printf '%s\n' "$patterns_tsv" | awk -F'\t' '{print $1}' | _h_filter --header "Select a pattern" || true)
  [[ -n "$selected" ]] || return 0

  system_file="$(_patterns_dir)/${selected}/system.md"
  if [[ -f "$system_file" ]]; then
    placeholders=$(grep -oE '<[A-Z0-9_ -]+>' "$system_file" 2>/dev/null | sort -u || true)
    while IFS= read -r placeholder; do
      [[ -n "$placeholder" ]] || continue
      name="${placeholder#<}"
      name="${name%>}"
      while true; do
        value=$(_h_prompt "  ${name} > " || true)
        if [[ -n "$value" ]]; then
          VARS+=(-v "${name}:${value}")
          break
        fi
        _h_confirm "Leave ${name} empty?" && break
      done
    done <<<"$placeholders"
  fi

  if [[ "$YES" != "1" ]]; then
    _h_confirm "Run ${selected}?" || return 0
  fi

  input=$(_read_input)
  _exec_fabric "$selected" "$input"
}

cmd_run() {
  local pattern="${1:-}"
  local url=""
  local input

  [[ -n "$pattern" ]] || _h_fatal "pattern is required"
  shift || true

  if [[ -n "${1:-}" ]] && _is_youtube_url "$1"; then
    url="$1"
    shift || true
  elif [[ -n "${1:-}" && "$1" =~ '^https?://' ]]; then
    url="$1"
    shift || true
  fi

  if [[ -n "$url" ]] && _is_youtube_url "$url"; then
    _h_info "YouTube URL detected - using -y mode"
    _exec_fabric_youtube "$pattern" "$url"
  elif [[ -n "$url" ]]; then
    _exec_fabric_scrape "$url" "$pattern"
  elif _is_youtube_pattern "$pattern"; then
    url=$(_h_prompt "YouTube URL: ")
    [[ -n "$url" ]] || return 0
    _exec_fabric_youtube "$pattern" "$url"
  else
    input=$(_read_input)
    _exec_fabric "$pattern" "$input"
  fi
}

cmd_ls() {
  if [[ "$RAW" == "1" ]]; then
    _list_patterns
  else
    _list_patterns | _h_table
  fi
}

cmd_update() {
  if [[ "$RAW" == "1" ]]; then
    fabric-ai -U
  else
    _h_spinner "Updating patterns" -- fabric-ai -U
  fi
}

cmd_show() {
  local pattern="${1:-}"
  local result
  [[ -n "$pattern" ]] || _h_fatal "pattern is required"

  if [[ "$RAW" == "1" ]]; then
    fabric-ai --readpattern "$pattern"
  else
    result=$(fabric-ai --readpattern "$pattern")
    _render_output "$result"
  fi
}

cmd_strategies() {
  if [[ "$RAW" == "1" ]]; then
    fabric-ai --liststrategies
  else
    fabric-ai --liststrategies | _h_table
  fi
}

cmd_scrape() {
  local url="${1:-}"
  local pattern="${2:-}"
  [[ -n "$url" ]] || _h_fatal "url is required"

  if _is_youtube_url "$url"; then
    _exec_fabric_youtube "${pattern:-extract_wisdom}" "$url"
  else
    _exec_fabric_scrape "$url" "$pattern"
  fi
}

_parse_args() {
  local arg

  while (( $# > 0 )); do
    arg="$1"
    case "$arg" in
      -h|--help)
        grep '^#?' "${0}" | sed 's/^#? \{0,1\}//'
        exit 0
        ;;
      -r|--raw)
        RAW=1
        ;;
      --model)
        shift
        MODEL="${1:-}"
        [[ -n "$MODEL" ]] || _h_fatal "model is required"
        ;;
      --model=*)
        MODEL="${arg#--model=}"
        ;;
      -c|--copy)
        COPY=1
        ;;
      -o|--output)
        shift
        OUTPUT="${1:-}"
        [[ -n "$OUTPUT" ]] || _h_fatal "output path is required"
        ;;
      --output=*)
        OUTPUT="${arg#--output=}"
        ;;
      -v)
        shift
        [[ -n "${1:-}" ]] || _h_fatal "variable value is required"
        VARS+=(-v "$1")
        ;;
      --variable=*)
        VARS+=("$arg")
        ;;
      --strategy)
        shift
        STRATEGY="${1:-}"
        [[ -n "$STRATEGY" ]] || _h_fatal "strategy is required"
        ;;
      --strategy=*)
        STRATEGY="${arg#--strategy=}"
        ;;
      --no-preview)
        NO_PREVIEW=1
        ;;
      -y|--yes)
        YES=1
        ;;
      --yt-timestamps)
        YT_TIMESTAMPS=1
        ;;
      --yt-comments)
        YT_COMMENTS=1
        ;;
      --yt-metadata)
        YT_METADATA=1
        ;;
      --yt-playlist)
        YT_PLAYLIST=1
        ;;
      --)
        shift
        POSITIONALS+=("$@")
        break
        ;;
      wizard|run|ls|update|show|strategies|scrape)
        if [[ -z "$COMMAND" ]]; then
          COMMAND="$arg"
        else
          POSITIONALS+=("$arg")
        fi
        ;;
      --*)
        _h_fatal "unknown option: $arg"
        ;;
      *)
        POSITIONALS+=("$arg")
        ;;
    esac
    shift || true
  done
}

main() {
  _parse_args "$@"
  _check_deps

  case "$COMMAND" in
    "")
      cmd_default
      ;;
    wizard)
      cmd_wizard "${POSITIONALS[@]}"
      ;;
    run)
      cmd_run "${POSITIONALS[@]}"
      ;;
    ls)
      cmd_ls "${POSITIONALS[@]}"
      ;;
    update)
      cmd_update "${POSITIONALS[@]}"
      ;;
    show)
      cmd_show "${POSITIONALS[@]}"
      ;;
    strategies)
      cmd_strategies "${POSITIONALS[@]}"
      ;;
    scrape)
      cmd_scrape "${POSITIONALS[@]}"
      ;;
    *)
      _h_fatal "unknown command: $COMMAND"
      ;;
  esac
}

trap '_h_error "xc-fabric: failed at line $LINENO"' ERR

main "$@"
