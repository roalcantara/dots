#!/usr/bin/env zsh

#? xc-fabric - Interactive Fabric pattern runner with fzf/gum fallbacks
#?
#? Usage:
#?   xc-fabric [options]
#?   xc-fabric [options] wizard
#?   xc-fabric [options] run <pattern> [url]
#?   xc-fabric [options] ls
#?   xc-fabric [options] update
#?   xc-fabric [options] show <pattern>
#?   xc-fabric [options] strategies
#?   xc-fabric [options] scrape <url> [pattern]
#?   xc-fabric -h | --help
#?
#? Options:
#?   -r, --raw                 Print raw output without TUI rendering
#?   --model <model>           Pass a model to fabric
#?   -c, --copy                Pass --copy to fabric
#?   -o, --output <file>       Pass --output to fabric and skip rendering
#?   -v <value>                Pass a fabric variable token verbatim
#?   --variable=<value>        Pass a fabric variable token verbatim
#?   --strategy <name>         Pass a fabric strategy to fabric
#?   --no-preview              Disable picker previews
#?   -y, --yes                 Skip confirmations
#?   --yt-timestamps           Use YouTube transcript timestamps
#?   --yt-comments             Include YouTube comments
#?   --yt-metadata             Include YouTube metadata
#?   --yt-playlist             Process a YouTube playlist
#?   --debug                   Log fzf preview template and a dry-run sample to stderr
#?
#? Subcommands:
#?   wizard                    Guided pattern run
#?   run <pattern> [url]       Run a named pattern against stdin, clipboard, or URL
#?   ls                        List Fabric patterns with descriptions
#?   update                    Refresh Fabric patterns with fabric -U
#?   show <pattern>            Show a pattern definition
#?   strategies                List Fabric strategies
#?   scrape <url> [pattern]    Scrape a URL with fabric -u, optionally through a pattern
#?
#? Examples:
#?   xc-fabric
#?   xc-fabric ls --raw
#?   echo "Hello" | xc-fabric run summarize --raw
#?   xc-fabric run summarize https://youtu.be/example --yt-metadata

case "${1:-}" in
  -h|--help)
    grep '^#?' "${0}" | sed 's/^#? \{0,1\}//'
    exit 0
    ;;
esac

set -euo pipefail

readonly SCRIPT_NAME="${0:t}"
readonly XC_SCRIPT="${${(%):-%x}:a}"

RAW=0
COPY=0
YES=0
NO_PREVIEW=0
YT_TIMESTAMPS=0
YT_COMMENTS=0
YT_METADATA=0
YT_PLAYLIST=0
MODEL=""
OUTPUT=""
STRATEGY=""
COMMAND=""
DEBUG=0
typeset -ga VARS=()
typeset -ga POSITIONALS=()

_has_fabric() { command -v fabric-ai >/dev/null 2>&1; }
_has_gum() { command -v gum >/dev/null 2>&1; }
_has_glow() { command -v glow >/dev/null 2>&1; }
_has_bat() { command -v bat >/dev/null 2>&1; }
_has_fzf() { command -v fzf >/dev/null 2>&1; }
_has_yq() { command -v yq >/dev/null 2>&1; }

_bin_config_file() {
  if [[ -n "${XC_BIN_CONFIG:-}" ]]; then
    printf '%s\n' "$XC_BIN_CONFIG"
  else
    printf '%s\n' "${XC_SCRIPT:h}/config.yml"
  fi
}

_h_log() {
  local level="$1"
  shift
  local message="$*"

  if _has_gum; then
    gum log --time DateTime --level "$level" "$message"
  else
    printf '%s %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$level" "$message" >&2
  fi
}

_h_info() {
  _h_log "info" "$@"
  return 0
}

_h_warn() {
  _h_log "warn" "$@"
  return 0
}

_h_error() {
  _h_log "error" "$@"
  return 0
}

_h_fatal() {
  _h_log "fatal" "$@"
  exit 1
}

_h_prompt() {
  local text="$1"
  local answer=""

  if _has_gum; then
    gum input --prompt="$text"
  else
    read -r "?$text" answer
    printf '%s\n' "$answer"
  fi
}

_h_confirm() {
  local question="$1"
  local answer=""

  if _has_gum; then
    gum confirm "$question"
  else
    read -r "?$question [y/N] " answer
    [[ "$answer" == "y" ]]
  fi
}

_h_spinner() {
  local title="$1"
  shift
  [[ "${1:-}" == "--" ]] && shift

  if _has_gum; then
    gum spin --spinner dot --title "${title}..." -- "$@"
  else
    printf '%s...\n' "$title" >&2
    "$@"
  fi
}

_h_table() {
  if _has_gum; then
    gum table --separator $'\t' --columns "PATTERN,DESCRIPTION" --widths "30,60"
  else
    cat
  fi
}

_h_choose() {
  local header="$1"
  local items
  local answer=""
  items=$(cat)

  if _has_gum; then
    printf '%s\n' "$items" | gum choose --header "$header"
  else
    printf '%s\n%s\n' "$header" "$items" >&2
    if [[ -r /dev/tty ]]; then
      read -r answer </dev/tty
      printf '%s\n' "$answer"
    else
      printf '%s\n' "$items" | head -n 1
    fi
  fi
}

_h_filter() {
  local header=""
  local placeholder=""
  local preview=""

  while (( $# > 0 )); do
    case "$1" in
      --header)
        shift
        header="${1:-}"
        ;;
      --placeholder)
        shift
        placeholder="${1:-}"
        ;;
      --preview)
        shift
        preview="${1:-}"
        ;;
    esac
    shift || true
  done

  if _has_fzf; then
    local pat_dir
    local edit_cmd
    local reload_cmd
    local bin_self
    local pprev
    pat_dir=$(_patterns_dir)
    [[ -z "$header" ]] && header=$(_fzf_pattern_header_body)
    pprev="$preview"
    # Lines are "name<TAB>display"; --delimiter is tab — use {1} (pattern), not {} (whole line).
    [[ -z "$pprev" ]] && pprev="sed -n '1,120p' $(printf '%q' "$pat_dir")/{1}/system.md 2>/dev/null"
    edit_cmd="${EDITOR:-vi} \"${pat_dir}/{1}/system.md\" </dev/tty >/dev/tty 2>&1"
    bin_self="${XC_FABRIC:-$XC_SCRIPT}"
    reload_cmd="env FABRIC_PATTERNS_DIR=${(q)pat_dir} zsh ${(q)bin_self} --xc-picker-lines"

    if [[ "$DEBUG" == 1 ]]; then
      printf '%s\n' "xc-fabric DEBUG: fzf --preview (exact string passed to fzf):" >&2
      printf '%s\n\n' "$pprev" >&2
      printf '%s\n' "xc-fabric DEBUG: env at picker start: GLOW_STYLE=${GLOW_STYLE:-<unset>} TERM=${TERM:-<unset>} NO_COLOR=${NO_COLOR:-<unset>} CLICOLOR_FORCE=${CLICOLOR_FORCE:-<unset>} COLORTERM=${COLORTERM:-<unset>}" >&2
      printf '%s\n' "xc-fabric DEBUG: fzf sets FZF_PREVIEW_COLUMNS in the preview subshell only (not here)." >&2
      local dbg_pat="" d dbg_snip
      for d in "$pat_dir"/*(/N); do
        dbg_pat="${d:t}"
        break
      done
      if [[ -n "$dbg_pat" ]]; then
        dbg_snip="${pprev//\{1\}/$dbg_pat}"
        printf '%s\n' "xc-fabric DEBUG: dry-run preview with {1} → ${dbg_pat} (FZF_PREVIEW_COLUMNS=80, via /bin/sh -c):" >&2
        FZF_PREVIEW_COLUMNS=80 /bin/sh -c "$dbg_snip" 2>&1 | head -24 | sed 's/^/xc-fabric DEBUG: | /' >&2 || true
        printf '\n' >&2
      else
        printf '%s\n' "xc-fabric DEBUG: no pattern dirs under ${pat_dir}, skip dry-run." >&2
      fi
    fi

    fzf \
      --ansi \
      --layout=reverse \
      --height=90% \
      --border=rounded \
      --delimiter=$'\t' \
      --with-nth=2 \
      --header="$header" \
      --preview="$pprev" \
      --preview-window 'right:60%:wrap' \
      --bind 'ctrl-/:toggle-preview' \
      --bind "ctrl-o:execute(${edit_cmd})" \
      --bind "ctrl-r:reload(${reload_cmd})" \
      --bind '?:execute(printf "%s\n" "Keys: Enter run  Ctrl-/ toggle preview  Ctrl-O editor  Ctrl-R reload  ? help  Esc cancel" | less >/dev/tty 2>&1)'
  elif _has_gum; then
    local -a gum_args=()
    [[ -n "$header" ]] && gum_args+=(--header "$header")
    [[ -n "$placeholder" ]] && gum_args+=(--placeholder "$placeholder")
    gum filter "${gum_args[@]}"
  else
    local items
    local answer=""
    items=$(cat)
    [[ -n "$header" ]] && printf '%s\n' "$header" >&2
    printf '%s\n' "$items" >&2
    if [[ -r /dev/tty ]]; then
      read -r answer </dev/tty
      printf '%s\n' "$answer"
    else
      printf '%s\n' "$items" | head -n 1
    fi
  fi
}

_h_write() {
  local placeholder="${1:-}"

  if _has_gum; then
    gum write --placeholder "$placeholder"
  else
    [[ -n "$placeholder" ]] && printf '%s\n' "$placeholder" >&2
    cat
  fi
}

_h_clip() {
  case "$(uname)" in
    Darwin)
      command -v pbpaste >/dev/null 2>&1 || return 1
      pbpaste
      ;;
    Linux)
      if command -v wl-paste >/dev/null 2>&1; then
        wl-paste --no-newline
      elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -o
      elif command -v xsel >/dev/null 2>&1; then
        xsel --clipboard --output
      else
        return 1
      fi
      ;;
    *)
      return 1
      ;;
  esac
}

_check_deps() {
  _has_fabric || _h_fatal "fabric-ai not found!"

  _has_gum || _h_warn "gum not found! Interactive features disabled."

  if ! _has_glow; then
    if _has_bat; then
      _h_warn "glow not found! Falling back to bat."
    else
      _h_warn "glow not found! Falling back to cat."
    fi
  fi
}

_patterns_dir() {
  printf '%s\n' "${FABRIC_PATTERNS_DIR:-${HOME}/.config/fabric/patterns}"
}

_pattern_description() {
  local system_file="$1"
  local fallback="$2"
  local line

  if [[ -f "$system_file" ]]; then
    while IFS= read -r line; do
      [[ -z "${line//[[:space:]]/}" ]] && continue
      [[ "$line" == \#* ]] && continue
      printf '%s\n' "$line"
      return 0
    done <"$system_file"
  fi

  printf '%s\n' "$fallback"
}

_list_patterns() {
  local pat_dir
  local dir
  local name
  local desc
  pat_dir=$(_patterns_dir)

  [[ -d "$pat_dir" ]] || return 0

  for dir in "$pat_dir"/*(/N); do
    name="${dir:t}"
    desc=$(_pattern_description "$dir/system.md" "$name")
    printf '%s\t%s\n' "$name" "$desc"
  done | sort
}

_pattern_overlay_load() {
  typeset -gA _XC_MDESC _XC_MTAGS
  _XC_MDESC=()
  _XC_MTAGS=()
  local config key desc tags
  config=$(_bin_config_file)
  [[ -f "$config" ]] || return 1
  _has_yq || return 1
  while IFS=$'\t' read -r key desc tags; do
    [[ -n "$key" ]] || continue
    _XC_MDESC[$key]="$desc"
    _XC_MTAGS[$key]="$tags"
  done < <(yq -r '.scripts["xc-fabric"].patterns // {} | to_entries[] | [.key, (.value.description // ""), (.value.tags // [] | join(" "))] | @tsv' "$config" 2>/dev/null || :)
  (( ${#_XC_MDESC[@]} > 0 )) || return 1
  return 0
}

_truncate_picker_desc() {
  local text="$1"
  local max="${2:-56}"
  local len=${#text} n
  if (( len <= max )); then
    printf '%s\n' "$text"
    return 0
  fi
  # zsh: ${var:0:len} treats a non-numeric third part as modifiers ("max-1" → `m`).
  # Use character subscripts [1,n] (1-based) with an arithmetic end index instead.
  n=$(( max - 1 ))
  (( n < 1 )) && n=1
  printf '%s…\n' "${text[1,n]}"
}

_pattern_hashtags() {
  local words="$1"
  local t out=""
  for t in ${=words}; do
    [[ -z "$t" ]] && continue
    t="${t##\\#}"
    out+=" #${t}"
  done
  printf '%s' "${out## }"
}

_format_pattern_fzf_row() {
  local name="$1"
  local desc="$2"
  local tags_sp="$3"
  local dim=$'\e[2m' reset=$'\e[0m' tags ht
  desc=$(_truncate_picker_desc "$desc" 56)
  ht=$(_pattern_hashtags "$tags_sp")
  if [[ -n "$ht" ]]; then
    printf '%s%s  %s  %s%s' "$name" "$dim" "$desc" "$ht" "$reset"
  else
    printf '%s%s  %s%s' "$name" "$dim" "$desc" "$reset"
  fi
}

_format_pattern_plain_row() {
  local name="$1"
  local desc="$2"
  local tags_sp="$3"
  local ht
  desc=$(_truncate_picker_desc "$desc" 64)
  ht=$(_pattern_hashtags "$tags_sp")
  if [[ -n "$ht" ]]; then
    printf '%s — %s %s' "$name" "$desc" "$ht"
  else
    printf '%s — %s' "$name" "$desc"
  fi
}

_pattern_emit_picker_lines() {
  local patterns_tsv="$1"
  local line name desc tags_sp display
  _pattern_overlay_load 2>/dev/null || true
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name="${line%%$'\t'*}"
    desc="${line#*$'\t'}"
    [[ "$desc" == "$line" ]] && desc=""
    [[ -z "$desc" ]] && desc="$name"
    tags_sp=""
    if [[ -n "${_XC_MDESC[$name]:-}" ]]; then
      desc="${_XC_MDESC[$name]}"
      tags_sp="${_XC_MTAGS[$name]:-}"
    fi
    if _has_fzf; then
      display=$(_format_pattern_fzf_row "$name" "$desc" "$tags_sp")
    else
      display=$(_format_pattern_plain_row "$name" "$desc" "$tags_sp")
    fi
    printf '%s\t%s\n' "$name" "$display"
  done <<<"$patterns_tsv"
}

_fzf_pattern_system_preview() {
  local pat_dir="$1"
  local q glow_p bat_p plain_p gs
  q=$(printf '%q' "$pat_dir")
  gs="${GLOW_STYLE:-dracula}"
  # Color Issues: If colors look broken inside the preview, try adding CLICOLOR_FORCE=1 or COLORTERM=truecolor before the glow command
  glow_p="export CLICOLOR_FORCE=1; export COLORTERM=truecolor; export TERM=\"\${TERM:-xterm-256color}\"; glow -s ${(q)gs} -w \"\${FZF_PREVIEW_COLUMNS:-80}\" ${q}/{1}/system.md </dev/null 2>/dev/null"
  bat_p="bat --language=md --style=plain --color=always --paging=never ${q}/{1}/system.md 2>/dev/null"
  plain_p="sed -n '1,120p' ${q}/{1}/system.md 2>/dev/null"
  printf '(%s) || (%s) || (%s)' "$glow_p" "$bat_p" "$plain_p"
}

_fzf_pattern_header_body() {
  local title line2 config
  title="Select a pattern"
  line2="Enter run  Ctrl-/ preview  Ctrl-O edit  Ctrl-R reload  ? help  Esc cancel"
  config=$(_bin_config_file)
  if [[ -f "$config" ]] && _has_yq; then
    title=$(yq -r '.scripts["xc-fabric"].ui.picker.title // "Select a pattern"' "$config" 2>/dev/null) || title="Select a pattern"
  fi
  [[ -z "$title" ]] && title="Select a pattern"
  printf '%s\n%s' "$title" "$line2"
}

_is_youtube_url() {
  [[ "${1:-}" =~ '^https://(www[.])?(youtube[.]com|youtu[.]be)' ]]
}

_is_youtube_pattern() {
  local pattern="${1:l}"
  [[ "$pattern" == *youtube* || "$pattern" == *yt* ]]
}

_read_input() {
  if [[ ! -t 0 ]]; then
    cat -
  else
    local clip
    clip=$(_h_clip) || _h_fatal "no input available (clipboard empty or unsupported on $(uname))"
    [[ -n "$clip" ]] || _h_fatal "no input available (clipboard empty or unsupported on $(uname))"
    printf '%s' "$clip"
  fi
}

_render_output() {
  local result="$1"

  if _has_glow; then
    # Stdin must be explicit `-` for pipe input per glow CLI docs. Clear NO_COLOR for ANSI output.
    ( unset NO_COLOR 2>/dev/null; printf '%s\n' "$result" | glow -s "${GLOW_STYLE:-dark}" - )
  elif _has_bat; then
    printf '%s\n' "$result" | bat --language=md --style=plain --color=always --paging=never
  else
    printf '%s\n' "$result"
  fi
}

_build_yt_args() {
  if [[ "$YT_TIMESTAMPS" == "1" ]]; then
    printf '%s\n' "--transcript-with-timestamps"
  fi
  if [[ "$YT_COMMENTS" == "1" ]]; then
    printf '%s\n' "--comments"
  fi
  if [[ "$YT_METADATA" == "1" ]]; then
    printf '%s\n' "--metadata"
  fi
  if [[ "$YT_PLAYLIST" == "1" ]]; then
    printf '%s\n' "--playlist"
  fi
  return 0
}

_exec_fabric() {
  local pattern="$1"
  local input="$2"
  local result
  local -a args=(--pattern "$pattern")

  [[ -n "$MODEL" ]] && args+=(--model "$MODEL")
  [[ -n "$OUTPUT" ]] && args+=(--output "$OUTPUT")
  [[ "$COPY" == "1" ]] && args+=(--copy)
  [[ -n "$STRATEGY" ]] && args+=(--strategy "$STRATEGY")
  (( ${#VARS[@]} > 0 )) && args+=("${VARS[@]}")

  if [[ "$RAW" == "1" ]]; then
    printf '%s' "$input" | fabric-ai "${args[@]}"
  elif [[ -n "$OUTPUT" ]]; then
    printf '%s' "$input" | _h_spinner "Running ${pattern}" -- fabric-ai "${args[@]}"
  else
    result=$(printf '%s' "$input" | _h_spinner "Running ${pattern}" -- fabric-ai "${args[@]}")
    _render_output "$result"
  fi
}

_exec_fabric_youtube() {
  local pattern="${1:-}"
  local url="${2:-}"
  local result
  local built_yt_args
  local -a yt_args=()
  local -a args

  [[ -n "$pattern" && -n "$url" ]] || _h_fatal "pattern and URL are required"

  built_yt_args=$(_build_yt_args)
  if [[ -n "$built_yt_args" ]]; then
    yt_args=("${(@f)built_yt_args}")
  fi
  args=(-y "$url" --pattern "$pattern" "${yt_args[@]}")

  [[ -n "$MODEL" ]] && args+=(--model "$MODEL")
  [[ -n "$OUTPUT" ]] && args+=(--output "$OUTPUT")
  [[ "$COPY" == "1" ]] && args+=(--copy)
  [[ -n "$STRATEGY" ]] && args+=(--strategy "$STRATEGY")
  (( ${#VARS[@]} > 0 )) && args+=("${VARS[@]}")

  if [[ "$RAW" == "1" ]]; then
    fabric-ai "${args[@]}"
  elif [[ -n "$OUTPUT" ]]; then
    _h_spinner "Running ${pattern} on YouTube URL" -- fabric-ai "${args[@]}"
  else
    result=$(_h_spinner "Running ${pattern} on YouTube URL" -- fabric-ai "${args[@]}")
    _render_output "$result"
  fi
}

_exec_fabric_scrape() {
  local url="$1"
  local pattern="${2:-}"
  local result
  local -a args=(-u "$url")

  [[ -n "$pattern" ]] && args+=(--pattern "$pattern")
  [[ -n "$MODEL" ]] && args+=(--model "$MODEL")
  [[ -n "$OUTPUT" ]] && args+=(--output "$OUTPUT")
  [[ "$COPY" == "1" ]] && args+=(--copy)
  [[ -n "$STRATEGY" ]] && args+=(--strategy "$STRATEGY")
  (( ${#VARS[@]} > 0 )) && args+=("${VARS[@]}")

  if [[ "$RAW" == "1" ]]; then
    fabric-ai "${args[@]}"
  elif [[ -n "$OUTPUT" ]]; then
    _h_spinner "Scraping ${url}" -- fabric-ai "${args[@]}"
  else
    result=$(_h_spinner "Scraping ${url}" -- fabric-ai "${args[@]}")
    _render_output "$result"
  fi
}

cmd_default() {
  local patterns_tsv
  local selected
  local input
  local pat_dir
  local preview=""
  local header_body
  local picker_lines

  patterns_tsv=$(_list_patterns)
  if [[ "$RAW" == "1" ]]; then
    [[ -n "$patterns_tsv" ]] && printf '%s\n' "$patterns_tsv"
    return 0
  fi

  [[ -n "$patterns_tsv" ]] || return 0
  pat_dir=$(_patterns_dir)
  header_body=$(_fzf_pattern_header_body)
  picker_lines=$(_pattern_emit_picker_lines "$patterns_tsv")
  if [[ "$NO_PREVIEW" != "1" ]]; then
    preview=$(_fzf_pattern_system_preview "$pat_dir")
  fi

  if [[ -n "$preview" ]]; then
    selected=$(printf '%s\n' "$picker_lines" | _h_filter --header "$header_body" --preview "$preview" | awk -F'\t' '{print $1}' || true)
  else
    selected=$(printf '%s\n' "$picker_lines" | _h_filter --header "$header_body" | awk -F'\t' '{print $1}' || true)
  fi
  [[ -n "$selected" ]] || return 0

  input=$(_read_input)
  _exec_fabric "$selected" "$input"
}

cmd_wizard() {
  local patterns_tsv
  local selected
  local system_file
  local placeholders
  local placeholder
  local name
  local value
  local input
  local pat_dir
  local preview=""
  local header_body
  local picker_lines

  patterns_tsv=$(_list_patterns)
  [[ -n "$patterns_tsv" ]] || return 0

  pat_dir=$(_patterns_dir)
  header_body=$(_fzf_pattern_header_body)
  picker_lines=$(_pattern_emit_picker_lines "$patterns_tsv")
  if [[ "$NO_PREVIEW" != "1" ]]; then
    preview=$(_fzf_pattern_system_preview "$pat_dir")
  fi
  if [[ -n "$preview" ]]; then
    selected=$(printf '%s\n' "$picker_lines" | _h_filter --header "$header_body" --preview "$preview" | awk -F'\t' '{print $1}' || true)
  else
    selected=$(printf '%s\n' "$picker_lines" | _h_filter --header "$header_body" | awk -F'\t' '{print $1}' || true)
  fi
  [[ -n "$selected" ]] || return 0

  system_file="$(_patterns_dir)/${selected}/system.md"
  if [[ -f "$system_file" ]]; then
    placeholders=$(grep -oE '<[A-Z0-9_ -]+>' "$system_file" 2>/dev/null | sort -u || true)
    while IFS= read -r placeholder; do
      [[ -n "$placeholder" ]] || continue
      name="${placeholder#<}"
      name="${name%>}"
      while true; do
        value=$(_h_prompt "  ${name} > " || true)
        if [[ -n "$value" ]]; then
          VARS+=(-v "${name}:${value}")
          break
        fi
        _h_confirm "Leave ${name} empty?" && break
      done
    done <<<"$placeholders"
  fi

  if [[ "$YES" != "1" ]]; then
    _h_confirm "Run ${selected}?" || return 0
  fi

  input=$(_read_input)
  _exec_fabric "$selected" "$input"
}

cmd_run() {
  local pattern="${1:-}"
  local url=""
  local input

  [[ -n "$pattern" ]] || _h_fatal "pattern is required"
  shift || true

  if [[ -n "${1:-}" ]] && _is_youtube_url "$1"; then
    url="$1"
    shift || true
  elif [[ -n "${1:-}" && "$1" =~ '^https?://' ]]; then
    url="$1"
    shift || true
  fi

  if [[ -n "$url" ]] && _is_youtube_url "$url"; then
    _h_info "YouTube URL detected - using -y mode"
    _exec_fabric_youtube "$pattern" "$url"
  elif [[ -n "$url" ]]; then
    _exec_fabric_scrape "$url" "$pattern"
  elif _is_youtube_pattern "$pattern"; then
    url=$(_h_prompt "YouTube URL: ")
    [[ -n "$url" ]] || return 0
    _exec_fabric_youtube "$pattern" "$url"
  else
    input=$(_read_input)
    _exec_fabric "$pattern" "$input"
  fi
}

cmd_ls() {
  if [[ "$RAW" == "1" ]]; then
    _list_patterns
  else
    _list_patterns | _h_table
  fi
}

cmd_update() {
  if [[ "$RAW" == "1" ]]; then
    fabric-ai -U
  else
    _h_spinner "Updating patterns" -- fabric-ai -U
  fi
}

cmd_show() {
  local pattern="${1:-}"
  local result
  [[ -n "$pattern" ]] || _h_fatal "pattern is required"

  if [[ "$RAW" == "1" ]]; then
    fabric-ai --readpattern "$pattern"
  else
    result=$(fabric-ai --readpattern "$pattern")
    _render_output "$result"
  fi
}

cmd_strategies() {
  if [[ "$RAW" == "1" ]]; then
    fabric-ai --liststrategies
  else
    fabric-ai --liststrategies | _h_table
  fi
}

cmd_scrape() {
  local url="${1:-}"
  local pattern="${2:-}"
  [[ -n "$url" ]] || _h_fatal "url is required"

  if _is_youtube_url "$url"; then
    _exec_fabric_youtube "${pattern:-extract_wisdom}" "$url"
  else
    _exec_fabric_scrape "$url" "$pattern"
  fi
}

_parse_args() {
  local arg

  while (( $# > 0 )); do
    arg="$1"
    case "$arg" in
      -h|--help)
        grep '^#?' "${0}" | sed 's/^#? \{0,1\}//'
        exit 0
        ;;
      -r|--raw)
        RAW=1
        ;;
      --model)
        shift
        MODEL="${1:-}"
        [[ -n "$MODEL" ]] || _h_fatal "model is required"
        ;;
      --model=*)
        MODEL="${arg#--model=}"
        ;;
      -c|--copy)
        COPY=1
        ;;
      -o|--output)
        shift
        OUTPUT="${1:-}"
        [[ -n "$OUTPUT" ]] || _h_fatal "output path is required"
        ;;
      --output=*)
        OUTPUT="${arg#--output=}"
        ;;
      -v)
        shift
        [[ -n "${1:-}" ]] || _h_fatal "variable value is required"
        VARS+=(-v "$1")
        ;;
      --variable=*)
        VARS+=("$arg")
        ;;
      --strategy)
        shift
        STRATEGY="${1:-}"
        [[ -n "$STRATEGY" ]] || _h_fatal "strategy is required"
        ;;
      --strategy=*)
        STRATEGY="${arg#--strategy=}"
        ;;
      --no-preview)
        NO_PREVIEW=1
        ;;
      -y|--yes)
        YES=1
        ;;
      --yt-timestamps)
        YT_TIMESTAMPS=1
        ;;
      --yt-comments)
        YT_COMMENTS=1
        ;;
      --yt-metadata)
        YT_METADATA=1
        ;;
      --yt-playlist)
        YT_PLAYLIST=1
        ;;
      --debug)
        DEBUG=1
        ;;
      --)
        shift
        POSITIONALS+=("$@")
        break
        ;;
      wizard|run|ls|update|show|strategies|scrape)
        if [[ -z "$COMMAND" ]]; then
          COMMAND="$arg"
        else
          POSITIONALS+=("$arg")
        fi
        ;;
      --*)
        _h_fatal "unknown option: $arg"
        ;;
      *)
        POSITIONALS+=("$arg")
        ;;
    esac
    shift || true
  done
}

main() {
  if [[ "${1:-}" == "--xc-picker-lines" ]]; then
    local patterns_tsv
    patterns_tsv=$(_list_patterns)
    _pattern_emit_picker_lines "$patterns_tsv"
    exit 0
  fi

  _parse_args "$@"
  _check_deps

  case "$COMMAND" in
    "")
      cmd_default
      ;;
    wizard)
      cmd_wizard "${POSITIONALS[@]}"
      ;;
    run)
      cmd_run "${POSITIONALS[@]}"
      ;;
    ls)
      cmd_ls "${POSITIONALS[@]}"
      ;;
    update)
      cmd_update "${POSITIONALS[@]}"
      ;;
    show)
      cmd_show "${POSITIONALS[@]}"
      ;;
    strategies)
      cmd_strategies "${POSITIONALS[@]}"
      ;;
    scrape)
      cmd_scrape "${POSITIONALS[@]}"
      ;;
    *)
      _h_fatal "unknown command: $COMMAND"
      ;;
  esac
}

trap '_h_error "xc-fabric: failed at line $LINENO"' ERR

main "$@"
