#USAGE version "0.1.0"
#USAGE about "Interactive Fabric pattern runner with fzf/gum fallbacks"
#USAGE example "xc-fabric"
#USAGE example "xc-fabric ls --raw"
#USAGE example "echo \"Hello\" | xc-fabric run summarize --raw"
#USAGE example "xc-fabric run summarize https://youtu.be/example --yt-metadata"

set -euo pipefail

readonly XC_SCRIPT="${${(%):-%x}:a}"

RAW=0;           [[ "${usage_raw:-false}" == "true" ]]           && RAW=1
COPY=0;          [[ "${usage_copy:-false}" == "true" ]]          && COPY=1
YES=0;           [[ "${usage_yes:-false}" == "true" ]]           && YES=1
NO_PREVIEW=0;    [[ "${usage_no_preview:-false}" == "true" ]]    && NO_PREVIEW=1
YT_TIMESTAMPS=0; [[ "${usage_yt_timestamps:-false}" == "true" ]] && YT_TIMESTAMPS=1
YT_COMMENTS=0;   [[ "${usage_yt_comments:-false}" == "true" ]]   && YT_COMMENTS=1
YT_METADATA=0;   [[ "${usage_yt_metadata:-false}" == "true" ]]   && YT_METADATA=1
YT_PLAYLIST=0;   [[ "${usage_yt_playlist:-false}" == "true" ]]   && YT_PLAYLIST=1
DEBUG=0;         [[ "${usage_debug:-false}" == "true" ]]         && DEBUG=1
MODEL="${usage_model:-}"
OUTPUT="${usage_output:-}"
VAR="${usage_v:-}"
STRATEGY="${usage_strategy:-}"
typeset -ga VARS=()
[[ -n "$VAR" ]] && VARS+=(-v "$VAR")
[[ -n "${usage_variable:-}" ]] && VARS+=("--variable=$usage_variable")

typeset -gA _CAPS=()
typeset -ga _CLIP_CMD=()
typeset -ga _fabric_common_argv_tail=()
_PATTERNS_DIR=""
_PREVIEW_CMD=""

# bootstrapping helpers
_boot_caps() {
  command -v fabric-ai >/dev/null 2>&1 && _CAPS[fabric]=1 || _CAPS[fabric]=0
  command -v gum      >/dev/null 2>&1 && _CAPS[gum]=1    || _CAPS[gum]=0
  command -v glow     >/dev/null 2>&1 && _CAPS[glow]=1   || _CAPS[glow]=0
  command -v bat      >/dev/null 2>&1 && _CAPS[bat]=1    || _CAPS[bat]=0
  command -v fzf      >/dev/null 2>&1 && _CAPS[fzf]=1    || _CAPS[fzf]=0
}
_boot_clip() {
  _CLIP_CMD=()
  case "$(uname)" in
    Darwin)
      command -v pbpaste >/dev/null 2>&1 && _CLIP_CMD=(pbpaste) ;;
    Linux)
      if   command -v wl-paste >/dev/null 2>&1; then _CLIP_CMD=(wl-paste --no-newline)
      elif command -v xclip    >/dev/null 2>&1; then _CLIP_CMD=(xclip -selection clipboard -o)
      elif command -v xsel     >/dev/null 2>&1; then _CLIP_CMD=(xsel --clipboard --output)
      fi ;;
  esac
}
_boot_paths() {
  _PATTERNS_DIR="${FABRIC_PATTERNS_DIR:-${HOME}/.config/fabric/patterns}"
}
_boot_preview_cmd() {
  [[ -n "$_PREVIEW_CMD" ]] && { _ui_print_line "$_PREVIEW_CMD"; return 0; }
  local q gs
  q=$(printf '%q' "$_PATTERNS_DIR")
  gs="${GLOW_STYLE:-dracula}"
  _PREVIEW_CMD="(export CLICOLOR_FORCE=1; export COLORTERM=truecolor; export TERM=\"\${TERM:-xterm-256color}\"; glow -s ${(q)gs} -w \"\${FZF_PREVIEW_COLUMNS:-80}\" ${q}/{1}/system.md </dev/null 2>/dev/null) || (bat --language=md --style=plain --color=always --paging=never ${q}/{1}/system.md 2>/dev/null) || (sed -n '1,120p' ${q}/{1}/system.md 2>/dev/null)"
  _ui_print_line "$_PREVIEW_CMD"
}
_boot_check_deps() {
  (( _CAPS[fabric] )) || _ui_log_fatal "fabric-ai not found!"

  (( _CAPS[gum] )) || _ui_log_warn "gum not found! Interactive features disabled."

  if ! (( _CAPS[glow] )); then
    if (( _CAPS[bat] )); then
      _ui_log_warn "glow not found! Falling back to bat."
    else
      _ui_log_warn "glow not found! Falling back to cat."
    fi
  fi
}

# ui helpers
_ui_log() {
  local level="$1"
  shift
  local message="$*"

  if (( _CAPS[gum] )); then
    gum log --time DateTime --level "$level" "$message"
  else
    printf '%s %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$level" "$message" >&2
  fi
}
_ui_log_info() { _ui_log "info" "$@"; return 0; }             # info log
_ui_log_warn() { _ui_log "warn" "$@"; return 0; }             # warn log
_ui_log_error() { _ui_log "error" "$@"; return 0; }           # error log
_ui_log_fatal() { _ui_log "fatal" "$@"; exit 1; }             # fatal log, exits 1.
_ui_print_line() { printf '%s\n' "$1"; }                      # same as printf '%s\n' "$1" (portable; no echo -n / ECHOCTL surprises).
_ui_print_line_err() { printf '%s\n' "$1" >&2; }              # for fallback UI and debug traces.
# Prompt for input (gum → read fallback)
_ui_prompt() {
  local text="$1"
  local answer=""

  if (( _CAPS[gum] )); then
    gum input --prompt="$text"
  else
    read -r "?$text" answer
    _ui_print_line "$answer"
  fi
}
# Confirmation prompt (gum → read fallback)
_ui_confirm() {
  local question="$1"
  local answer=""

  if (( _CAPS[gum] )); then
    gum confirm "$question"
  else
    read -r "?$question [y/N] " answer
    [[ "$answer" == "y" ]]
  fi
}
# Spinner
_ui_spinner() {
  local title="$1"
  shift
  [[ "${1:-}" == "--" ]] && shift

  if (( _CAPS[gum] )); then
    gum spin --spinner dot --title "${title}..." -- "$@"
  else
    printf '%s...\n' "$title" >&2
    "$@"
  fi
}
# Table output
_ui_table() {
  if (( _CAPS[gum] )); then
    gum table --separator $'\t' --columns "PATTERN,DESCRIPTION" --widths "30,60"
  else
    cat
  fi
}
# Fuzzy search picker (fzf → gum → read fallback)
_ui_filter() {
  local header=""
  local placeholder=""
  local preview=""

  while (( $# > 0 )); do
    case "$1" in
      --header)
        shift
        header="${1:-}"
        ;;
      --placeholder)
        shift
        placeholder="${1:-}"
        ;;
      --preview)
        shift
        preview="${1:-}"
        ;;
    esac
    shift || true
  done

  if (( _CAPS[fzf] )); then
    local edit_cmd
    local reload_cmd
    local bin_self
    local pprev
    [[ -z "$header" ]] && header=$(_pattern_list_header)
    if [[ -n "$preview" ]]; then
      pprev="$preview"
    elif [[ "$NO_PREVIEW" == "1" ]]; then
      pprev="sed -n '1,120p' $(printf '%q' "$_PATTERNS_DIR")/{1}/system.md 2>/dev/null"
    else
      pprev=$(_boot_preview_cmd)
    fi
    edit_cmd="${EDITOR:-vi} \"${_PATTERNS_DIR}/{1}/system.md\" </dev/tty >/dev/tty 2>&1"
    bin_self="${XC_FABRIC:-$XC_SCRIPT}"
    reload_cmd="env FABRIC_PATTERNS_DIR=${(q)_PATTERNS_DIR} zsh ${(q)bin_self} --reload-list"

    if [[ "$DEBUG" == 1 ]]; then
      _ui_print_line_err "xc-fabric DEBUG: fzf --preview (exact string passed to fzf):"
      printf '%s\n\n' "$pprev" >&2
      _ui_print_line_err "xc-fabric DEBUG: env at picker start: GLOW_STYLE=${GLOW_STYLE:-<unset>} TERM=${TERM:-<unset>} NO_COLOR=${NO_COLOR:-<unset>} CLICOLOR_FORCE=${CLICOLOR_FORCE:-<unset>} COLORTERM=${COLORTERM:-<unset>}"
      _ui_print_line_err "xc-fabric DEBUG: fzf sets FZF_PREVIEW_COLUMNS in the preview subshell only (not here)."
      local dbg_pat="" d dbg_snip
      for d in "$_PATTERNS_DIR"/*(/N); do
        dbg_pat="${d:t}"
        break
      done
      if [[ -n "$dbg_pat" ]]; then
        dbg_snip="${pprev//\{1\}/$dbg_pat}"
        _ui_print_line_err "xc-fabric DEBUG: dry-run preview with {1} → ${dbg_pat} (FZF_PREVIEW_COLUMNS=80, via /bin/sh -c):"
        FZF_PREVIEW_COLUMNS=80 /bin/sh -c "$dbg_snip" 2>&1 | head -24 | sed 's/^/xc-fabric DEBUG: | /' >&2 || true
        printf '\n' >&2
      else
        _ui_print_line_err "xc-fabric DEBUG: no pattern dirs under ${_PATTERNS_DIR}, skip dry-run."
      fi
    fi

    # fzf 0.27+ preview-bg / header-bg (see `fzf --help` COLSPEC). GLOW_STYLE still tunes glow inside preview.
    fzf \
      --cycle \
      --ansi \
      --inline-info \
      --keep-right \
      --layout=default \
      --height=75% \
      --border=rounded \
      --delimiter=$'\t' \
      --with-nth=2 \
      --margin=1,2 \
      --prompt="❯ " \
      --header="$header" \
      --tiebreak='chunk' \
      --color='bg:-1,fg:#f8f8f2' \
      --color='bg+:#44475a,fg+:#f8f8f2' \
      --color='hl:#bd93f9,hl+:#ff79c6' \
      --color='info:#6272a4,border:#6272a4' \
      --color='prompt:#50fa7b,pointer:#ff79c6' \
      --color='marker:#ff79c6,spinner:#ffb86c' \
      --color='header-bg:#21222c,header-fg:#f8f8f2,header-border:#6272a4' \
      --color='preview-bg:#181825,preview-fg:#cdd6f4,preview-border:#45475a' \
      --preview="$pprev" \
      --preview-window 'right:42%:wrap,border-rounded' \
      --bind 'ctrl-/:toggle-preview' \
      --bind "ctrl-o:execute(${edit_cmd})" \
      --bind "ctrl-r:reload(${reload_cmd})"
  elif (( _CAPS[gum] )); then
    local -a gum_args=()
    [[ -n "$header" ]] && gum_args+=(--header "$header")
    [[ -n "$placeholder" ]] && gum_args+=(--placeholder "$placeholder")
    gum filter "${gum_args[@]}"
  else
    local items
    local answer=""
    items=$(cat)
    [[ -n "$header" ]] && _ui_print_line_err "$header"
    _ui_print_line_err "$items"
    if [[ -r /dev/tty ]]; then
      read -r answer </dev/tty
      _ui_print_line "$answer"
    else
      _ui_print_line "$items" | head -n 1
    fi
  fi
}
# Read from clipboard
_ui_clip() {
  (( ${#_CLIP_CMD[@]} )) || return 1
  "${_CLIP_CMD[@]}"
}

# ── pattern helpers ────────────────────────────────────────────────────────---
# Extract the description from a pattern system file
_pattern_file_extract_desc() {
  local system_file="$1"
  local fallback="$2"
  local line

  if [[ -f "$system_file" ]]; then
    while IFS= read -r line; do
      [[ -z "${line//[[:space:]]/}" ]] && continue
      [[ "$line" == \#* ]] && continue
      printf '%s\n' "$line"
      return 0
    done <"$system_file"
  fi

  printf '%s\n' "$fallback"
}
# List patterns
_pattern_list() {
  local pat_dir
  local dir
  local name
  local desc
  [[ -d "$_PATTERNS_DIR" ]] || return 0

  for dir in "$_PATTERNS_DIR"/*(/N); do
    name="${dir:t}"
    desc=$(_pattern_file_extract_desc "$dir/system.md" "$name")
    printf '%s\t%s\n' "$name" "$desc"
  done | sort
}
# Collapse whitespace; strip tabs and newlines so fzf --delimiter TAB never splits a row.
_pattern_list_sanitize_desc() {
  local s="$1"
  s="${s//$'\t'/ }"
  s="${s//$'\n'/ }"
  s="${s//$'\r'/}"
  s="${s//$'\f'/ }"
  s="${s//$'\v'/ }"
  while [[ "$s" == *'  '* ]]; do
    s="${s//  / }"
  done
  while [[ "$s" == ' '* ]]; do
    s="${s# }"
  done
  while [[ "$s" == *' ' ]]; do
    s="${s% }"
  done
  printf '%s' "$s"
  return 0
}
# Truncate a description for the fzf pattern picker
_pattern_list_item_truncate_desc() {
  local text="$1"
  local max="${2:-56}"
  local len=${#text} n
  if (( len <= max )); then
    printf '%s' "$text"
    return 0
  fi
  # zsh: ${var:0:len} treats a non-numeric third part as modifiers ("max-1" → `m`).
  # Use character subscripts [1,n] (1-based) with an arithmetic end index instead.
  n=$(( max - 1 ))
  (( n < 1 )) && n=1
  printf '%s…' "${text[1,n]}"
}
# Format a pattern row for fzf or plain display
_pattern_list_item_format() {
  local name="$1"
  local desc="$2"
  local mode="${3:-plain}"
  if [[ "$mode" == fzf ]]; then
    local dim=$'\e[2m' reset=$'\e[0m'
    desc=$(_pattern_list_item_truncate_desc "$desc" 56)
    printf '%s%s    %s%s' "$name" "$dim" "$desc" "$reset"
  else
    desc=$(_pattern_list_item_truncate_desc "$desc" 64)
    printf '%s — %s' "$name" "$desc"
  fi
}
# Emit picker lines for fzf or plain display
_pattern_list_lines() {
  local patterns_tsv="$1"
  local line name desc display picker_mode
  local use_fzf=$(( _CAPS[fzf] ))
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name="${line%%$'\t'*}"
    desc="${line#*$'\t'}"
    [[ "$desc" == "$line" ]] && desc=""
    [[ -z "$desc" ]] && desc="$name"
    desc=$(_pattern_list_sanitize_desc "$desc")
    picker_mode=plain
    (( use_fzf )) && picker_mode=fzf
    display=$(_pattern_list_item_format "$name" "$desc" "$picker_mode")
    printf '%s\t%s\n' "$name" "$display"
  done <<<"$patterns_tsv"
}
# Build the header body for the fzf pattern picker (passed to fzf --header; gum filter uses same text).
_pattern_list_header() {
  local title line2
  title="Select a pattern"
  line2="Enter run  Ctrl-/ preview  Ctrl-O edit  Ctrl-R reload  ? help  Esc cancel"
  printf '%s\n%s' "$title" "$line2"
}

# Check if a URL is a YouTube URL
_url_is_youtube() { [[ "${1:-}" =~ '^https://(www[.])?(youtube[.]com|youtu[.]be)' ]]; }
# Check if a pattern is a YouTube pattern (exit status of [[ is the function result).
_url_pattern_implies_yt() {
  local pattern="${1:l}"
  [[ "$pattern" == *youtube* || "$pattern" == *yt* ]]
}

# Read input from clipboard or stdin
_ui_input_read() {
  if [[ ! -t 0 ]]; then
    cat -
  else
    local clip
    clip=$(_ui_clip) || _ui_log_fatal "no input available (clipboard empty or unsupported)"
    [[ -n "$clip" ]] || _ui_log_fatal "no input available (clipboard empty or unsupported)"
    printf '%s' "$clip"
  fi
}
# Render output via glow, bat, or cat.
_ui_render_markdown() {
  local result="$1"
  if (( _CAPS[glow] )); then
    # Stdin must be explicit `-` for pipe input per glow CLI docs. Clear NO_COLOR for ANSI output.
    ( unset NO_COLOR 2>/dev/null; printf '%s\n' "$result" | glow -s "${GLOW_STYLE:-dark}" - )
  elif (( _CAPS[bat] )); then
    printf '%s\n' "$result" | bat --language=md --style=plain --color=always --paging=never
  else
    printf '%s\n' "$result"
  fi
}

# Fills _fabric_common_argv_tail from globals MODEL, OUTPUT, COPY, STRATEGY, VARS (fabric-ai repeated flags).
_fabric_merge_common_flags() {
  _fabric_common_argv_tail=()
  [[ -n "$MODEL" ]] && _fabric_common_argv_tail+=(--model "$MODEL")
  [[ -n "$OUTPUT" ]] && _fabric_common_argv_tail+=(--output "$OUTPUT")
  [[ "$COPY" == "1" ]] && _fabric_common_argv_tail+=(--copy)
  [[ -n "$STRATEGY" ]] && _fabric_common_argv_tail+=(--strategy "$STRATEGY")
  (( ${#VARS[@]} > 0 )) && _fabric_common_argv_tail+=("${VARS[@]}")
  return 0
}

# Run a Fabric pattern with a spinner
_fabric_run_tui() {
  local msg="$1" pipe_stdin="$2" stdin="$3" result
  shift 3
  if [[ "$RAW" == "1" ]]; then
    if [[ "$pipe_stdin" == "1" ]]; then
      printf '%s' "$stdin" | fabric-ai "$@"
    else
      fabric-ai "$@"
    fi
  elif [[ -n "$OUTPUT" ]]; then
    if [[ "$pipe_stdin" == "1" ]]; then
      printf '%s' "$stdin" | _ui_spinner "$msg" -- fabric-ai "$@"
    else
      _ui_spinner "$msg" -- fabric-ai "$@"
    fi
  else
    if [[ "$pipe_stdin" == "1" ]]; then
      result=$(printf '%s' "$stdin" | _ui_spinner "$msg" -- fabric-ai "$@")
    else
      result=$(_ui_spinner "$msg" -- fabric-ai "$@")
    fi
    _ui_render_markdown "$result"
  fi
}
# RAW: run fabric-ai as-is; else capture stdout and render (no spinner) — e.g. show --readpattern.
_fabric_plain_capture_render() {
  local result
  if [[ "$RAW" == "1" ]]; then
    fabric-ai "$@"
  else
    result=$(fabric-ai "$@")
    _ui_render_markdown "$result"
  fi
}
# Run a command with a spinner
_fabric_spinner_run() {
  local title="$1"; shift
  if [[ "$RAW" == "1" ]]; then
    "$@"
  else
    _ui_spinner "$title" -- "$@"
  fi
}
# RAW: run producer; else producer | _ui_table (TSV listing commands).
_ui_table_show() {
  if [[ "$RAW" == "1" ]]; then
    "$@"
  else
    "$@" | _ui_table
  fi
}

# Build YouTube arguments
_fabric_build_yt_args() {
  [[ "$YT_TIMESTAMPS" == "1" ]] && _ui_print_line "--transcript-with-timestamps"
  [[ "$YT_COMMENTS"     == "1" ]] && _ui_print_line "--comments"
  [[ "$YT_METADATA"     == "1" ]] && _ui_print_line "--metadata"
  [[ "$YT_PLAYLIST"     == "1" ]] && _ui_print_line "--playlist"
  return 0
}
# Run a Fabric pattern
_fabric_exec_stdin() {
  local pattern="$1" input="$2"
  local -a args=(--pattern "$pattern")
  _fabric_merge_common_flags
  args+=("${_fabric_common_argv_tail[@]}")
  _fabric_run_tui "Running ${pattern}" 1 "$input" "${args[@]}"
}
# Run a Fabric pattern on a YouTube URL
_fabric_exec_youtube() {
  local pattern="${1:-}" url="${2:-}" built
  local -a yt_args=() args

  [[ -n "$pattern" && -n "$url" ]] || _ui_log_fatal "pattern and URL are required"
  built=$(_fabric_build_yt_args)
  [[ -n "$built" ]] && yt_args=("${(@f)built}")
  args=(-y "$url" --pattern "$pattern" "${yt_args[@]}")
  _fabric_merge_common_flags
  args+=("${_fabric_common_argv_tail[@]}")
  _fabric_run_tui "Running ${pattern} on YouTube URL" 0 "" "${args[@]}"
}
# Run a Fabric pattern on a scrape URL
_fabric_exec_scrape() {
  local url="$1" pattern="${2:-}"
  local -a args=(-u "$url")
  [[ -n "$pattern" ]] && args+=(--pattern "$pattern")
  _fabric_merge_common_flags
  args+=("${_fabric_common_argv_tail[@]}")
  _fabric_run_tui "Scraping ${url}" 0 "" "${args[@]}"
}

# Default command: run the interactive picker
_xc_fabric_interactive() {
  local patterns_tsv
  local selected
  local input
  local header_body
  local picker_lines

  patterns_tsv=$(_pattern_list)
  if [[ "$RAW" == "1" ]]; then
    [[ -n "$patterns_tsv" ]] && printf '%s\n' "$patterns_tsv"
    return 0
  fi

  [[ -n "$patterns_tsv" ]] || return 0
  header_body=$(_pattern_list_header)
  picker_lines=$(_pattern_list_lines "$patterns_tsv")
  selected=$(printf '%s\n' "$picker_lines" | _ui_filter --header "$header_body" | awk -F'\t' '{print $1}' || true)
  [[ -n "$selected" ]] || return 0

  input=$(_ui_input_read)
  _fabric_exec_stdin "$selected" "$input"
}
# Run a Fabric pattern
_xc_fabric_cmd_run() {
  local pattern="${1:-}"
  local url=""
  local input

  [[ -n "$pattern" ]] || _ui_log_fatal "pattern is required"
  shift || true

  if [[ -n "${1:-}" ]] && _url_is_youtube "$1"; then
    url="$1"
    shift || true
  elif [[ -n "${1:-}" && "$1" =~ '^https?://' ]]; then
    url="$1"
    shift || true
  fi

  if [[ -n "$url" ]] && _url_is_youtube "$url"; then
    _ui_log_info "YouTube URL detected - using -y mode"
    _fabric_exec_youtube "$pattern" "$url"
  elif [[ -n "$url" ]]; then
    _fabric_exec_scrape "$url" "$pattern"
  elif _url_pattern_implies_yt "$pattern"; then
    url=$(_ui_prompt "YouTube URL: ")
    [[ -n "$url" ]] || return 0
    _fabric_exec_youtube "$pattern" "$url"
  else
    input=$(_ui_input_read)
    _fabric_exec_stdin "$pattern" "$input"
  fi
}
# List patterns
_xc_fabric_cmd_ls() { _ui_table_show _pattern_list; }
# Update patterns
_xc_fabric_cmd_update() { _fabric_spinner_run "Updating patterns" fabric-ai -U; }
# Show a pattern
_xc_fabric_cmd_show() {
  local pattern="${1:-}"
  [[ -n "$pattern" ]] || _ui_log_fatal "pattern is required"
  _fabric_plain_capture_render --readpattern "$pattern"
}
# List strategies
_xc_fabric_cmd_strategies() { _ui_table_show fabric-ai --liststrategies; }
# Scrape a URL
_xc_fabric_cmd_scrape() {
  local url="${1:-}"
  local pattern="${2:-}"
  [[ -n "$url" ]] || _ui_log_fatal "url is required"

  if _url_is_youtube "$url"; then
    _fabric_exec_youtube "${pattern:-extract_wisdom}" "$url"
  else
    _fabric_exec_scrape "$url" "$pattern"
  fi
}

# Main entrypoint
main() {
  if [[ "${1:-}" == "--reload-list" ]]; then
    _boot_paths
    _boot_caps
    local patterns_tsv
    patterns_tsv=$(_pattern_list)
    _pattern_list_lines "$patterns_tsv"
    exit 0
  fi

  _boot_paths
  _boot_caps
  _boot_clip
  _boot_check_deps

  case "${1:-}" in
    run)
      _xc_fabric_cmd_run "${usage_pattern:-}" "${usage_url:-}"
      ;;
    ls)
      _xc_fabric_cmd_ls
      ;;
    update)
      _xc_fabric_cmd_update
      ;;
    show)
      if [[ -z "${usage_pattern:-}" ]]; then
        usage zsh "${0:a}" show --help >&2
        exit 1
      fi
      _xc_fabric_cmd_show "${usage_pattern:-}"
      ;;
    strategies)
      _xc_fabric_cmd_strategies
      ;;
    scrape)
      if [[ -z "${usage_url:-}" ]]; then
        usage zsh "${0:a}" scrape --help >&2
        exit 1
      fi
      _xc_fabric_cmd_scrape "${usage_url:-}" "${usage_pattern:-}"
      ;;
    '')
      _xc_fabric_interactive
      ;;
    *)
      usage zsh "${0:a}" --help >&2
      exit 1
      ;;
  esac
}

trap '_ui_log_error "xc-fabric: failed at line $LINENO"' ERR

main "$@"
