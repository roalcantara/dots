#!/usr/bin/env -S usage zsh
# shellcheck shell=bash disable=SC2296,SC2298,SC2178,SC2206

#USAGE version "0.1.0"
#USAGE about "Interactive launcher for xc-* tools"
#USAGE cmd "list" help="Print discovered tools (name, path, summary)" {
#USAGE   example "xc list"
#USAGE }
#USAGE cmd "up" help="Run system and package maintenance updates" {
#USAGE   example "xc up"
#USAGE }
#USAGE cmd "treeify" help="Convert text into a valid tree output" {
#USAGE   arg "[text]" help="Text to convert into a tree"
#USAGE   example "xc treeify '--- src/\n----- components/\n------- app/\n--------- index.js'"
#USAGE   example "pbpaste | xc treeify"
#USAGE }
#USAGE example "xc"
#USAGE example "xc list"
#USAGE example "xc up"
#USAGE example "pbpaste | xc treeify"

readonly XC_LAUNCHER_SELF="${${(%):-%x}:a}"

_xc_bin_dir() {
  print -r -- "${XC_BIN_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bin}"
}

_xc_ensure_path() {
  local bindir="$(_xc_bin_dir)"
  [[ -d "$bindir" ]] && export PATH="${bindir}:${PATH}"
}

_xc_summary() {
  local tool_path="$1" json about
  json=$(usage generate json -f "$tool_path" 2>/dev/null) || {
    print -r -- '(no usage spec)'
    return 0
  }
  about=$(print -r -- "$json" | jq -r '.about // "(no description)"' 2>/dev/null)
  print -r -- "${about:-(no description)}"
}

# Discover flat xc-* executables; print TSV rows: name<TAB>path<TAB>summary
_xc_discover() {
  local bindir="$(_xc_bin_dir)"
  local -A seen_paths=()
  local name tool_path resolved summary

  [[ -d "$bindir" ]] || return 0

  for tool_path in "$bindir"/xc-*(.N); do
    [[ -f "$tool_path" ]] || continue
    name="${tool_path:t}"
    [[ "$name" == xc ]] && continue
    [[ "$name" != xc-* ]] && continue
    [[ -x "$tool_path" ]] || continue
    [[ -r "$tool_path" ]] || continue

    resolved="${tool_path:a}"
    [[ -n "${seen_paths[$resolved]:-}" ]] && continue
    seen_paths[$resolved]=1

    summary=$(_xc_summary "$tool_path")
    printf '%s\t%s\t%s\n' "$name" "$resolved" "$summary"
  done
}

_xc_cmd_list() {
  local row name tool_path summary
  while IFS=$'\t' read -r name tool_path summary; do
    [[ -z "$name" ]] && continue
    printf '%-14s  %s\n' "$name" "$summary"
    printf '              %s\n' "$tool_path"
  done < <(_xc_discover)
}

_xc_rows_array() {
  local -a rows=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && rows+=("$line")
  done < <(_xc_discover)
  print -rl -- "${rows[@]}"
}

_xc_has_subcommands() {
  local tool_path="$1" json
  json=$(usage generate json -f "$tool_path" 2>/dev/null) || return 1
  print -r -- "$json" | jq -e '.cmd.subcommands | length > 0' >/dev/null 2>&1
}

_xc_list_subcommands() {
  local tool_path="$1" json
  json=$(usage generate json -f "$tool_path" 2>/dev/null) || return 1
  print -r -- "$json" | jq -r '.cmd.subcommands | to_entries[] | "\(.key)\t\(.value.help // .key)"' 2>/dev/null
}
_xc_fzf_pick_tool() {
  local rows="$1"
  local preview="usage zsh {2} --help"

  printf '%s\n' ${(ps:\n:)rows} | command fzf --ansi \
    --delimiter=$'\t' --with-nth=1,3 \
    --prompt='xc ❯ ' \
    --header='Tool — usage help in preview (↵ run, Esc cancel)' \
    --preview-window='right:60%:wrap' \
    --preview="$preview" \
    --bind='ctrl-/:toggle-preview'
}

_xc_fzf_pick_sub() {
  local tool_path="$1" name="$2" rows="$3"
  local preview="usage zsh ${(q)tool_path} {1} --help"

  printf '%s\n' ${(ps:\n:)rows} | command fzf --ansi \
    --delimiter=$'\t' --with-nth=1,2 \
    --prompt="${name} ❯ " \
    --header='Subcommand (↵ run, Esc skip)' \
    --preview-window='right:60%:wrap' \
    --preview="$preview" \
    --bind='ctrl-/:toggle-preview'
}

_xc_prompt_extra_args() {
  if command -v gum >/dev/null 2>&1; then
    gum input --placeholder 'Extra args (optional, Enter for none)' --value '' 2>/dev/null || true
  else
    print -r -- ''
  fi
}

_xc_run_tool() {
  _xc_ensure_path
  local name="" tool_path="" sub="" args="" picked subs_row
  local -a run extra
  local -a rows=("${(@f)$(_xc_rows_array)}")

  if (( ! ${#rows[@]} )); then
    print -u2 "xc: no xc-* tools found in $(_xc_bin_dir)"
    exit 1
  fi

  if command -v fzf >/dev/null 2>&1; then
    picked=$(_xc_fzf_pick_tool "${(j:\n:)rows}")
    [[ -z "$picked" ]] && exit 0
    IFS=$'\t' read -r name tool_path _ <<<"$picked"
  elif command -v gum >/dev/null 2>&1; then
    local -a names=()
    local row n p s
    for row in "${rows[@]}"; do
      IFS=$'\t' read -r n p s <<<"$row"
      names+=("$n")
    done
    name=$(printf '%s\n' "${names[@]}" | gum choose --header 'xc tool') || exit 0
    for row in "${rows[@]}"; do
      IFS=$'\t' read -r n p s <<<"$row"
      [[ "$n" == "$name" ]] && tool_path="$p" && break
    done
  else
    print -u2 "xc: install fzf (preferred) or gum for the interactive launcher"
    print -u2 "xc: run 'xc list' to see available tools"
    exit 1
  fi

  if _xc_has_subcommands "$tool_path"; then
    local -a sub_rows=()
    local sub_name sub_help
    while IFS=$'\t' read -r sub_name sub_help; do
      [[ -z "$sub_name" ]] && continue
      sub_rows+=("${sub_name}"$'\t'"${sub_help}")
    done < <(_xc_list_subcommands "$tool_path")

    if (( ${#sub_rows[@]} )) && command -v fzf >/dev/null 2>&1; then
      subs_row=$(_xc_fzf_pick_sub "$tool_path" "$name" "${(j:\n:)sub_rows}")
      [[ -n "$subs_row" ]] && IFS=$'\t' read -r sub _ <<<"$subs_row"
    elif (( ${#sub_rows[@]} )) && command -v gum >/dev/null 2>&1; then
      local -a sub_names=()
      for subs_row in "${sub_rows[@]}"; do
        IFS=$'\t' read -r sub _ <<<"$subs_row"
        sub_names+=("$sub")
      done
      sub=$(printf '%s\n' "${sub_names[@]}" | gum choose --header "${name} subcommand" 2>/dev/null) || sub=""
    fi
  fi

  args=$(_xc_prompt_extra_args)
  run=(command "$name")
  [[ -n "$sub" ]] && run+=("$sub")
  [[ -n "${args//[[:space:]]/}" ]] && extra=(${=args}) && run+=("${extra[@]}")

  "${run[@]}"
  exit $?
}

_xc_cmd_treeify() {
  if [ -n "$usage_text" ]; then
    if command -v pbpaste >/dev/null 2>&1; then
      input="$(pbpaste)"
    else
      echo "No clipboard utility found (pbpaste). Pass input via stdin instead." >&2
      exit 1
    fi
  else
    input="$(cat)"
  fi

  python3 - <<'PY' "$input"
import re
import sys

raw = sys.argv[1]

lines = []
for line in raw.splitlines():
    s = line.rstrip()
    if not s.strip():
        continue
    lines.append(s)

# Convert pseudo-tree markers like:
#   - src/
#   --- components/
#   ----- app/
#   ------- index.js
#
# into a structured tree with connectors.
# This supports both the '---' style and normal indented lines.

class Node:
    def __init__(self, name):
        self.name = name
        self.children = []

root = Node("")
stack = [root]

for line in lines:
    # preserve indentation from the incoming pseudo-list
    stripped = line.lstrip(" ")
    indent = len(line) - len(stripped)

    # detect pseudo marker depth
    match = re.match(r"^(-+)\s*(.*)$", stripped)
    if match:
        marker = match.group(1)
        name = match.group(2).strip()
        depth = max(0, len(marker) // 3)
    else:
        # plain root or nested item
        name = stripped.strip()
        depth = indent // 2

    if not name:
        continue

    # normalize a single root item like "src/" to a node
    if depth == 0 and not root.children:
        node = Node(name)
        root.children.append(node)
        stack = [root, node]
        continue

    # walk up stack by effective depth
    while len(stack) > 1 and depth <= (len(stack) - 1):
        stack.pop()

    node = Node(name)
    stack[-1].children.append(node)
    stack.append(node)

def render(nodes, prefix=""):
    out = []
    for i, node in enumerate(nodes):
        is_last = i == len(nodes) - 1
        connector = "└── " if is_last else "├── "
        out.append(f"{prefix}{connector}{node.name}")
        child_prefix = prefix + ("    " if is_last else "│   ")
        if node.children:
            out.extend(render(node.children, child_prefix))
    return out

result = render(root.children)
if result:
    print("\n".join(result))
else:
    print(raw.strip())
PY
}

_xc_main() {
  case "${1:-}" in
    up)
      gum log --time Datetime --level info "brew autoremove && brew update --auto-update --force --verbose && brew upgrade --cask --force --yes && brew bundle check --install --verbose && brew cleanup --prune=all && brew doctor..."
      brew autoremove && brew update --auto-update --force --verbose && brew upgrade --cask --force --yes && brew bundle check --install --verbose && brew cleanup --prune=all && brew doctor
      exit 0
      ;;
    list)
      _xc_cmd_list
      exit 0
      ;;
    treeify)
      _xc_cmd_treeify
      exit 0
      ;;
    '')
      _xc_run_tool
      ;;
    *)
      print -u2 "xc: unknown command: $1 (try: xc list)"
      exit 1
      ;;
  esac
}

_xc_ensure_path
_xc_main "$@"
