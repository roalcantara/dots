#!/usr/bin/env -S usage zsh
# shellcheck shell=bash disable=SC2154

#? pss 0.1.0
#? License RIT (Robot Institute of Technology)

#USAGE version "0.1.0"
#USAGE about "Reveals the pass|gopass key value"
#USAGE arg "[key]" help="Secret path in gopass"
#USAGE flag "-c --cp" help="Copy the password value into the clipboard"
#USAGE flag "-e --export <path>" help="Export secrets to a directory"
#USAGE example "pss"
#USAGE example "pss tools/bitly.com/token"
#USAGE example "pss --cp tools/bitly.com/token"
#USAGE example "pss --export /path/to/secrets"

emulate -L zsh
setopt no_unset pipe_fail

key="${usage_key:-}"
cp="${usage_cp:-false}"
export_path="${usage_export:-}"

_has_gum() {
  [[ -t 1 && "${TERM:-}" != "dumb" ]] && command -v gum >/dev/null 2>&1
}

_has_fzf() {
  [[ -t 1 && "${TERM:-}" != "dumb" ]] && command -v fzf >/dev/null 2>&1
}

if ! command -v gopass &>/dev/null; then
  echo "Error: gopass is not installed" >&2
  exit 1
fi

if [[ -n "$export_path" ]]; then
  mkdir -p "$export_path"
  items=$(gopass ls --flat 2>/dev/null || true)
  for it in ${(f)items}; do
    [[ -z "$it" ]] && continue
    out_file="${export_path}/${it//\//_}.secret.yml"
    gopass show -y -f -n "$it" > "$out_file" 2>/dev/null || true
  done
  exit 0
fi

if [[ -z "$key" ]]; then
  if [[ ! -t 1 ]]; then
    echo "Error: key argument required in non-interactive environment" >&2
    exit 1
  fi
  items=$(gopass ls --flat 2>/dev/null || true)
  if [[ -z "$items" ]]; then
    echo "No secrets found in gopass" >&2
    exit 0
  fi
  if _has_gum; then
    key=$(echo "$items" | gum filter --limit=1)
  elif _has_fzf; then
    key=$(echo "$items" | fzf)
  else
    echo "Error: interactive selection requires gum or fzf" >&2
    exit 1
  fi
  [[ -z "$key" ]] && exit 0
fi

if [[ "$cp" == "true" ]]; then
  exec gopass show --clip "$key"
else
  exec gopass show -n --password "$key"
fi
