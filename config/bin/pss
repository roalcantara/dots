#!/usr/bin/env -S usage zsh
#USAGE version "0.1.0"
#USAGE about "Reveals the pass|gopass key value"
#USAGE arg "[key]" help="Secret path in gopass"
#USAGE complete "plugin" run="mise plugins ls"
#USAGE flag "-e --export <export_path>" help="Export gopass secrets to path"
#USAGE example "pss"
#USAGE example "pss tools/bitly.com/token"
#USAGE example "pss export /path/to/secrets"
source /Users/roalcantara/Work/dots/config/bin/src/helpers
h::needs_command gopass

if [[ -n "${usage_export_path:-}" ]]; then
  mkdir -p "$usage_export_path"
  items=$(gopass ls --flat 2>/dev/null || true)
  for it in ${(f)items}; do
    [[ -z "$it" ]] && continue
    out_file="${usage_export_path}/${it//\//_}.secret.yml"
    gopass show -y -f -n "$it" > "$out_file" 2>/dev/null || true
  done
  exit 0
fi

if [[ -z "${usage_key:-}" ]]; then
  if [[ ! -t 1 ]]; then
    h::puts fatal "key argument required in non-interactive environment"
  fi
  items=$(gopass ls --flat 2>/dev/null || true)
  if h::has_command gum; then
    usage_key=$(echo "$items" | gum filter --limit=1)
  elif h::has_command fzf; then
    usage_key=$(echo "$items" | fzf)
  else
    h::puts fatal "Interactive selection requires gum or fzf"
  fi
fi

[[ -z "${usage_key:-}" ]] && exit 0

exec gopass show -n --password "$usage_key"