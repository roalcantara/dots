#!/usr/bin/env -S usage zsh
# shellcheck shell=bash disable=SC2154

#USAGE version "0.1.0"
#USAGE about "List, select, and run Yarn workspace scripts"
#USAGE arg "[package]" help="Target Yarn workspace package name"
#USAGE arg "[script]" help="Script name inside package.json"
#USAGE flag "--dry-run" help="Print generated command without executing"
#USAGE example "yw"
#USAGE example "yw my-pkg test"
#USAGE example "yw my-pkg test --dry-run"

emulate -L zsh
setopt no_unset pipe_fail

pkg="${usage_package:-}"
script_name="${usage_script:-}"
dry_run="${usage_dry_run:-false}"

_has_gum() {
  [[ -t 1 && "${TERM:-}" != "dumb" ]] && command -v gum >/dev/null 2>&1
}

_has_fzf() {
  [[ -t 1 && "${TERM:-}" != "dumb" ]] && command -v fzf >/dev/null 2>&1
}

if [[ -n "$pkg" && -n "$script_name" ]]; then
  cmd="yarn workspace $pkg $script_name"
  if [[ "$dry_run" == "true" ]]; then
    print -r -- "$cmd"
    exit 0
  fi
  exec yarn workspace "$pkg" "$script_name"
fi

if ! command -v yarn &>/dev/null; then
  echo "Error: yarn is not installed" >&2
  exit 1
fi

ws_raw=$(yarn workspaces list --json 2>/dev/null || true)
if [[ -z "$ws_raw" ]]; then
  echo "Error: No workspaces found or not in a Yarn workspace" >&2
  exit 1
fi

local -a ws_lines
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  name=$(echo "$line" | jq -r '.name')
  location=$(echo "$line" | jq -r '.location')
  ws_lines+=("$name ($location)")
done < <(echo "$ws_raw" | jq -c .)

if [[ -z "$pkg" ]]; then
  if [[ ! -t 1 ]]; then
    echo "Error: package argument required in non-interactive environment" >&2
    exit 1
  fi
  if _has_gum; then
    selected_line=$(printf '%s\n' "${ws_lines[@]}" | gum choose --header "Pick one package:")
  elif _has_fzf; then
    selected_line=$(printf '%s\n' "${ws_lines[@]}" | fzf --header "Pick one package:")
  else
    echo "Error: interactive selection requires gum or fzf" >&2
    exit 1
  fi
  [[ -z "$selected_line" ]] && exit 0
  pkg=$(echo "$selected_line" | awk '{print $1}')
fi

ws_loc=""
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  n=$(echo "$line" | jq -r '.name')
  if [[ "$n" == "$pkg" ]]; then
    ws_loc=$(echo "$line" | jq -r '.location')
    break
  fi
done < <(echo "$ws_raw" | jq -c .)

if [[ -z "$ws_loc" ]]; then
  echo "Error: Workspace '$pkg' not found" >&2
  exit 1
fi

pkg_file="$ws_loc/package.json"
if [[ ! -f "$pkg_file" ]]; then
  echo "Error: package.json not found in $ws_loc" >&2
  exit 1
fi

scripts_raw=$(jq -r '.scripts | to_entries[] | "\(.key): \(.value)"' "$pkg_file" 2>/dev/null || true)
if [[ -z "$scripts_raw" ]]; then
  echo "No scripts found in $pkg" >&2
  exit 0
fi

if [[ -z "$script_name" ]]; then
  if [[ ! -t 1 ]]; then
    echo "Error: script argument required in non-interactive environment" >&2
    exit 1
  fi
  if _has_gum; then
    selected_script=$(echo "$scripts_raw" | gum filter --header "Pick one script from $pkg:")
  elif _has_fzf; then
    selected_script=$(echo "$scripts_raw" | fzf --header "Pick one script from $pkg:")
  else
    echo "Error: interactive selection requires gum or fzf" >&2
    exit 1
  fi
  [[ -z "$selected_script" ]] && exit 0
  script_name=$(echo "$selected_script" | cut -d: -f1 | xargs)
fi

cmd="yarn workspace $pkg $script_name"
if [[ "$dry_run" == "true" ]]; then
  print -r -- "$cmd"
  exit 0
fi

exec yarn workspace "$pkg" "$script_name"
