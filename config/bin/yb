#!/usr/bin/env -S usage zsh
# shellcheck shell=bash disable=SC2154,SC2168,SC2046
# yb — the yabai CLI behind the Karabiner fn layer (config/karabiner, docs/TILING.md).
# Spaces are labelled s1…s10: s1–s5 on the built-in screen, s6–s10 on the external one.
# DOTS_YABAI overrides the yabai binary (tests); failures go to ~/.local/state/dots/yb.log.

#USAGE version "0.2.0"
