#!/usr/bin/env bash
# This script audits a macOS system for leftover artifacts from Nix and Flox installations. It checks for LaunchDaemons, the /nix directory, APFS volumes, synthetic.conf entries, build users/groups, and various system/user files and directories. It also checks shell configuration files for Nix/Flox startup scripts. If any artifacts are found, it suggests commands to remove them.
# chmod +x ~/.config/bin/purge_flox
# ./config/bin/purge_flox

# Color formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "=================================================="
echo "      Auditing macOS for Nix & Flox Leftovers     "
echo "=================================================="
echo ""

SUGGESTIONS=()

add_cmd() {
    SUGGESTIONS+=("$1")
}

# 1. Check LaunchDaemons (Background Services)
echo "Checking LaunchDaemons..."
DAEMONS=(
    "/Library/LaunchDaemons/org.nixos.nix-daemon.plist"
    "/Library/LaunchDaemons/org.nixos.activate-system.plist"
    "/Library/LaunchDaemons/org.nixos.darwin-store.plist"
)

for daemon in "${DAEMONS[@]}"; do
    if [ -f "$daemon" ]; then
        echo -e "  [${RED}FOUND${NC}] LaunchDaemon: $daemon"
        add_cmd "sudo launchctl unload $daemon 2>/dev/null && sudo rm -f $daemon"
    fi
done

# 2. Check /nix Directory and APFS Volume
echo "Checking /nix and APFS Volumes..."
if [ -d "/nix" ] || [ -L "/nix" ]; then
    echo -e "  [${RED}FOUND${NC}] /nix mountpoint/directory exists."

    # Check if /nix is an active APFS mount
    if mount | grep -q "on /nix "; then
        echo -e "  [${RED}FOUND${NC}] /nix is currently mounted as an APFS volume."
        add_cmd "sudo diskutil unmount force /nix"
    fi

    # Find APFS volume identifier matching 'Nix Store'
    NIX_VOLUME=$(diskutil list | grep -i "Nix Store" | awk '{print $NF}')
    if [ -n "$NIX_VOLUME" ]; then
        echo -e "  [${RED}FOUND${NC}] APFS Nix Volume identifier: $NIX_VOLUME"
        add_cmd "sudo diskutil apfs deleteVolume $NIX_VOLUME"
    fi
fi

# 3. Check /etc/synthetic.conf
if [ -f "/etc/synthetic.conf" ] && grep -q -E "^nix[[:space:]]" /etc/synthetic.conf; then
    echo -e "  [${RED}FOUND${NC}] Entry for 'nix' in /etc/synthetic.conf"
    add_cmd "sudo sed -i '' '/^nix[[:space:]]/d' /etc/synthetic.conf"
    add_cmd "sudo rm -rf /nix"
fi

# 4. Check Build Users and Group
echo "Checking macOS Users and Groups..."
NIX_USERS=$(dscl . -list /Users | grep -E '^(_)?nixbld' || true)
if [ -n "$NIX_USERS" ]; then
    echo -e "  [${RED}FOUND${NC}] Nix build users:"
    echo "$NIX_USERS" | sed 's/^/    - /'
    add_cmd "for u in \$(dscl . -list /Users | grep -E '^(_)?nixbld'); do sudo dscl . -delete \"/Users/\$u\"; done"
fi

NIX_GROUP=$(dscl . -list /Groups | grep -E '^(_)?nixbld' || true)
if [ -n "$NIX_GROUP" ]; then
    echo -e "  [${RED}FOUND${NC}] Nix build group(s): $NIX_GROUP"
    add_cmd "for g in \$(dscl . -list /Groups | grep -E '^(_)?nixbld'); do sudo dscl . -delete \"/Groups/\$g\"; done"
fi

# 5. Check System and User Files/Directories
echo "Checking Files and Directories..."
PATHS=(
    "/etc/nix"
    "/etc/profile.d/nix.sh"
    "/usr/local/share/flox"
    "/var/root/.nix-profile"
    "/var/root/.nix-defexpr"
    "/var/root/.nix-channels"
    "$HOME/.nix-profile"
    "$HOME/.nix-defexpr"
    "$HOME/.nix-channels"
    "$HOME/.cache/nix"
    "$HOME/.config/nix"
    "$HOME/.local/share/flox"
    "$HOME/.config/flox"
    "$HOME/.cache/flox"
)

for path in "${PATHS[@]}"; do
    if [ -e "$path" ]; then
        echo -e "  [${RED}FOUND${NC}] Path: $path"
        if [[ "$path" == /var/root* ]] || [[ "$path" == /etc* ]] || [[ "$path" == /usr* ]]; then
            add_cmd "sudo rm -rf \"$path\""
        else
            add_cmd "rm -rf \"$path\""
        fi
    fi
done

# 6. Check Shell Profiles
echo "Checking Shell Configurations..."
SHELL_FILES=(
    "/etc/zshrc"
    "/etc/bashrc"
    "/etc/profile"
    "$HOME/.zshrc"
    "$HOME/.bashrc"
    "$HOME/.bash_profile"
    "$HOME/.profile"
)

for sfile in "${SHELL_FILES[@]}"; do
    if [ -f "$sfile" ] && grep -q -i -E "(nix-daemon|flox activate|\.nix-profile)" "$sfile"; then
        echo -e "  [${RED}FOUND${NC}] Nix/Flox startup scripts in: $sfile"
        echo "    -> Please manually edit $sfile and remove Nix/Flox lines."
    fi
done

echo ""
echo "=================================================="
echo "                   Audit Result                   "
echo "=================================================="

if [ ${#SUGGESTIONS[@]} -eq 0 ]; then
    echo -e "${GREEN}No Nix or Flox artifacts were found! Your system is clean.${NC}"
else
    echo -e "${YELLOW}Artifacts detected. Execute the following commands to complete removal:${NC}"
    echo ""
    for cmd in "${SUGGESTIONS[@]}"; do
        echo "$cmd"
    done
    echo ""
    echo "Note: If changes were made to /etc/synthetic.conf, restart your Mac afterward to update mount points."
fi