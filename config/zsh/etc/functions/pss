##? Reveals the pass|gopass 'key' value
##?
##? Usage:
##?      pss [KEY] [ options ]
##?
##? Options:
##?     -h, --help                    Show this screen.
##?     -c, --cp                      Copy the password value into the clipboard. [default: false].
##?     -e <PATH>, --export=<PATH>    Export secrets to a directory.
##?
##? Examples:
##?     pss
##?     pss tools/bitly.com/token
##?     pss --cp tools/bitly.com/token
##?     pss --export /path/to/secrets

pss() {
  local -A opts

  # Parse options into opts associative array
  # -D: remove parsed flags from $@
  # -F: fail on unknown flags
  # -E: stop at first non-option
  # -A: store results in associative array
  zparseopts -D -F -E -A opts \
      h=help -help=help  \
      c=cp -cp=cp  \
      e=export -export=export

  # Example usage of parsed options
  if (( ${+opts[-h]} )) || (( ${+opts[--help]} )); then
    autoload -Uz show_usage
    show_usage
    return 0
  fi

  local export="${opts[-e]:-${opts[--export]}}"
  local cp="${opts[-c]:-${opts[--cp]}}"
  local long="${opts[-l]:-${opts[--long]}}"

  if [[ -n "$export" ]]; then
    for it in $(gopass ls --flat); do gopass show -y -f -n "$it" > "${export}/${it//\//_}.secret.yml"; done;
    return 0;
  fi

  # Helper function to execute command via ZLE or fallback
  _pss_execute_cmd() {
    local cmd="$1"

    # Check if ZLE is active
    if [[ -n "$ZLE_STATE" ]]; then
      # ZLE is active - use ZLE widget approach
      BUFFER="$cmd"
      zle accept-line
    else
      # ZLE not active - fallback to history + eval
      echo -e "\033[1;32m ❯ $cmd\033[0m"
      print -s "$cmd"     # Add to history
      eval "$cmd"         # Execute immediately
    fi
  }

  if [[ "$cp" == 'true' ]]; then
    # It places the command string into the zsh command line buffer (the editing buffer)
    # The command appears at the prompt as if you had typed it
    # It's immediately executed (as if you pressed Enter)
    _pss_execute_cmd "gopass show -c $1"
    return 0;
  fi

  if [[ -n "$1" ]]; then
    # It places the command string into the zsh command line buffer (the editing buffer)
    # The command appears at the prompt as if you had typed it
    # It's immediately executed (as if you pressed Enter)
    _pss_execute_cmd "gopass show -n --password $1"
    return 0;
  fi

  local it="$(gopass ls --flat | gum filter --limit=1)"
  if [[ -n "$it" ]]; then
    _pss_execute_cmd "gopass show -n --password $it"
  fi
}

pss "$@"

