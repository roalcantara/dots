#!/usr/bin/env bash
# shellcheck shell=bash disable=SC2154,SC2004

##? Show help information for an autoloaded function or file
##?
##? Usage:
##?    show_usage [function_name | file_path]
##?
##? Arguments:
##?    function_name | file_path   Name of the function to show help for,
##?                                or a path to a readable file.
##?                                If not provided, shows help for the calling function.
##?
##? Options:
##?    -h, --help    Show this screen
##?
##? Example: show_usage puts
##?
##? Implementation delegates to xc-usage print (standalone, see config/bin/xc-usage).

show_usage() {
  local target="${1:-${funcstack[2]}}"
  local script=""

  if [[ -f "$target" ]]; then
    script="$target"
  else
    script="${functions_source[$target]:-}"
    if [[ -z "$script" ]] && (( $+functions[$target] )); then
      autoload -Uz +X "$target"
      script="${functions_source[$target]:-}"
    fi
    if [[ -z "$script" ]]; then
      for dir in ${fpath[@]}; do
        if [[ -f "$dir/$target" ]]; then
          script="$dir/$target"
          break
        fi
      done
    fi
  fi

  if [[ -z "$script" || ! -f "$script" ]]; then
    print -u2 "show_usage: could not resolve help for '$target'"
    return 1
  fi

  command xc-usage print "$script"
}

show_usage "$@"

