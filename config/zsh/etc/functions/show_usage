#!/usr/bin/env zsh
# shellcheck disable=SC2296

##? show_usage - Print ##? help for a Zsh function or script file
##?
##? Usage:
##?   show_usage [function|path]
##?
##? Options:
##?   -h, --help   Show this screen
##?
##? When [function|path] is omitted, uses the calling function name.
##? Delegates to xc-usage print after resolving the source file.

show_usage() {
  emulate -L zsh

  local target="${1:-${funcstack[2]}}"
  local script=""

  if [[ -f "$target" ]]; then
    script="$target"
  else
    script="${functions_source[$target]:-}"
    if [[ -z "$script" ]] && (( $+functions[$target] )); then
      autoload -Uz +X "$target"
      script="${functions_source[$target]:-}"
    fi
    if [[ -z "$script" ]]; then
      local dir
      for dir in ${fpath[@]}; do
        if [[ -f "$dir/$target" ]]; then
          script="$dir/$target"
          break
        fi
      done
    fi
  fi

  if [[ -z "$script" || ! -f "$script" ]]; then
    print -u2 "show_usage: could not resolve help for '${target}'"
    return 1
  fi

  command xc-usage "$script"
}

[[ "$ZSH_EVAL_CONTEXT" == toplevel* ]] && [[ "${(%):-%N}" == */show_usage ]] && show_usage "$@"

