#!/usr/bin/env zsh
# shellcheck shell=bash disable=SC2154,SC1073,SC1058,SC1072,SC1009,SC1036,SC2155,SC2034,SC2120,SC2296,SC2179,SC2066,SC2015,SC1008,SC2296,SC1087

# Handle both Bash and Zsh compatibility
if [[ -n "${BASH_VERSION:-}" ]]; then
  # Bash-specific settings
  set -euo pipefail
  shopt -s nullglob
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  # Zsh-specific settings
  setopt NULL_GLOB
  setopt PIPE_FAIL
fi

# Ensure ownership of a path
# Usage: setup_ownership <path> <section_name> (required_owner)
set_ownership() {
  local TARGET="$1"
  local OWNER="${2:-${UID:-"$USER:$GROUP"}}"

  declare owner
  case "$(uname)" in
  Darwin)
    owner=$(stat -f "%u" "$TARGET" 2>/dev/null || echo "0")
    ;;
  Linux)
    owner=$(stat -c "%u" "$TARGET" 2>/dev/null || echo "0")
    ;;
  esac

  if [[ "$owner" != "$OWNER" ]]; then
    chown -R "$OWNER" "$TARGET" 2>/dev/null || sudo chown -R "$OWNER" "$TARGET" || {
      echo "⚠ Failed to change ownership of $TARGET" >&2
      return 1
    }
  fi
}
# Ensure ownership of a path
# Usage: setup_ownership <path> <section_name> (required_owner)
set_permission() {
  local TARGET="$1"
  local PERM="${2:-"700"}"

  declare perms
  case "$(uname)" in
  Darwin)
    perms=$(stat -f "%Lp" "$TARGET" 2>/dev/null || echo "000")
    ;;
  Linux)
    perms=$(stat -c "%a" "$TARGET" 2>/dev/null || echo "000")
    ;;
  esac

  if [[ "$perms" != "$PERM" ]]; then
    chmod "$PERM" "$TARGET" 2>/dev/null || sudo chmod "$PERM" "$TARGET" || {
      echo "⚠ Failed to set permissions on $TARGET" >&2
      return 1
    }
  fi
}
# Setup directory with proper ownership (without environment variable) as sudo
# Usage: setup_dir <path> <section_name>
setup_dir() {
  local TARGET="$1"
  local OWNER="${2:-${UID:-"$USER:$GROUP"}}"

  # Create directory if it doesn't exist
  if [ ! -d "$TARGET" ]; then
    mkdir -p "$TARGET" 2>/dev/null || sudo mkdir -p "$TARGET" || {
      echo "⚠ Failed to create directory $TARGET" >&2
      return 1
    }
  fi

  # Ensure ownership
  set_ownership "$TARGET" "$OWNER"
}
_zsetup_xdg() {
  USERNAME="$1"
  GROUPNAME="$2"

  # Export XDG variables with fallbacks
  export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
  export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
  export XDG_LOCAL_DIR=${XDG_LOCAL_DIR:-$HOME/.local}
  export XDG_DATA_HOME=${XDG_DATA_HOME:-$XDG_LOCAL_DIR/share}
  export XDG_STATE_HOME=${XDG_STATE_HOME:-$XDG_LOCAL_DIR/state}
  export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/runtime-${USERNAME:-user}}

  # User directories
  export XDG_DESKTOP_DIR=${XDG_DESKTOP_DIR:-$HOME/Desktop}
  export XDG_DOWNLOAD_DIR=${XDG_DOWNLOAD_DIR:-$HOME/Downloads}
  export XDG_DOCUMENTS_DIR=${XDG_DOCUMENTS_DIR:-$HOME/Documents}
  export XDG_MUSIC_DIR=${XDG_MUSIC_DIR:-$HOME/Music}
  export XDG_PICTURES_DIR=${XDG_PICTURES_DIR:-$HOME/Pictures}
  export XDG_VIDEOS_DIR=${XDG_VIDEOS_DIR:-$HOME/Movies}
  export XDG_PROJECTS_DIR=${XDG_PROJECTS_DIR:-$HOME/Projects}
  export XDG_WORKSPACE_DIR=${XDG_WORKSPACE_DIR:-$HOME/Work}

  for dir in "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_LOCAL_DIR" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_DESKTOP_DIR" "$XDG_DOWNLOAD_DIR" "$XDG_DOCUMENTS_DIR" "$XDG_MUSIC_DIR" "$XDG_PICTURES_DIR" "$XDG_VIDEOS_DIR" "$XDG_PROJECTS_DIR" "$XDG_WORKSPACE_DIR" "$XDG_RUNTIME_DIR"; do
    setup_dir "$dir" "$USERNAME:$GROUPNAME"
  done

  set_permission "$XDG_RUNTIME_DIR" "700"
}
_zsetup_zsh() {
  USERNAME="$1"
  GROUPNAME="$2"

  # ZSH directories
  export ZDOTDIR="${ZDOTDIR:-$XDG_CONFIG_HOME/zsh}"
  export ZSH_DATA_DIR="${ZSH_DATA_DIR:-$XDG_DATA_HOME/zsh}"
  export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-$XDG_CACHE_HOME/zsh}"
  export ZSH_COMPCACHE="${ZSH_COMPCACHE:-$ZSH_CACHE_DIR/compcache}"
  export ZDOTDIR_OPT="${ZDOTDIR_OPT:-$ZDOTDIR/opt}"
  export ZDOTDIR_ETC="${ZDOTDIR_ETC:-$ZDOTDIR/etc}"

  # ZSH state files
  export ZSH_COMPDUMP="${ZSH_COMPDUMP:-$ZSH_COMPCACHE/.zcompdump}"
  export HISTFILE="${HISTFILE:-$ZSH_DATA_DIR/.zsh_history}"
  export ZIM_HOME="${ZIM_HOME:-$XDG_DATA_HOME/zim}"

  # Create directories
  for dir in "$ZSH_DATA_DIR" "$ZSH_CACHE_DIR" "$ZSH_COMPCACHE" "$ZIM_HOME"; do
    setup_dir "$dir" "$USERNAME:$GROUPNAME"
  done
}
zsetup() {
  USERNAME="${1:-$(id -un)}"
  GROUPNAME="${2:-$(id -gn)}"

  _zsetup_xdg "$USERNAME" "$GROUPNAME" || {
    echo "⚠ Failed to setup XDG environment variables and directories" >&2
    return 1
  }
  _zsetup_zsh "$USERNAME" "$GROUPNAME" || {
    echo "⚠ Failed to setup ZSH environment variables and directories" >&2
    return 1
  }
}

zsetup "${@}"

