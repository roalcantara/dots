##? Manage dotfiles
##?
##? Usage:
##?      dots [options]
##?
##? Arguments:
##?     env                   Shows environment variables.
##?     path                  Shows path.
##?     fpath                 Shows fpath.
##?     cdpath                Shows cdpath.
##?     zsh                   ZSH subcommands.
##?     palette               Print the ANSI color palette.
##?
##? Options:
##?     --rebuild             Rebuild the ZSH environment.
##?     --benchmark           Benchmark ZSH startup time.
##?     --prof                Profilling ZSH.
##?
##? Examples:
##?     dots
##?     dots env
##?     dots path
##?     dots fpath
##?     dots cdpath
##?     dots palette
##?     dots zsh --benchmark [ measure | store | logs ]
##?     dots zsh --prof [ exec | store | stats | avg | logs ]
##?     dots zsh --prof trace [ --once ]
##?     dots xdg check_runtime_perms
##?     dots xdg ensure_runtime_perms
##?     dots setup local_settings

__get_dir_permissions() {
    local dir="$1"
    local perms owner

    case "$(uname)" in
        Darwin)
            perms=$(stat -f "%Lp" "$dir" 2>/dev/null || echo "000")
            owner=$(stat -f "%u" "$dir" 2>/dev/null || echo "0")
            ;;
        Linux)
            perms=$(stat -c "%a" "$dir" 2>/dev/null || echo "000")
            owner=$(stat -c "%u" "$dir" 2>/dev/null || echo "0")
            ;;
        *)
            echo "000:0"  # Unknown OS fallback
            return 1
            ;;
    esac

    echo "$perms:$owner"
    return 0
}

__setup_local_settings() {
  # It turns out that VSCode and VSCode Insiders shared the same settings up usersettings, keybindkings and snippets
  # In our dotfiles repositopry, these configurations are consolidadted ensuring consistency across both editors.
  #
  # BENEFITS:
  #   - Single source of truth for all VSCode settings
  #   - Identical shortcuts, snippets, and preferences across VSCode and VSCode Insiders
  #   - Zero cognitive load switching between editors
  #   - Version controlled settings with easy rollback
  #
  # ARCHITECTURE:
  #   | VSCODE                             | VSCODE INSIDERS    | CONSOLIDATED SOLUTION               |
  #   | ---------------------------------- | ------------------ | ----------------------------------- |
  #   | ~/.local/share/dots/config/vscode/ | ~/./config/vscode/ | ~/.local/share/dots/config/vscode/  |

  # 1. Validate dotfiles structure
  if [ ! -L "$HOME/.config/vscode" ] && [ ! -d "$HOME/.config/vscode" ]; then
    echo "'~/.config/vscode' does not exist - ensure dotfiles setup completed successfully. Skipping..."
    return 0
  fi

  # 2. Determine platform-specific paths
  local vscode_path vscode_insiders_path
  if is_darwin; then
    vscode_path="$HOME/Library/Application Support/Code/User"
    vscode_insiders_path="$HOME/Library/Application Support/Code - Insiders/User"
  else
    vscode_path="$HOME/.config/Code/User"
    vscode_insiders_path="$HOME/.config/Code - Insiders/User"
  fi

  # 3. Setup VSCode and VSCode Insiders settings
  for editor in "VSCODE:$vscode_path" "VSCODE_INSIDERS:$vscode_insiders_path"; do
    IFS=: read editor_name editor_path <<< "$editor"
    if [ -d "$(dirname "$editor_path")" ]; then
      echo "$editor_name detected - setting up symlinks..."
      ensure_dir "$editor_path"

      rm -rf "$editor_path/settings.json"
      rm -rf "$editor_path/keybindings.json"
      rm -rf "$editor_path/snippets"

      ln -sf "$HOME/.config/vscode/settings.json" "$editor_path/settings.json"
      ln -sf "$HOME/.config/vscode/keybindings.json" "$editor_path/keybindings.json"
      ln -sf "$HOME/.config/vscode/snippets" "$editor_path/snippets"

      echo "$editor_name" "Settings linked successfully! ✔"
    else
      echo "$editor_name not detected - skipping ${editor_name//_/ } setup!"
    fi
  done
  echo "Local settings synchronization complete! ✔✔"
}

dots() {
  case $1 in
  # XDG subcommands
  xdg)
    case $2 in
    check_runtime_perms)
      local perms owner
      IFS=':' read -r perms owner <<< "$(__get_dir_permissions "$XDG_RUNTIME_DIR")"
      if [[ "$perms" != "700" ]] || [[ "$owner" != "${UID:-$(id -u)}" ]]; then
        echo "XDG_RUNTIME_DIR => '$XDG_RUNTIME_DIR' -> '$perms:$owner'! (should be 700:$UID)! Run 'dots xdg ensure_runtime_perms' to fix.."
        return 1
      fi
      echo "XDG_RUNTIME_DIR => '$XDG_RUNTIME_DIR' -> '$perms:$owner'! ✔✔"
      return 0
      ;;
    ensure_runtime_perms)
      local runtime_dir="${XDG_RUNTIME_DIR:-}"
      [[ ! -d "$runtime_dir" ]] && mkdir -p "$runtime_dir" 2>/dev/null || sudo mkdir -p "$runtime_dir"
      IFS=':' read -r perms owner <<< "$(__get_dir_permissions "$runtime_dir")"
      [[ "$perms" != "700" ]] && chmod 700 "$runtime_dir" 2>/dev/null || sudo chmod 700 "$runtime_dir"
      [[ "$owner" != "${UID:-$(id -u)}" ]] && local username="${USERNAME:-$(id -un)}" && chown "$username" "$runtime_dir" 2>/dev/null || sudo chown "$username" "$runtime_dir"
      ;;
    *)
      dots xdg "$(gum filter --limit=1 'check_runtime_perms' 'ensure_runtime_perms')"
      ;;
    esac
    ;;
  # Print the path
  path)
    echo "$PATH" | sed 's/:/\n/g' | uniq -c
    ;;
  # Print the fpath
  fpath)
    echo "${FPATH:?}" | sed 's/:/\n/g' | uniq -c
    ;;
  # Print the cdpath
  cdpath)
    echo "$CDPATH" | sed 's/:/\n/g' | uniq -c
    ;;
  # Print the environment variables
  env)
    env | sort | uniq | bat -l log
    ;;
  # Setup the local settings
  setup)
    case $2 in
    local_settings) __setup_local_settings ;;
    *) dots setup "$(gum filter --limit=1 'local_settings')" ;;
    esac
    ;;
  # Print the ANSI color palette
  palette)
    local lorem="Arma virumque cano Troiae qui primus ab oris"

    # Function to convert ANSI color code to HEX
    ansi_to_hex() {
      local code=$1

      # Standard colors (0-15)
      if ((code <= 15)); then
        local colors=(
          "#000000" "#800000" "#008000" "#808000" "#000080" "#800080" "#008080" "#c0c0c0"
          "#808080" "#ff0000" "#00ff00" "#ffff00" "#0000ff" "#ff00ff" "#00ffff" "#ffffff"
        )
        echo "${colors[$code]}"
        return
      fi

      # 216 colors (16-231): 6x6x6 color cube
      if ((code <= 231)); then
        local adjusted=$((code - 16))
        local r=$((adjusted / 36))
        local g=$(((adjusted % 36) / 6))
        local b=$((adjusted % 6))

        # Convert to 0-255 range
        r=$((r == 0 ? 0 : r * 40 + 55))
        g=$((g == 0 ? 0 : g * 40 + 55))
        b=$((b == 0 ? 0 : b * 40 + 55))

        printf "#%02x%02x%02x" $r $g $b
        return
      fi

      # Grayscale colors (232-255)
      if ((code <= 255)); then
        local gray=$((8 + (code - 232) * 10))
        printf "#%02x%02x%02x" $gray $gray $gray
        return
      fi

      echo "#000000" # fallback
    }

    for i in {0..255}; do
      local hex=$(ansi_to_hex $i)
      print -P -- "ANSI[${i}] \033[38;5;${i}m${lorem}\033[0m ${hex}"
    done
    ;;
  # ZSH subcommands
  zsh)
    local ZSH_BENCHMARK_DIR="$ZDOTDIR/tmp"
    local ZSH_BENCHMARK_FILE="$ZSH_BENCHMARK_DIR/benchmarks.csv"
    local ZSH_PROF_FILE="$ZSH_BENCHMARK_DIR/prof.csv"
    local ZSH_STATS_FILE="$ZSH_BENCHMARK_DIR/startup.csv"
    local ZSH_STATS_TMP_FILE="$ZSH_BENCHMARK_DIR/startup.tmp"

    ensure_tmp_dir_and_files() {
      [[ ! -d "$ZSH_BENCHMARK_DIR" ]] && mkdir -p "$ZSH_BENCHMARK_DIR"
      [[ ! -f "$ZSH_PROF_FILE" ]] && echo "date,command,real,user,sys,total" >"$ZSH_PROF_FILE"
      [[ ! -f "$ZSH_BENCHMARK_FILE" ]] && echo "date,command,real,user,sys,total" >"$ZSH_BENCHMARK_FILE"
      [[ ! -f "$ZSH_STATS_FILE" ]] && touch "$ZSH_STATS_FILE"
    }

    get_valid_tmp_file() {
      local prefix="zsh_tmp_${RANDOM}"
      local tmp_file="${ZSH_BENCHMARK_DIR}/${prefix}_${1:-file.csv}"
      echo "$tmp_file"
    }

    case $2 in
    --rebuild) # Rebuild the ZSH environment
      zimfw clean-compiled && zimfw clean-dumpfile
      ;;
    --benchmark) # Benchmark ZSH startup time
      ensure_tmp_dir_and_files
      case "$3" in
      # Run the zsh benchmark measure using hyperfine
      measure)
        local times=${#--times:-10}
        local shell_args=(-i -c)
        [[ "$*" =~ '--login' ]] && shell_args+=(-l)
        [[ "$*" =~ '--norc' || "$*" =~ '--no-rc' || "$*" =~ '--no-rcs' || "$*" =~ '--norcs' ]] && shell_args+=(--no-rcs)
        [[ "$*" =~ '--no-globalrcs' || "$*" =~ '--no-global-rcs' ]] && shell_args+=(--no-global-rcs)
        local current_date="$(date '+%d_%m_%Y_%H_%M_%S')"
        local tmp_file="$(get_valid_tmp_file "benchmark.csv")"
        local awk_command="
                  NR==2 {printf \"%s,%s,%0.6f,%0.6f,%0.6f,%0.6f,%0.6f,%0.6f,%0.6f\\n\",
                    date, \$1, \$2, \$3, \$4, \$5, \$6, \$7, \$8
                  }"

        hyperfine --warmup 10 --runs 100 "z_prof=3 $SHELL" "${shell_args[@]}" exit --export-csv >(awk -F',' -v date="$current_date" "$awk_command" >"$tmp_file")

        (
          head -n 1 "$ZSH_BENCHMARK_FILE"
          cat "$tmp_file"
          tail -n +2 "$ZSH_BENCHMARK_FILE"
        ) >"${ZSH_BENCHMARK_FILE}.new"
        mv "${ZSH_BENCHMARK_FILE}.new" "$ZSH_BENCHMARK_FILE"
        rm "$tmp_file"

        if [[ ! "$*" =~ '--no-stdout' ]]; then
          dots zsh --benchmark --log
          return
        fi
        ;;
      store) # Store the zsh benchmark results into ~/.config/zsh/tmp/benchmarks.csv
        dots zsh --benchmark measure --no-login --no-stdout && dots zsh --benchmark measure --login --no-stdout
        ;;
      logs) # Print the zsh benchmark logs
        gum table --separator=',' --border='rounded' --print --file "$ZSH_BENCHMARK_FILE"
        ;;
      *)
        dots zsh --benchmark "$(gum filter --limit=1 'logs' 'measure' 'store')"
        ;;
      esac
      ;;
    # Recompile ZSH completions
    --recompile)
      zimfw clean-compiled && zimfw compile
      ;;
    # Rebuild ZSH
    --rebuild)
      zimfw clean && zimfw reinstall && zimfw compile && zimfw info
      ;;
    # Show full path of sourced files
    --trace|--sourcetrace)
      zsh --sourcetrace
      ;;
    # Profilling ZSH
    --prof)
      # https://medium.com/tarkalabs/optimize-zsh-fce424fcfd5
      # https://blog.jonlu.ca/posts/speeding-up-zsh
      # https://joshghent.com/zsh-speed
      case $3 in
      # run zsh 10x and exit (INTERNAL USE)
      uptime)
        local times=${#--times:-10}
        local shell_args=(-i -c)
        [[ "$*" =~ '--login' ]] && shell_args+=(-l)
        [[ "$*" =~ '--norc' || "$*" =~ '--no-rc' || "$*" =~ '--no-rcs' || "$*" =~ '--norcs' ]] && shell_args+=(--no-rcs)
        [[ "$*" =~ '--no-globalrcs' || "$*" =~ '--no-global-rcs' ]] && shell_args+=(--no-global-rcs)
        for _ in $(seq 1 "$times"); do time z_prof=3 $SHELL "${shell_args[@]}" exit 2>&1; done
        ;;
      # run zsh 10x and exit (INTERNAL USE)
      once)
        echo -e "$(dots zsh --prof uptime "${@:4}" 2>&1 >/dev/null)"
        ;;
      # run zsh 10x and exit (INTERNAL USE)
      measure)
        dots zsh --prof once "${@:4}" | sed -E 's/(user|system|cpu| total)//g; s/^[ ]*//' | sed -E 's/[ ]+/\t/g'
        ;;
      # run zsh 10x, exit and calculate the average for USER, SYSTEM, CPU and TOTAL (INTERNAL USE)
      average)
        dots zsh --prof measure |
          awk 'function format(value) { if (value >= 1) return sprintf("%.2fs ", value); else return sprintf("%.fms", (value*1000)); }
                      { user+=substr($1, 1, length($1)-1); sys+=substr($2, 1, length($2)-1); cpu+=substr($3, 1, length($3)-1); total+=$4; } END { print format(user/NR)" "format(sys/NR)" "sprintf("%.0f", cpu/NR)"% "format(total/NR) }'
        ;;
      # Prints the ZSH stats separated by USER, SYSTEM, CPU and TOTAL
      stats)
        puts "| 0.05  |  0.05  |  95 % | 0.099 | *" --green && dots zsh --prof measure "${@:4}" | gum table --separator=$'\t' -p -c USER,SYSTEM,CPU,TOTAL
        ;;
      # Prints the average of the ZSH stats
      avg)
        dots zsh --prof average | gum table --separator=' ' -p -c USER,SYSTEM,CPU,TOTAL
        ;;
      # Store the ZSH stats into ~/.config/zsh/tmp/prof.csv
      store)
        echo "$(date '+%d/%m/%Y %H:%M:%S'),dots zsh --prof average --no-globalrc --login,$(dots zsh --prof average --no-globalrc --login | sed 's/ /,/g')" >>"$ZSH_PROF_FILE" &&
          echo "$(date '+%d/%m/%Y %H:%M:%S1'),dots zsh --prof average --no-globalrc,$(dots zsh --prof average --no-globalrc | sed 's/ /,/g')" >>"$ZSH_PROF_FILE"
        ;;
      # List all the ZSH prof logs from ~/.config/zsh/tmp/prof.csv
      logs)
        gum table --separator=',' --border='rounded' --print --file "$ZSH_PROF_FILE"
        ;;
      # Execute the ZSH zprof command
      exec)
        z_prof=1 "$SHELL" -ilc exit
        ;;
      # Trace the ZSH Startup. Print commands and their arguments as they are executed. The output is preceded by the value of $PS4, formatted
      trace)
        case $2 in
        # Trace the ZSH Startup. Print commands and their arguments as they are executed once. The output is preceded by the value of $PS4, formatted
        --once) echo -e "$(z_prof=1 z_trace=1 dots trace 2>&1 >/dev/null)" ;;
        *) z_prof=1 z_trace=1 "$SHELL" -ilc exit ;;
        esac
        ;;
      *)
        dots zsh --prof "$(gum filter --limit=1 'logs' 'stats' 'exec' 'store' 'avg' 'trace')"
        ;;
      esac
      ;;

    esac
    ;;
  *)
    dots "$(gum filter --limit=1 'path' 'fpath' 'cdpath' 'env' 'zsh' 'palette' 'xdg')"
    ;;
  esac
}

dots "${@}"

