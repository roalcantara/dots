#!/usr/bin/env zsh
# shellcheck shell=bash disable=SC2154,SC1073,SC1058,SC1072,SC1009,SC1036,SC2155,SC2034,SC2120,SC2296,SC2179,SC2066,SC2015,SC1008,SC2296,SC1087

# Handle both Bash and Zsh compatibility
if [[ -n "${BASH_VERSION:-}" ]]; then
  # Bash-specific settings
  set -euo pipefail
  shopt -s nullglob
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  # Zsh-specific settings
  setopt NULL_GLOB
  setopt PIPE_FAIL
fi

  # Helper functions
  _zsys_usage() {
    cat << 'EOF'
Usage: zsys [OPTIONS] [COMMANDS]

OPTIONS:
  -h, --help              Show this help message

COMMANDS:
  path <subcommand>       Path manipulation
    list                  List all paths
    remove <path>         Remove path from PATH
    append <path>         Append path to PATH
    prepend <path>        Prepend path to PATH
    clean                 Remove non-existing paths

  cmd <subcommand>        Command utilities
    exists <command>      Check if command exists
    path <command>        Get command path

  file <subcommand>       File utilities
    source <file>         Source a file
    mtime <file>          Get file modification time

EXAMPLES:
  zsys path clean
  zsys cmd exists git
  zsys file source ~/.zshrc
EOF
  }

  _zsys_path_command() {
    local subcmd="$1"
    local target="$2"

    case "$subcmd" in
      list)
        print -l "${(@)path}"
        ;;
      remove)
        [[ -z "$target" ]] && { echo "Error: path remove requires a path argument" >&2; return 1; }
        path=("${(@)path:#$target}")
        echo "✓ Removed $target from PATH"
        ;;
      append)
        [[ -z "$target" ]] && { echo "Error: path append requires a path argument" >&2; return 1; }
        [[ -d "$target" ]] && {
          path+="$target"
          echo "✓ Appended $target to PATH"
        } || {
          echo "Error: directory '$target' does not exist" >&2
          return 1
        }
        ;;
      prepend)
        [[ -z "$target" ]] && { echo "Error: path prepend requires a path argument" >&2; return 1; }
        [[ -d "$target" ]] && {
          path=("$target" "${(@)path:#$target}")
          echo "✓ Prepended $target to PATH"
        } || {
          echo "Error: directory '$target' does not exist" >&2
          return 1
        }
        ;;
      clean)
        local clean_path=()
        local removed_count=0
        for dir in "${(@)path}"; do
          if [[ -d "$dir" ]]; then
            clean_path+="$dir"
          else
            ((removed_count++))
          fi
        done
        path=("${(@)clean_path}")
        echo "✓ Cleaned PATH (removed $removed_count non-existing directories)"
        ;;
      *)
        echo "Error: unknown path command '$subcmd'" >&2
        echo "Available: list, remove, append, prepend, clean" >&2
        return 1
        ;;
    esac
  }

  _zsys_cmd_command() {
    local subcmd="$1"
    local command_name="$2"

    case "$subcmd" in
      exists)
        [[ -z "$command_name" ]] && { echo "Error: cmd exists requires a command name" >&2; return 1; }
        (( ${+commands[$command_name]} ))
        ;;
      path)
        [[ -z "$command_name" ]] && { echo "Error: cmd path requires a command name" >&2; return 1; }
        if (( ${+commands[$command_name]} )); then
          echo "${commands[$command_name]}"
        else
          echo "Command '$command_name' not found" >&2
          return 1
        fi
        ;;
      *)
        echo "Error: unknown cmd command '$subcmd'" >&2
        echo "Available: exists, path" >&2
        return 1
        ;;
    esac
  }

  _zsys_file_command() {
    local subcmd="$1"
    local file_path="$2"

    case "$subcmd" in
      source)
        [[ -z "$file_path" ]] && { echo "Error: file source requires a file path" >&2; return 1; }
        [[ -f "$file_path" ]] && {
          source "$file_path"
          echo "✓ Sourced $file_path"
        } || {
          echo "Error: file '$file_path' not found" >&2
          return 1
        }
        ;;
      mtime)
        [[ -z "$file_path" ]] && { echo "Error: file mtime requires a file path" >&2; return 1; }
        if [[ -f "$file_path" ]]; then
          case "$(uname)" in
            Darwin) stat -f "%m" "$file_path" ;;
            Linux)  stat -c "%Y" "$file_path" ;;
          esac
        else
          echo "Error: file '$file_path' not found" >&2
          return 1
        fi
        ;;
      *)
        echo "Error: unknown file command '$subcmd'" >&2
        echo "Available: source, mtime" >&2
        return 1
        ;;
    esac
  }

# Process remaining commands
case "$1" in
  path)
    _zsys_path_command "${@:2}"
    ;;
  cmd)
    _zsys_cmd_command "${@:2}"
    ;;
  file)
    _zsys_file_command "${@:2}"
    ;;
  *)
    echo "Error: unknown command '$1'" >&2
    _zsys_usage
    return 1
    ;;
esac
