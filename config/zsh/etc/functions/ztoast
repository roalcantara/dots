##? Display a ztoast message
##?
##? Usage:
##?      ztoast [options]
##?
##? Arguments:
##?     message               The message to display.
##?     duration              The duration of the toast in seconds.
##?     type                  The type of toast to display.
##?
##? Examples:
##?     ztoast "Hello, world!"
##?     ztoast "Hello, world!" 5
##?     ztoast "Hello, world!" 5 error
##?     ztoast "Hello, world!" 5 success
##?     ztoast "Hello, world!" 5 warning
##?     ztoast "Hello, world!" 5 info
##?     ztoast "Process started" 3 "info"
##?     ztoast "Successfully completed" 5 "success"
##?     ztoast "Something went wrong" 5 "error"
##?     ztoast "Warning: disk space low" 5 "warning"

local __c=(
  success=(bg="\e[42m" fg="\e[37m" icon="✓") # Green
  error=(bg="\e[41m" fg="\e[37m" icon="✗") # Red
  warning=(bg="\e[43m" fg="\e[30m" icon="!") # Yellow
  info=(bg="\e[44m" fg="\e[37m" icon="i") # Blue
)
local __puts() {
  local bg fg icon reset="\e[0m"
  bg="${__c[$type][bg]}"
  fg="${__c[$type][fg]}"
  icon="${__c[$type][icon]}"
  echo -n "${bg}${fg} ${icon} $1 ${reset}\n"
}

# Advanced toast with colors and icons
ztoast() {
  # Use zparseopts to extract flags and arguments
  # -D: remove parsed flags from $@
  # -F: fail if an invalid option is found
  # -E: stop at first non-option
  # -A: store results in associative array
  # Boolean flags (no colon)
  # Options requiring values (with colon)
  local -A ztoast_opts
  zparseopts -D -F -E -A ztoast_opts -duration: -type:

  local message="$1"
  local duration="${ztoast_opts[-duration]:-${2:-3}}"
  local type="${ztoast_opts[-type]:-${3:-info}}"

  # Save cursor position
  tput sc

  # Move to top-right corner and print message
  tput cup 0 $(($(tput cols) - ${#message} - 6))
  __puts "$message"

  # Restore cursor position
  tput rc

  # Remove toast after duration
  (
    sleep $duration
    tput sc
    tput cup 0 $(($(tput cols) - ${#message} - 6))
    printf ' %.0s' $(seq 1 $((${#message} + 6)))
    tput rc
  ) &! # Run in background
}

ztoast "${@}"

