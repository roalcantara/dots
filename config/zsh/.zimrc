#!/usr/bin/env zsh

# ZIM | The Zsh configuration framework with blazing speed and modular extensions (https://zimfw.sh)
# https://zimfw.sh/docs/commands/#zmodule
# zimfw clean && zimfw install -v
# zimfw clean && zimfw update -v
# zimfw clean && zimfw install -v && zimfw update -v
# zimfw list -v

# SETTINGS | https://zimfw.sh/docs/settings
zstyle ':zim:zmodule' use 'degit'              # Use degit to clone modules - better when git history is not needed, quick module installation is priority, disk space is limited
zstyle ':zim:completion' dumpfile "$zdumpfile" # Enables and configures smart and extensive tab completion.
zstyle ':completion::complete:*' cache-path $HOME/.cache/zsh/zcompcache

# FOUNDATION MODULES | https://zimfw.sh/docs/modules
zmodule environment # Sets sane Zsh built-in environment options. (https://github.com/zimfw/environment)
zmodule input       # Applies correct bindkeys for input events. (https://github.com/zimfw/input)
zmodule run-help    # Figures out where to get the best help, and gets it. Type ESC-H to execute run-help for the current command. (https://github.com/zimfw/run-help)

# TOOL INTEGRATION | https://zimfw.sh/docs/modules
zmodule joke/zim-mise --if-command mise                                                       # Sets up mise Zsh shell integration (https://github.com/joke/zim-mise) - Load early to ensure mise paths are prepended
zmodule fzf --if-command fzf                                                                  # Fuzzy finder (https://github.com/zimfw/fzf)
zmodule kiesman99/zim-zoxide --if-command zoxide                                              # Zoxide is a smarter cd command
zmodule joke/zim-starship --if-command starship --if '[[ $TERM_PROGRAM != "WarpTerminal" ]]'  # The minimal, blazing-fast, and infinitely customizable prompt for any shell (https://starship.rs) - Skip in Warp

# COMPLETION | https://zimfw.sh/docs/install/#create-~%2F.zimrc
# Completions should be configured before compinit, as stated in the zsh-completions manual installation guide.
zmodule zchee/zsh-completions --fpath src/zsh --fpath src/macOS --fpath src/go
zmodule $HOME/.config/zsh/opt --fpath completions
zmodule $HOME/.config/zsh/etc --fpath functions
# Skip completion module if compinit was already initialized (e.g., by Flox)
if ! (( ${+functions[_main_complete]} )); then
  zmodule completion
fi
# Ensure that any other plugins that use compdef are loaded after zmodule completion.
zmodule $HOME/.config/zsh/etc --autoload "$(/bin/ls $HOME/.config/zsh/etc/functions | tr '\n' ' ')"
zmodule g-plane/pnpm-shell-completion --if-command pnpm --on-pull './zplug.zsh'
zmodule MenkeTechnologies/zsh-cargo-completion --if-command cargo
zmodule lukechilds/zsh-better-npm-completion --if-command npm
zmodule chrisands/zsh-yarn-completions --if-command yarn
zmodule Aloxaf/fzf-tab --source fzf-tab.zsh --if-command fzf                                      # MUST be sourced after compinit but before other plugins

zmodule zdharma-continuum/fast-syntax-highlighting --if '[[ $TERM_PROGRAM != "WarpTerminal" ]]'   # MUST be sourced after completion. Skip in Warp Terminal as it has native syntax highlighting
zmodule zsh-users/zsh-history-substring-search --if '[[ $TERM_PROGRAM != "WarpTerminal" ]]'       # MUST be sourced after syntax-highlighting. Skip in Warp Terminal as it has enhanced history search
zmodule zsh-users/zsh-autosuggestions --if '[[ $TERM_PROGRAM != "WarpTerminal" ]]'                # MUST be sourced after syntax-highlighting. Skip in Warp Terminal as it has AI-powered suggestions

# ZSH PLUGIN LOADING
for custom_plugin in aliases keybindings plugins; do
  zmodule $HOME/.config/zsh/opt"/$custom_plugin"
done
