_gitx() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in gitx." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_gitx.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name gitx
bin gitx
version "0.1.0"
about "Git workflow dispatcher and interactive fzf rebase helper"
example "gitx cnb feature/foo"
example "gitx branches"
example "gitx head-branch"
example "gitx clear-merged"
cmd cnb help="Smart create branch with commit picker" {
    arg "[branch]" help="Branch name" required=#false
}
cmd nb help="Create branch from updated origin/main" {
    arg "[branch]" help="Branch name" required=#false
}
cmd branches help="List local branch names"
cmd clear-merged help="Delete merged branches"
cmd clear-gone help="Delete branches whose remote tracking is gone"
cmd remote-branches help="List remote branch names" {
    arg "[remote]" help="Remote name" required=#false default=origin
}
cmd rebase-from help="Interactive rebase from parent of commit" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd edit help="Rebase edit commit" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd drop help="Rebase drop commit" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd reword help="Rebase reword commit" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd fix-root help="Fixup and autosquash root commit"
cmd fix help="Fixup and autosquash commit" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd fixup help="Create fixup commit only" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd squash help="Create squash commit" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd fix-all help="Stage all and fix" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd squash-all help="Stage all and squash" {
    arg "[commit]" help="Target commit" required=#false default=HEAD
}
cmd root-commit help="Print root commit hash"
cmd uu help="Pull rebase origin main"
cmd uup help="Pull rebase upstream main"
cmd p help="Push verbose origin current branch"
cmd pf help="Push --force-with-lease"
cmd pa help="Push --all"
cmd pt help="Push --tags"
cmd pc help="Push --set-upstream"
cmd pp help="Pull then push current branch"
cmd lol help="Fzf commit log viewer"
cmd fzl help="Fzf commit hash picker"
cmd fzlog help="Alias for lol"
cmd fzdiff help="Fzf diff viewer"
cmd fza help="Fzf picker: tab-toggle unstaged/untracked files to git add (keys shown in header)"
cmd fzu help="Fzf git restore"
cmd fzus help="Fzf git restore --staged"
cmd fzc help="Fzf branch checkout"
cmd fzb help="Fzf branch deletion/management"
cmd fzr help="Fzf rebase-from"
cmd fzf help="Fzf fix"
cmd fzw help="Fzf reword"
cmd fze help="Fzf edit"
cmd fzd help="Fzf drop"
cmd fzhs help="Fzf reset --soft"
cmd fzhh help="Fzf reset --hard"
cmd fzunstage help="Fzf rm --cached"
cmd grep-commit help="Extract commit hash from stdin"
cmd tail help="Extract last word"
cmd grep-branch help="Extract branch name"
cmd head-branch help="Print current branch"
cmd strip help="Strip status prefix"
cmd preview help="Preview status line"
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line usage_err=
  while IFS= read -r line; do
    if [[ "$line" == $'\x1f'* ]]; then
      usage_err="${line#?}"
      continue
    fi
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(
    { _usage_err="$(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}" 2>&1 >&3 3>&-)"; } 3>&1
    (( $? )) || _usage_err=
    for _usage_l in "${(@f)_usage_err}"; do
      [[ "$_usage_l" == \[[A-Z]*\]* ]] && continue
      _usage_l="${_usage_l#"${_usage_l%%[![:space:]]*}"}"
      _usage_l="${_usage_l#Error:}"
      _usage_l="${_usage_l#"${_usage_l%%[![:space:]]*}"}"
      _usage_l="${_usage_l#× }"
      [[ -z "$_usage_l" || ( "$_usage_l" == *::* && "$_usage_l" != *' '* ) ]] && continue
      print -r -- $'\x1f'"$_usage_l"
      break
    done
  )
  [[ -n "$usage_err" ]] && _message -r "usage: ${usage_err//\%/%%}"
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_gitx" ]; then
    _gitx "$@"
else
    compdef _gitx gitx
