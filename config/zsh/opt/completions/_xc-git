local curcontext="$curcontext"

_xc_git() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in xc-git." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_xc_git.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name xc-git
bin xc-git
version "0.1.0"
about "Git helpers (branch preview, fixup suggest, log fzf)"
cmd branch-preview help="fzf branch preview (gum + delta)" {
    arg <branch> help="Local branch name to preview"
    example "xc-git branch-preview main"
}
cmd fixup-suggest help="Safe fixup target or new commit" {
    flag "-b --base" help="Upstream integrated branch (default: origin/main)" default="origin/main" {
        arg <ref>
    }
    flag "-n --top" help="Show at most N ranked commits (default: 10)" default="10" {
        arg <count>
    }
    flag "-q --best" help="Print only the top commit short hash (for scripts)"
    flag --dry-run help="Do not run git commit when no fixup target exists"
    arg "[paths]…" help="Paths to inspect for commit history" required=#false var=#true
    example "xc-git fixup-suggest --dry-run config/bin/README.md"
}
cmd log-fzf help="Interactive git log (fzf + gitx)" {
    arg "[action]" help="Optional gitx action: rebase-from, fix, reword, edit, drop, reset-soft, reset-hard" required=#false
    example "xc-git log-fzf fix"
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line usage_err=
  while IFS= read -r line; do
    if [[ "$line" == $'\x1f'* ]]; then
      usage_err="${line#?}"
      continue
    fi
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(
    { _usage_err="$(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}" 2>&1 >&3 3>&-)"; } 3>&1
    (( $? )) || _usage_err=
    for _usage_l in "${(@f)_usage_err}"; do
      [[ "$_usage_l" == \[[A-Z]*\]* ]] && continue
      _usage_l="${_usage_l#"${_usage_l%%[![:space:]]*}"}"
      _usage_l="${_usage_l#Error:}"
      _usage_l="${_usage_l#"${_usage_l%%[![:space:]]*}"}"
      _usage_l="${_usage_l#× }"
      [[ -z "$_usage_l" || ( "$_usage_l" == *::* && "$_usage_l" != *' '* ) ]] && continue
      print -r -- $'\x1f'"$_usage_l"
      break
    done
  )
  [[ -n "$usage_err" ]] && _message -r "usage: ${usage_err//\%/%%}"
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_xc_git" ]; then
    _xc_git "$@"
else
    compdef _xc_git xc-git
fi

