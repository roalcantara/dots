# SOPS encrypt on commit; diff.sops decrypts for git diff/log (see mise.toml sops:setup).
# Do not add config/.env -diff here: diff.sops decrypts it for git diff/log.
*.env filter=sops diff=sops
config/ssh/keys/*.key filter=sops diff=sops
config/ssh/keys/*.pem filter=sops diff=sops
config/ssh/keys/config filter=sops diff=sops
config/gopass/age/** filter=sops diff=sops
config/gh/hosts.yml filter=sops diff=sops
config/wakatime/.wakatime.cfg filter=sops diff=sops
