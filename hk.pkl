/// https://hk.jdx.dev/configuration.html#hk-pkl
/// Repository linters. The global ~/.config/hk/config.pkl (source: config/hk/config.pkl)
/// only sets hk defaults; it defines no hooks - see config/hk/README.md.
amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

exclude = List("node_modules", ".git")

display_skip_reasons = List()

local stagingLinters = new Mapping<String, Step> {
  // shfmt and shellcheck cannot parse zsh. shfmt panics outright, so *.zsh must
  // never reach it. hk's own Builtins.shfmt glob includes **/*.zsh and so
  // cannot be used here.
  ["shellcheck"] {
    batch = true
    glob  = List("**/*.sh", "**/*.bash")
    check = "shellcheck --rcfile .shellcheckrc {{files}}"
  }
  ["shfmt"] {
    batch = true
    glob  = List("**/*.sh", "**/*.bash", "**/*.bats")
    check = "shfmt -d {{files}}"
    fix   = "shfmt -w {{files}}"
  }
  // zsh -n is the only parser that understands zsh syntax.
  ["zsh-syntax"] {
    glob  = List("**/*.zsh", "config/zsh/.z*", "\(read("env:HOME"))/.config/zsh/.z*")
    check = "zsh -n {{files}}"
  }
  ["markdownlint"] = (Builtins.markdown_lint) {
    // CHANGELOG.md is written by semantic-release (.releaserc.yml) on every release.
    exclude = List("README.md", "config/git/README.md", "CHANGELOG.md")
  }
  ["hadolint"] = (Builtins.hadolint) {
    glob = List("**/Dockerfile", "**/Dockerfile.*")
  }
  ["yamllint"] {
    glob    = List("**/*.yml", "**/*.yaml")
    // Written by the todo CLI (mise-tasks/posts/todo) in its own layout; editing it by hand would fight the tool.
    exclude = List("docs/posts/TODO.yaml")
    check   = "yamllint {{files}}"
  }
  ["taplo"] {
    glob    = List("**/*.toml")
    // config/tombi/config.toml declares toml-version = "v1.1.0" and uses a
    // multi-line inline table, which taplo (TOML 1.0) cannot parse.
    exclude = List("config/tombi/config.toml", "\(read("env:HOME"))/.config/tombi/config.toml")
    check   = "taplo fmt --check {{files}}"
    fix     = "taplo fmt {{files}}"
  }
  // Tombi lints what taplo does not: table order, empty keys and JSON Schemas (from the catalog in
  // config/tombi/config.toml). Warnings fail, so the IDE's Tombi diagnostics never reach a commit.
  ["tombi"] {
    glob    = List("**/*.toml")
    // Manifests that are invalid on purpose, for the backup validation specs.
    exclude = List("test/integration/backup/fixtures/**")
    check   = "tombi lint --error-on-warnings {{files}}"
  }
  // The generated fn layer must match config/karabiner/src/bindings.ts (mise run karabiner:build).
  ["karabiner"] {
    glob  = List("config/karabiner/src/**/*.ts", "config/karabiner/karabiner.json", "config/karabiner/hotkeys.json")
    check = "bun install --frozen-lockfile --cwd config/karabiner >/dev/null && bun config/karabiner/src/build.ts --check"
  }
  ["taplo-schema"] {
    // Validates manifests that declare `#:schema` (taplo fmt does not); scoped so taplo
    // never fetches remote schemas for other TOML files.
    glob  = List("config/restic/backup.toml")
    check = "taplo check {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix   = true
    stash = "git"
    steps = stagingLinters
  }
  ["fix"] {
    fix   = true
    steps = stagingLinters
  }
  ["check"] {
    steps = stagingLinters
  }
}
